@using CoffeeHouse.Models
@model CoffeeHouse.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ";
    ViewData["Home"] = "active";

    // Lấy giỏ hàng từ model mà controller đã load
    var cartItems = Model.CartItems ?? new List<TbGioHang>();
    var cartCount = cartItems.Sum(item => item.SoLuong);
}


<!--Categories Section Begin-->
<section class="categories">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-6 p-0">
                <div class="categories__item categories__large__item set-bg"
                     data-setbg="@Url.Content("~/img/categories/anh-1.jpg")">
                    <div class="categories__text">
                        <h1>Thưởng thức cà phê</h1>
                        <p class="text-black">Khơi nguồn cảm hứng trong từng tách cà phê và khoảnh khắc bên nhau.</p>
                        <a asp-controller="products" asp-action="index">Xem ngay</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 p-0">
                        <div class="categories__item set-bg" data-setbg="@Url.Content("~/img/categories/anh-2.jpg")">
                            <div class="categories__text">
                                <h4>Trà</h4>
                                <p class="text-black">Khi bạn cần một điều gì đó nhẹ nhàng hơn cà phê.</p>
                                <a asp-controller="products"
                                   asp-action="type"
                                   asp-route-target="5"
                                   asp-route-targetname="Trà">
                                    Xem ngay
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 p-0">
                        <div class="categories__item set-bg" data-setbg="@Url.Content("~/img/categories/anh-3.jpg")">
                            <div class="categories__text">
                                <h4>Tin tức</h4>
                                <p class="text-black">Những câu chuyện đậm đà như chính ly cà phê.</p>
                                <a asp-controller="news" asp-action="index">Xem ngay</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 p-0">
                        <div class="categories__item set-bg" data-setbg="@Url.Content("~/img/categories/anh-4.jpg")">
                            <div class="categories__text">
                                <h4>Giới thiệu</h4>
                                <p class="text-black">Về chúng tôi – những người tạo nên Coffee House.</p>
                                <a asp-controller="about" asp-action="index">Xem ngay</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 p-0">
                        <div class="categories__item set-bg" data-setbg="@Url.Content("~/img/categories/anh-5.jpg")">
                            <div class="categories__text">
                                <h4>Liên hệ</h4>
                                <p class="text-black">Chúng tôi luôn lắng nghe bạn.</p>
                                <a asp-controller="contact" asp-action="index">Xem ngay</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--Categories Section End-->
<!--Product Section Begin-->
<section class="product spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-4">
                <div class="section-title">
                    <h4>Gợi ý dành cho bạn hôm nay</h4>
                </div>
            </div>
        </div>
        <div class="row property__gallery">
            @foreach (var item in Model.lstSanPham)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mix women">
                    <div class="product__item">
                        <div class="product__item__pic set-bg" data-setbg="@Url.Content("~/img/products/" + item.HinhAnh)">
                            <ul class="product__hover">
                                <li>
                                    <a href="@Url.Content("~/img/products/" + item.HinhAnh)" class="image-popup">
                                        <span><i class="fas fa-expand-alt"></i></span>
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="cart"
                                       asp-action="add"
                                       asp-route-id="@item.MaSanPham"
                                       asp-route-quantity="1">
                                        <span><i class="fas fa-shopping-cart"></i></span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="product__item__text">
                            <h6>
                                <a asp-controller="products"
                                   asp-action="details"
                                   asp-route-id="@item.MaSanPham">
                                    @item.TenSanPham
                                </a>
                            </h6>
                            <div class="product__price">
                                @item.GiaBan.ToString("n0") &#8363;
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!--Product Section End-->
<!--News Section Begin-->
<section class="product spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-4">
                <div class="section-title">
                    <h4>Tạp chí mini dành riêng cho tín đồ cà phê</h4>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var item in Model.lstTinTuc)
            {
                <div class="col-lg-4">
                    <div class="blog__item">
                        <div class="blog__item__pic set-bg" data-setbg="@Url.Content("~/img/news/" + item.HinhAnh)"></div>
                        <div class="blog__item__text">
                            <ul>
                                <li>@item.NgayDang.ToString("dd/MM/yyyy")</li>
                            </ul>
                            <h6>
                                <a asp-controller="news"
                                   asp-action="details"
                                   asp-route-maTinTuc="@item.MaTinTuc">
                                    @item.TieuDe
                                </a>
                            </h6>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!--News Section End-->
<!--Banner Section Begin-->
<section class="banner set-bg" data-setbg="@Url.Content("~/img/banner/banner-1.jpg")">
    <div class="container">
        <div class="row">
            <div class="col-xl-7 col-lg-8 m-auto">
                <div class="banner__slider owl-carousel">
                    <div class="banner__item">
                        <div class="banner__text">
                            <span>Ưu đãi lớn</span>
                            <h1>Trải nghiệm đầu tiên – ưu đãi chỉ dành cho bạn</h1>
                            <a href="#">Mua ngay</a>
                        </div>
                    </div>
                    <div class="banner__item">
                        <div class="banner__text">
                            <span>Ưu đãi lớn</span>
                            <h1>Giao hàng tận tay – miễn phí trong khu vực Hà Nội</h1>
                            <a href="#">Mua ngay</a>
                        </div>
                    </div>
                    <div class="banner__item">
                        <div class="banner__text">
                            <span>Mùa hè đã đến</span>
                            <h1>Sảng khoái mỗi ngày với thức uống mát lạnh mùa hè</h1>
                            <a href="#">Mua ngay</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--Banner Section End-->
