@{
    ViewData["Title"] = "Về chúng tôi";
    ViewData["About"] = "active";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--Breadcrumb Begin-->
<div class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__links">
                    <a asp-controller="home" asp-action="index">
                        <i class="fa-solid fa-house"></i>
                        Trang chủ
                    </a>
                    <span>Về chúng tôi</span>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Breadcrumb End-->
<!--About Section Begin-->
<section class="blog-details spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 col-md-8">
                <div class="blog__details__content">
                    <div class="blog__details__item">
                        <img src="../img/blog/details/blog-details.jpg" alt="Về chúng tôi - COFFEE HOUSE">
                        <div class="blog__details__item__title">
                            <span class="tip"></span>
                            <h4>Về chúng tôi</h4>
                        </div>
                    </div>
                    <div class="blog__details__desc">
                        <p>
                            Bạn có phải là người yêu thích cà phê và luôn tò mò về những bí ẩn của vũ trụ? Hãy đến với <strong>COFFEE HOUSE</strong> – quán cà phê đầu tiên tại Hà Nội mang đậm phong cách không gian vũ trụ, nơi hiện thực giao thoa với những giấc mơ xa xăm giữa các vì sao.
                        </p>
                        <p>
                            Thành lập vào năm 2023, <strong>COFFEE HOUSE</strong> không chỉ là một địa điểm thưởng thức cà phê thông thường, mà là nơi mang đến cho bạn một hành trình trải nghiệm đầy màu sắc và độc đáo. Tọa lạc tại số 3 phố Cầu Giấy, quận Đống Đa, quán sở hữu không gian rộng rãi, hiện đại và tràn ngập cảm hứng từ thiên hà xa xôi. Mỗi chi tiết trong thiết kế – từ bức tường, trần nhà đến ánh sáng – đều được chăm chút để mô phỏng thế giới vũ trụ kỳ ảo.
                        </p>
                        <p>
                            Điểm nhấn đặc biệt của quán chính là <strong>menu cà phê độc quyền</strong>, được chế biến từ những hạt cà phê tuyển chọn, hòa quyện cùng sự sáng tạo không giới hạn. Bạn có thể khám phá những món uống với tên gọi hấp dẫn như <em>Milky Way Latte</em>, <em>Galaxy Frappe</em>, hay <em>Starry Night Mocha</em> – mỗi ly cà phê là một tác phẩm nghệ thuật, mang đến hương vị đậm đà và cảm giác mới mẻ.
                        </p>
                        <p>
                            Không chỉ có đồ uống, <strong>COFFEE HOUSE</strong> còn phục vụ đa dạng các loại bánh ngọt, đồ ăn nhẹ cùng các loại thức uống khác như trà sữa, sinh tố và nước ép, đáp ứng mọi nhu cầu của khách hàng.
                        </p>
                        <p>
                            Ngoài ra, không gian tại quán được thiết kế lý tưởng để học tập, làm việc hoặc gặp gỡ bạn bè. Với <strong>wifi tốc độ cao</strong>, <strong>ổ cắm điện tiện lợi</strong>, <strong>máy in hỗ trợ</strong>, và cả những hoạt động giải trí như <em>xem phim khoa học</em>, <em>workshop chủ đề không gian</em>, hay <em>trò chơi trí tuệ</em>, bạn sẽ luôn tìm thấy điều thú vị khi đến đây.
                        </p>
                        <p>
                            <strong>COFFEE HOUSE</strong> không chỉ là nơi thưởng thức cà phê, mà là một trải nghiệm vượt ngoài mong đợi – nơi bạn được kết nối với vũ trụ theo cách riêng của mình.
                        </p>
                        <p>
                            <strong>COFFEE HOUSE – Cà phê không giới hạn.</strong>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--About Section End-->
