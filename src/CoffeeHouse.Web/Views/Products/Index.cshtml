@{
    ViewData["Title"] = "Sản phẩm";
    ViewData["Products"] = "active";
}

@using X.PagedList
@using X.PagedList.Mvc.Core
@using CoffeeHouse.ViewModels
@model IPagedList<ProductViewModel>

<!-- Breadcrumb -->
<div class="bg-surface-dark/30 py-6 border-b border-border/50">
    <div class="container-custom">
        <nav class="flex items-center gap-3 text-xs font-bold uppercase tracking-widest">
            <a asp-controller="home" asp-action="index" class="text-text-muted hover:text-primary transition-colors flex items-center gap-2">
                <i class="fas fa-home"></i>
                Trang chủ
            </a>
            <i class="fas fa-chevron-right text-[8px] text-text-muted"></i>
            <span class="text-secondary underline decoration-primary decoration-2 underline-offset-4">Sản phẩm</span>
        </nav>
    </div>
</div>

<!-- Shop Section -->
<section class="py-20 bg-white min-h-screen">
    <div class="container-custom">
        <div class="flex flex-col lg:flex-row gap-12">
            <!-- Sidebar -->
            <aside class="w-full lg:w-72 flex-shrink-0 space-y-12">
                <div class="sticky top-28 space-y-8">
                    <div>
                        <h4 class="text-xl font-bold text-secondary mb-8 pb-4 border-b-2 border-primary/20 relative">
                            Loại sản phẩm
                            <span class="absolute bottom-[-2px] left-0 w-12 h-[2px] bg-primary"></span>
                        </h4>
                        <div class="bg-surface-soft rounded-3xl p-2">
                            @await Component.InvokeAsync("NhomSpMenu")
                        </div>
                    </div>
                    
                    <!-- Promo Card in Sidebar -->
                    <div class="bg-secondary rounded-3xl p-8 text-white relative overflow-hidden group">
                        <div class="absolute inset-0 bg-primary/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <h5 class="text-lg font-bold mb-4 relative z-10">Cà phê mới về!</h5>
                        <p class="text-white/60 text-xs mb-6 relative z-10">Khám phá hương vị Arabica vùng cao mới nhất của chúng tôi.</p>
                        <a href="#" class="text-[10px] font-bold uppercase tracking-widest text-primary hover:text-white transition-colors flex items-center gap-2 relative z-10">
                            Tìm hiểu ngay <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </aside>

            <!-- Main Content -->
            <main class="flex-1">
                <div class="flex items-center justify-between mb-12">
                    <h2 class="text-3xl font-bold text-secondary tracking-tight">Danh sách sản phẩm</h2>
                    <p class="text-sm text-text-muted">Hiển thị <span class="font-bold text-secondary">@Model.Count</span> sản phẩm</p>
                </div>

                <div id="displayProducts" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
                    @foreach (var item in Model)
                    {
                        <div class="group">
                            <div class="relative aspect-[3/4] overflow-hidden rounded-3xl bg-surface-dark shadow-sm group-hover:shadow-xl transition-all duration-500 border border-border/50">
                                <img src="@Url.Content("../img/products/" + item.ImageUrl)" alt="@item.ProductName"
                                     class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                                
                                <!-- Actions Overlay -->
                                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                                <div class="absolute bottom-6 left-6 right-6 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                                    <div class="flex gap-2">
                                        <a asp-controller="cart" asp-action="add" asp-route-id="@item.ProductId" asp-route-quantity="1"
                                           class="flex-1 btn-primary py-3 px-0 text-[10px]">
                                            <i class="fas fa-shopping-cart mr-2"></i> Thêm vào giỏ
                                        </a>
                                        <a href="@Url.Content("../img/products/" + item.ImageUrl)" class="image-popup w-12 h-12 glass rounded-full flex-center text-secondary hover:bg-primary hover:text-white transition-all">
                                            <i class="fas fa-expand-alt"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-6 text-center">
                                <h3 class="text-base font-bold text-secondary mb-2 hover:text-primary transition-colors">
                                    <a asp-controller="products" asp-action="details" asp-route-id="@item.ProductId">@item.ProductName</a>
                                </h3>
                                <p class="text-lg font-bold text-primary">@(item.Price?.ToString("n0") ?? "0") <span class="text-xs ml-0.5">đ</span></p>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                <div class="mt-20 flex justify-center">
                    @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }), 
                    new PagedListRenderOptions()
                    {
                        MaximumPageNumbersToDisplay = 5,
                        ContainerDivClasses = new[] { "flex items-center gap-2" },
                        UlElementClasses = new[] { "flex items-center gap-2" },
                        LiElementClasses = new[] { "w-10 h-10 rounded-xl border border-border flex-center group transition-all hover:border-primary hover:bg-primary/5" },
                        PageClasses = new[] { "text-sm font-bold text-text-muted group-hover:text-primary transition-all" },
                        ActiveLiElementClass = "bg-primary !border-primary",
                    })
                </div>
            </main>
        </div>
    </div>
</section>

