@model CoffeeHouse.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Breadcrumb -->
<div class="bg-surface-dark/30 py-6 border-b border-border/50">
    <div class="container-custom">
        <nav class="flex items-center gap-3 text-[10px] font-bold uppercase tracking-[0.2em]">
            <a asp-controller="home" asp-action="index" class="text-text-muted hover:text-primary transition-colors flex items-center gap-2">
                <i class="fa-solid fa-house"></i>
                Trang chủ
            </a>
            <i class="fas fa-chevron-right text-[8px] text-text-muted"></i>
            <a asp-controller="cart" asp-action="index" class="text-text-muted hover:text-primary transition-colors">Giỏ hàng</a>
            <i class="fas fa-chevron-right text-[8px] text-text-muted"></i>
            <span class="text-secondary underline decoration-primary decoration-4 underline-offset-[12px]">Xác nhận & Thanh toán</span>
        </nav>
    </div>
</div>

<!-- Checkout Section -->
<section class="py-24 bg-white min-h-screen">
    <div class="container-custom">
        <div class="flex items-end justify-between mb-16">
            <div class="space-y-4">
                <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Secure Checkout</span>
                <h1 class="text-5xl font-black text-secondary tracking-tighter leading-tight">Hoàn tất đơn hàng của bạn</h1>
            </div>
        </div>

        <form asp-controller="cart" asp-action="Confirmation" method="post" class="flex flex-col xl:flex-row gap-16">
            <!-- Billing Details -->
            <div class="flex-1 space-y-12">
                <div class="bg-surface-soft p-12 rounded-[56px] border border-border/50 shadow-inner relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-12 opacity-[0.03] text-9xl font-black pointer-events-none select-none">
                        INFO
                    </div>
                    
                    <div class="relative z-10">
                        <h5 class="text-2xl font-black text-secondary mb-10 pb-6 border-b border-border/50 italic tracking-tight">Thông tin nhận hàng</h5>
                        <div class="space-y-8">
                            <!-- Customer Name -->
                            <div class="space-y-3">
                                <label class="text-[10px] font-black uppercase tracking-widest text-text-light ml-4">Họ và tên khách hàng</label>
                                <input type="text" name="customerName" value="@Model.Customer.CustomerName" 
                                       class="input-modern bg-white !rounded-[24px]" 
                                       readonly required>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                <!-- Phone -->
                                <div class="space-y-3">
                                    <label class="text-[10px] font-black uppercase tracking-widest text-text-light ml-4">Số điện thoại</label>
                                    <input type="tel" pattern="[0-9]{10}" name="phoneNumber" value="@Model.Customer.PhoneNumber" 
                                           class="input-modern bg-white !rounded-[24px]" 
                                           readonly required>
                                </div>
                                <!-- Store Select -->
                                <div class="space-y-3">
                                    <label class="text-[10px] font-black uppercase tracking-widest text-text-light ml-4">Chi nhánh nhận hàng</label>
                                    <div class="relative">
                                        <select name="StoreId" class="input-modern bg-white !rounded-[24px] appearance-none cursor-pointer pr-12" 
                                                asp-items="ViewBag.Quan" required>
                                            <option value="">-- Chọn chi nhánh --</option>
                                        </select>
                                        <div class="absolute right-6 top-1/2 -translate-y-1/2 pointer-events-none text-primary">
                                            <i class="fas fa-chevron-down text-xs"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Address -->
                            <div class="space-y-3">
                                <label class="text-[10px] font-black uppercase tracking-widest text-text-light ml-4">Địa chỉ giao hàng</label>
                                <input type="text" name="address" value="@Model.Customer.Address" 
                                       class="input-modern bg-white !rounded-[24px]" 
                                       readonly required>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Payment Method -->
                <div class="bg-surface-soft p-12 rounded-[56px] border border-border/50 shadow-inner relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-12 opacity-[0.03] text-9xl font-black pointer-events-none select-none">
                        PAY
                    </div>
                    
                    <div class="relative z-10">
                        <h5 class="text-2xl font-black text-secondary mb-10 pb-6 border-b border-border/50 italic tracking-tight">Phương thức thanh toán</h5>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <!-- QR Code -->
                            <label class="relative block cursor-pointer group">
                                <input type="radio" name="checkoutMethod" value="QR" class="peer sr-only" checked>
                                <div class="p-8 bg-white border border-border/50 rounded-[32px] text-center transition-all peer-checked:border-primary peer-checked:border-2 peer-checked:ring-4 peer-checked:ring-primary/10 group-hover:shadow-xl group-hover:-translate-y-1">
                                    <div class="w-16 h-16 bg-surface-dark rounded-2xl flex-center mx-auto mb-6 group-hover:bg-primary/5 transition-colors">
                                        <i class="fas fa-qrcode text-3xl text-text-light group-hover:text-primary transition-colors peer-checked:text-primary"></i>
                                    </div>
                                    <span class="text-[10px] font-black uppercase tracking-widest text-secondary">Mã QR Online</span>
                                </div>
                                <div class="absolute top-6 right-6 text-primary opacity-0 peer-checked:opacity-100 transition-opacity">
                                    <div class="w-6 h-6 rounded-full bg-primary text-white flex-center shadow-lg">
                                        <i class="fas fa-check text-[10px]"></i>
                                    </div>
                                </div>
                            </label>

                            <!-- Bank Transfer -->
                            <label class="relative block cursor-pointer group">
                                <input type="radio" name="checkoutMethod" value="Chuyển khoản" class="peer sr-only">
                                <div class="p-8 bg-white border border-border/50 rounded-[32px] text-center transition-all peer-checked:border-primary peer-checked:border-2 peer-checked:ring-4 peer-checked:ring-primary/10 group-hover:shadow-xl group-hover:-translate-y-1">
                                    <div class="w-16 h-16 bg-surface-dark rounded-2xl flex-center mx-auto mb-6 group-hover:bg-primary/5 transition-colors">
                                        <i class="fas fa-university text-3xl text-text-light group-hover:text-primary transition-colors peer-checked:text-primary"></i>
                                    </div>
                                    <span class="text-[10px] font-black uppercase tracking-widest text-secondary">Chuyển khoản</span>
                                </div>
                                <div class="absolute top-6 right-6 text-primary opacity-0 peer-checked:opacity-100 transition-opacity">
                                    <div class="w-6 h-6 rounded-full bg-primary text-white flex-center shadow-lg">
                                        <i class="fas fa-check text-[10px]"></i>
                                    </div>
                                </div>
                            </label>

                            <!-- Cash -->
                            <label class="relative block cursor-pointer group">
                                <input type="radio" name="checkoutMethod" value="Tiền mặt" class="peer sr-only">
                                <div class="p-8 bg-white border border-border/50 rounded-[32px] text-center transition-all peer-checked:border-primary peer-checked:border-2 peer-checked:ring-4 peer-checked:ring-primary/10 group-hover:shadow-xl group-hover:-translate-y-1">
                                    <div class="w-16 h-16 bg-surface-dark rounded-2xl flex-center mx-auto mb-6 group-hover:bg-primary/5 transition-colors">
                                        <i class="fas fa-money-bill-wave text-3xl text-text-light group-hover:text-primary transition-colors peer-checked:text-primary"></i>
                                    </div>
                                    <span class="text-[10px] font-black uppercase tracking-widest text-secondary">Tiền mặt</span>
                                </div>
                                <div class="absolute top-6 right-6 text-primary opacity-0 peer-checked:opacity-100 transition-opacity">
                                    <div class="w-6 h-6 rounded-full bg-primary text-white flex-center shadow-lg">
                                        <i class="fas fa-check text-[10px]"></i>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary Sidebar -->
            <aside class="w-full xl:w-[450px]">
                <div class="bg-secondary rounded-[56px] p-12 text-white shadow-2xl lg:sticky lg:top-32 overflow-hidden group">
                    <div class="absolute inset-0 bg-primary/5 group-hover:bg-primary/10 transition-colors duration-700"></div>
                    <div class="absolute -top-24 -right-24 w-64 h-64 bg-primary/10 rounded-full blur-3xl group-hover:scale-125 transition-transform duration-1000"></div>
                    
                    <div class="relative z-10 space-y-10">
                        <h5 class="text-3xl font-black italic tracking-tighter">Chi tiết túi hàng</h5>
                        
                        <div class="space-y-6 max-h-[350px] overflow-y-auto pr-4 custom-scrollbar">
                            @foreach (var (item, index) in Model.CartItems.Select((v, i) => (v, i)))
                            {
                                <div class="flex items-start justify-between gap-6 pb-6 border-b border-white/5 last:border-0 last:pb-0 animate-slide-up" style="animation-delay: @(index * 50)ms">
                                    <div class="flex gap-4">
                                        <div class="w-12 h-12 rounded-2xl bg-white/5 flex-center flex-shrink-0 text-primary font-black text-xs">
                                            @(index + 1)
                                        </div>
                                        <div class="space-y-1">
                                            <p class="font-bold leading-tight line-clamp-2">@item.Product.ProductName</p>
                                            <p class="text-[10px] text-white/30 uppercase tracking-[0.2em] font-black">X @item.Quantity</p>
                                        </div>
                                    </div>
                                    <div class="text-right flex-shrink-0">
                                        <span class="font-black text-primary italic">
                                            @((item.Quantity * item.Product.Price).ToString("n0"))
                                            <span class="text-[10px] uppercase ml-1 font-bold">đ</span>
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="space-y-6 pt-10 border-t border-white/10">
                            <div class="flex justify-between items-center text-white/40 text-[10px] font-black uppercase tracking-widest">
                                <span>Tạm tính giá gốc:</span>
                                <span class="text-white text-base font-bold">@Model.Total đ</span>
                            </div>
                            <div class="flex justify-between items-center text-white/40 text-[10px] font-black uppercase tracking-widest">
                                <span>Ưu đãi vận chuyển:</span>
                                <span class="text-accent text-base font-bold">MIỄN PHÍ</span>
                            </div>
                            <div class="pt-6 flex justify-between items-end border-t border-white/5">
                                <div class="space-y-1">
                                    <span class="text-[10px] font-black uppercase tracking-[0.3em] text-primary">Tổng cộng túi</span>
                                    <p class="text-[8px] text-white/20 uppercase tracking-widest font-bold">Bao gồm VAT</p>
                                </div>
                                <div class="text-right">
                                    <span class="text-5xl font-black tracking-tighter italic text-white">@Model.Total</span>
                                    <span class="text-sm font-black text-primary uppercase ml-2">đ</span>
                                </div>
                            </div>
                        </div>

                        <div class="pt-8">
                            <button type="submit" class="w-full btn-primary py-6 text-sm flex items-center justify-center gap-4 group/btn shadow-xl shadow-primary/30">
                                <span>Xác nhận & Đặt hàng</span>
                                <i class="fas fa-check-circle group-hover/btn:scale-110 transition-transform"></i>
                            </button>
                        </div>
                        
                        <div class="flex items-center justify-center gap-4 text-white/20">
                            <i class="fas fa-lock text-[10px]"></i>
                            <p class="text-[9px] font-bold uppercase tracking-[0.1em] text-center max-w-[250px]">
                                Thanh toán được bảo mật bởi hệ thống mã hóa 256-bit chuẩn quốc tế
                            </p>
                        </div>
                    </div>
                </div>
            </aside>
        </form>
    </div>
</section>




