@model CoffeeHouse.ViewModels.AccountInfoViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Breadcrumb -->
<div class="bg-surface-dark/30 py-6 border-b border-border/50">
    <div class="container-custom">
        <nav class="flex items-center gap-3 text-[10px] font-black uppercase tracking-[0.2em]">
            <a asp-controller="home" asp-action="index" class="text-text-muted hover:text-primary transition-colors flex items-center gap-2">
                <i class="fa-solid fa-house"></i>
                Trang chủ
            </a>
            <i class="fas fa-chevron-right text-[8px] text-text-muted"></i>
            <span class="text-secondary underline decoration-primary decoration-4 underline-offset-[12px]">Hồ sơ cá nhân</span>
        </nav>
    </div>
</div>

<section class="py-24 bg-white relative overflow-hidden">
    <!-- Decorative background -->
    <div class="absolute top-0 right-0 p-32 opacity-[0.02] text-[15vw] font-black pointer-events-none select-none italic leading-none">
        PROFILE
    </div>

    <div class="container-custom relative z-10">
        <div class="max-w-5xl mx-auto">
            <div class="flex flex-col lg:flex-row gap-16 items-start">
                <!-- Sidebar Info -->
                <aside class="w-full lg:w-80 shrink-0 space-y-8 animate-slide-up">
                    <div class="bg-secondary p-10 rounded-[48px] text-white relative overflow-hidden group shadow-2xl shadow-secondary/20">
                        <div class="absolute inset-0 bg-primary/10 opacity-0 group-hover:opacity-100 transition-all duration-700"></div>
                        <div class="relative z-10 text-center">
                            <div class="w-24 h-24 bg-primary/20 backdrop-blur-xl rounded-[32px] mx-auto flex-center mb-6 border border-white/10 group-hover:rotate-[15deg] transition-transform duration-500">
                                <i class="fas fa-user-astronaut text-4xl text-primary"></i>
                            </div>
                            <h2 class="text-xl font-black italic tracking-tighter mb-2">@Model.Username</h2>
                            <p class="text-[8px] font-black uppercase tracking-[0.3em] text-primary">Identity Verified</p>
                        </div>
                    </div>

                    <div class="bg-surface-soft p-8 rounded-[40px] border border-border/50 shadow-inner">
                        <div class="space-y-6">
                            <div class="pb-4 border-b border-border/50">
                                <span class="text-[8px] font-black uppercase tracking-widest text-text-light block mb-1">System Role</span>
                                <span class="text-xs font-black text-secondary italic">@(Model.Role == "Admin" ? "Quán trị viên / Nhân sự" : "Thành viên phi hành đoàn")</span>
                            </div>
                            <div>
                                <a asp-controller="Account" asp-action="EditThongTin" class="w-full btn-primary py-4 text-[10px] font-black uppercase tracking-widest flex items-center justify-center gap-3">
                                    <i class="fas fa-edit"></i> Chỉnh sửa hồ sơ
                                </a>
                            </div>
                        </div>
                    </div>
                </aside>

                <!-- Main Dossier -->
                <main class="flex-1 space-y-12 animate-slide-up" style="animation-delay: 100ms">
                    <div class="pb-6 border-b-2 border-secondary/10 flex items-center justify-between">
                        <div>
                            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Personal Dossier</span>
                            <h1 class="text-5xl font-black text-secondary tracking-tighter italic mt-4">Thông tin <span class="text-primary not-italic">Chi tiết</span></h1>
                        </div>
                        <i class="fas fa-fingerprint text-6xl text-secondary/5 rotate-[-15deg]"></i>
                    </div>

                    @if (Model.Role == "Admin")
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                            <div class="space-y-8">
                                <h4 class="text-[10px] font-black uppercase tracking-[0.3em] text-secondary flex items-center gap-3">
                                    <span class="w-6 h-px bg-secondary"></span> Professional Identity
                                </h4>
                                <div class="space-y-6 bg-surface-soft p-10 rounded-[48px] border border-border/50">
                                    <div class="info-block">
                                        <label class="text-[8px] font-black uppercase tracking-widest text-text-light">Mã nhân viên</label>
                                        <p class="text-lg font-black text-secondary italic">#@Model.EmployeeInfo?.EmployeeId</p>
                                    </div>
                                    <div class="info-block">
                                        <label class="text-[8px] font-black uppercase tracking-widest text-text-light">Họ và tên</label>
                                        <p class="text-lg font-black text-secondary italic">@Model.EmployeeInfo?.FullName</p>
                                    </div>
                                    <div class="info-block">
                                        <label class="text-[8px] font-black uppercase tracking-widest text-text-light">Chức vụ tại hệ thống</label>
                                        <span class="inline-block px-4 py-1.5 bg-secondary text-white text-[8px] font-black uppercase tracking-widest rounded-full mt-2">@Model.EmployeeInfo?.Position</span>
                                    </div>
                                    <div class="info-block">
                                        <label class="text-[8px] font-black uppercase tracking-widest text-text-light">Email kết nối</label>
                                        <p class="text-sm font-bold text-secondary">@Model.EmployeeInfo?.Email</p>
                                    </div>
                                </div>
                            </div>

                            <div class="space-y-8">
                                <h4 class="text-[10px] font-black uppercase tracking-[0.3em] text-secondary flex items-center gap-3">
                                    <span class="w-6 h-px bg-secondary"></span> Secondary Intel
                                </h4>
                                <div class="space-y-6 bg-surface-soft p-10 rounded-[48px] border border-border/50">
                                    <div class="grid grid-cols-2 gap-6">
                                        <div class="info-block">
                                            <label class="text-[8px] font-black uppercase tracking-widest text-text-light">Ngày sinh</label>
                                            <p class="text-sm font-bold text-secondary">@Model.EmployeeInfo?.DateOfBirth?.ToString("dd/MM/yyyy")</p>
                                        </div>
                                        <div class="info-block">
                                            <label class="text-[8px] font-black uppercase tracking-widest text-text-light">Giới tính</label>
                                            <p class="text-sm font-bold text-secondary">@Model.EmployeeInfo?.Gender</p>
                                        </div>
                                    </div>
                                    <div class="info-block">
                                        <label class="text-[8px] font-black uppercase tracking-widest text-text-light">Số điện thoại</label>
                                        <p class="text-sm font-bold text-secondary">@Model.EmployeeInfo?.PhoneNumber</p>
                                    </div>
                                    <div class="info-block">
                                        <label class="text-[8px] font-black uppercase tracking-widest text-text-light">Số định danh (CCCD)</label>
                                        <p class="text-sm font-bold text-secondary tracking-widest">@Model.EmployeeInfo?.IdentityCardNumber</p>
                                    </div>
                                    <div class="info-block">
                                        <label class="text-[8px] font-black uppercase tracking-widest text-text-light">Cơ sở trực thuộc</label>
                                        <p class="text-sm font-black text-primary italic">@Model.EmployeeInfo?.Store?.StoreName</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (Model.Role == "User")
                    {
                        <div class="bg-surface-soft p-12 rounded-[56px] border border-border/50 shadow-inner grid grid-cols-1 md:grid-cols-2 gap-12">
                            <div class="space-y-8">
                                <div class="info-block">
                                    <label class="text-[8px] font-black uppercase tracking-widest text-text-light">Mã hành viên</label>
                                    <p class="text-2xl font-black text-secondary italic">#@Model.CustomerInfo?.CustomerId</p>
                                </div>
                                <div class="info-block">
                                    <label class="text-[8px] font-black uppercase tracking-widest text-text-light">Danh tính khách hàng</label>
                                    <p class="text-3xl font-black text-secondary italic leading-tight">@Model.CustomerInfo?.CustomerName</p>
                                </div>
                            </div>
                            <div class="space-y-8">
                                <div class="info-block">
                                    <label class="text-[8px] font-black uppercase tracking-widest text-text-light">Tần số liên lạc (SĐT)</label>
                                    <p class="text-xl font-black text-primary tracking-tighter">@Model.CustomerInfo?.PhoneNumber</p>
                                </div>
                                <div class="info-block">
                                    <label class="text-[8px] font-black uppercase tracking-widest text-text-light">Tọa độ vận chuyển (Địa chỉ)</label>
                                    <p class="text-sm font-bold text-secondary leading-relaxed">@Model.CustomerInfo?.Address</p>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="pt-8 flex items-center justify-between border-t border-border/50">
                        <p class="text-[8px] font-black uppercase tracking-[0.3em] text-text-muted italic select-none">Coffee House Identity System v2.0</p>
                        <a asp-controller="Home" asp-action="Index" class="text-[10px] font-black uppercase tracking-widest text-text-light hover:text-primary transition-all flex items-center gap-3">
                           <i class="fas fa-arrow-left"></i> Quay lại
                        </a>
                    </div>
                </main>
            </div>
        </div>
    </div>
</section>





