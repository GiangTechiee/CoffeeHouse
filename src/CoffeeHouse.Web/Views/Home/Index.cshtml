@model CoffeeHouse.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "The Coffee House - Redesign";
    ViewData["Home"] = "active";
}

<!-- Hero Section -->
<partial name="_HeroSection" model="Model" />

<!-- Category Strip -->
<partial name="_CategoryStrip" />

<!-- Product Suggestions (Now using AJAX) -->
<partial name="_ProductSuggestions" />

<!-- Magazine Section -->
<partial name="_MagazineSection" model="Model.NewsArticles" />

<!-- Promo Strip -->
<partial name="_PromoStrip" />


@section Scripts {
    <style>
        body { font-family: 'Work Sans', sans-serif; }
        .serif-heading { font-family: 'Playfair Display', serif; }
        .product-card:hover .quick-add { opacity: 1; transform: translateY(0); }
        .quick-add { opacity: 0; transform: translateY(10px); transition: all 0.3s ease; }
    </style>
}
