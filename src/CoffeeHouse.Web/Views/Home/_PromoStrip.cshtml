<section class="max-w-[1440px] mx-auto px-10 mb-24">
    <div class="bg-primary/10 dark:bg-primary/5 rounded-2xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-primary/10">
        <div class="space-y-2 text-center md:text-left">
            <h3 class="text-2xl font-bold">Đăng ký thành viên mới</h3>
            <p class="text-warm-gray">Nhận ngay ưu đãi 20% cho đơn hàng đầu tiên và tích điểm đổi quà.</p>
        </div>
        @if (string.IsNullOrEmpty(Context.Session.GetString("Username")))
        {
            <a asp-controller="Auth" asp-action="Login" 
               class="bg-primary hover:bg-[#d47f11] text-white px-8 py-3 rounded-lg font-bold transition-all whitespace-nowrap">
                Nhận ưu đãi ngay
            </a>
        }
        else
        {
            <button class="bg-primary hover:bg-[#d47f11] text-white px-8 py-3 rounded-lg font-bold transition-all whitespace-nowrap">
                Xem ưu đãi thành viên
            </button>
        }
    </div>
</section>
