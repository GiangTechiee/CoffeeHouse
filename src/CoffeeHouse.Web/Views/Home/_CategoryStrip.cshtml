            </a>
            <a asp-controller="About" asp-action="Index" class="flex items-center gap-3 group">
                <span class="material-symbols-outlined text-primary text-2xl group-hover:scale-110 transition-transform">auto_stories</span>
                <span class="font-medium text-sm tracking-wide">Câu Chuyện Cà Phê</span>
            </a>
            <a asp-controller="Contact" asp-action="Index" class="flex items-center gap-3 group">
