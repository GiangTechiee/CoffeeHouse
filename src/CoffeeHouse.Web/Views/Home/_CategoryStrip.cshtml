            <a asp-controller="Products" asp-action="Type" asp-route-target="5" asp-route-targetname="Trà" class="flex items-center gap-3 group">
                <span class="material-symbols-outlined text-primary text-2xl group-hover:scale-110 transition-transform">local_cafe</span>
                <span class="font-medium text-sm tracking-wide">Trà Đỉnh Cao</span>
            </a>
            <a asp-controller="News" asp-action="Index" class="flex items-center gap-3 group">
