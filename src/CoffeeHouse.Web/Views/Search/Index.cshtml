@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<Product>

@{
    ViewData["Title"] = "Kết quả tìm kiếm";
}

<!-- Breadcrumb -->
<div class="bg-surface-dark/30 py-6 border-b border-border/50">
    <div class="container-custom">
        <nav class="flex items-center gap-3 text-[10px] font-black uppercase tracking-[0.2em]">
            <a asp-controller="home" asp-action="index" class="text-text-muted hover:text-primary transition-colors flex items-center gap-2">
                <i class="fa-solid fa-house"></i>
                Trang chủ
            </a>
            <i class="fas fa-chevron-right text-[8px] text-text-muted"></i>
            <span class="text-secondary underline decoration-primary decoration-4 underline-offset-[12px]">Kết quả tìm kiếm</span>
        </nav>
    </div>
</div>

<!-- Search Results Section -->
<section class="py-24 bg-white min-h-[600px] relative overflow-hidden">
    <div class="container-custom relative z-10">
        <div class="mb-20 pb-10 border-b border-border/50 space-y-4">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Search Results</span>
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div>
                    <h2 class="text-5xl font-black text-secondary tracking-tighter italic">
                        Từ khóa: <span class="text-primary not-italic">"@ViewBag.search"</span>
                    </h2>
                    <p class="text-[10px] font-black uppercase tracking-widest text-text-muted mt-4">Tìm thấy <span class="text-secondary">@Model.TotalItemCount</span> sản phẩm tương ứng</p>
                </div>
            </div>
        </div>

        @if (Model.Count > 0)
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
                @foreach (var (item, index) in Model.Select((v, i) => (v, i)))
                {
                    <div class="group animate-scale-in" style="animation-delay: @(index * 100)ms">
                        <div class="relative aspect-[4/5] overflow-hidden rounded-[48px] bg-surface-dark shadow-sm hover:shadow-2xl transition-all duration-700">
                            <img src="@Url.Content("~/img/products/" + item.ImageUrl)" alt="@item.ProductName"
                                 class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110">
                            
                            <!-- Premium Actions Overlay -->
                            <div class="absolute inset-0 bg-gradient-to-t from-secondary/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500"></div>
                            
                            <div class="absolute bottom-8 left-8 right-8 translate-y-8 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">
                                <div class="flex flex-col gap-3">
                                    <a asp-controller="cart" asp-action="add" asp-route-id="@item.ProductId" asp-route-quantity="1"
                                       class="w-full btn-primary py-4 text-[10px] font-black uppercase tracking-widest shadow-lg shadow-primary/20">
                                        <i class="fas fa-plus mr-2"></i> Thêm nhanh
                                    </a>
                                    <div class="flex gap-2">
                                        <a asp-controller="products" asp-action="details" asp-route-id="@item.ProductId"
                                           class="flex-1 bg-white/10 backdrop-blur-md border border-white/20 py-3 rounded-2xl text-[10px] font-black text-white uppercase tracking-widest text-center hover:bg-white hover:text-secondary transition-all">
                                            Chi tiết
                                        </a>
                                        <a href="@Url.Content("~/img/products/" + item.ImageUrl)" 
                                           class="image-popup w-12 h-12 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl flex-center text-white hover:bg-white hover:text-secondary transition-all">
                                            <i class="fas fa-expand-alt text-xs"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-8 text-center space-y-2">
                            <h3 class="text-xl font-black text-secondary tracking-tight italic group-hover:text-primary transition-colors">
                                <a asp-controller="products" asp-action="details" asp-route-id="@item.ProductId">@item.ProductName</a>
                            </h3>
                            <p class="text-2xl font-black text-primary tracking-tighter italic">@item.Price.ToString("n0") <span class="text-xs uppercase ml-1 font-bold">đ</span></p>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.PageCount > 1)
            {
                <div class="mt-24 flex justify-center">
                    @Html.PagedListPager(Model, page => Url.Action("Index", new {
                        page = page,
                        search = ViewBag.search
                    }),
                    new PagedListRenderOptions()
                    {
                        MaximumPageNumbersToDisplay = 5,
                        PageClasses = new List<String> { "w-14 h-14 flex items-center justify-center rounded-2xl border border-border/50 text-xs font-black transition-all hover:bg-primary hover:text-white hover:border-primary shadow-sm hover:shadow-xl hover:-translate-y-1" },
                        UlElementClasses = new List<String> { "flex items-center gap-3" },
                        LiElementClasses = new List<String> { "" },
                        ActiveLiElementClass = "[&_a]:bg-primary [&_a]:text-white [&_a]:border-primary [&_a]:shadow-primary/20",
                    })
                </div>
            }
        }
        else
        {
            <div class="py-32 text-center max-w-lg mx-auto space-y-10 animate-scale-in">
                <div class="relative w-40 h-40 bg-surface-dark rounded-[48px] flex-center mx-auto text-text-light text-6xl shadow-inner group">
                    <i class="fas fa-search-minus transition-transform duration-700 group-hover:scale-110"></i>
                    <div class="absolute -top-4 -right-4 w-12 h-12 bg-rose-500 rounded-full flex-center text-white text-lg shadow-lg">
                        <i class="fas fa-times"></i>
                    </div>
                </div>
                <div class="space-y-4">
                    <h3 class="text-3xl font-black text-secondary tracking-tighter italic">Hành tinh này không có gì cả</h3>
                    <p class="text-text-muted font-medium text-lg leading-relaxed">Chúng tôi không tìm thấy kết quả nào tương ứng với <span class="text-primary italic">"@ViewBag.search"</span>. Hãy thử một hành trình tìm kiếm khác.</p>
                </div>
                <div class="pt-6">
                    <a asp-controller="home" asp-action="index" class="btn-primary px-12 py-5 shadow-xl shadow-primary/20">Quay lại trang chủ</a>
                </div>
            </div>
        }
    </div>

    <!-- Decorative decorative -->
    <div class="absolute top-0 right-0 p-32 opacity-[0.02] text-[20vw] font-black pointer-events-none select-none italic leading-none">
        SEARCH
    </div>
</section>



