@model IEnumerable<CoffeeHouse.Domain.Entities.SalesOrder>

@{
    ViewData["Title"] = "Lịch sử chuyến hành trình";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Breadcrumb -->
<div class="bg-surface-dark/30 py-6 border-b border-border/50">
    <div class="container-custom">
        <nav class="flex items-center gap-3 text-[10px] font-black uppercase tracking-[0.2em]">
            <a asp-controller="home" asp-action="index" class="text-text-muted hover:text-primary transition-colors flex items-center gap-2">
                <i class="fa-solid fa-house"></i>
                Trang chủ
            </a>
            <i class="fas fa-chevron-right text-[8px] text-text-muted"></i>
            <span class="text-secondary underline decoration-primary decoration-4 underline-offset-[12px]">Lịch sử đơn hàng</span>
        </nav>
    </div>
</div>

<section class="py-24 bg-white relative overflow-hidden min-h-[80vh]">
    <!-- Decorative background -->
    <div class="absolute top-0 right-0 p-32 opacity-[0.02] text-[15vw] font-black pointer-events-none select-none italic leading-none">
        HISTORY
    </div>

    <div class="container-custom relative z-10">
        <div class="max-w-6xl mx-auto">
            <div class="mb-16 pb-10 border-b-2 border-secondary/10 flex flex-col md:flex-row md:items-end justify-between gap-8">
                <div>
                    <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Mission Logs</span>
                    <h1 class="text-5xl font-black text-secondary tracking-tighter italic mt-4">Lịch sử <span class="text-primary not-italic">Đơn hàng</span></h1>
                </div>
                <div class="flex items-center gap-4 bg-surface-soft px-8 py-4 rounded-3xl border border-border/50">
                    <div class="w-10 h-10 bg-secondary rounded-xl flex-center text-white">
                        <i class="fas fa-clipboard-list text-sm"></i>
                    </div>
                    <div>
                        <p class="text-[8px] font-black uppercase tracking-widest text-text-light">Total Missions</p>
                        <p class="text-xl font-black text-secondary italic">@Model.Count() <span class="text-[10px] not-italic">Đơn</span></p>
                    </div>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="py-32 text-center space-y-8 animate-scale-in">
                    <div class="w-32 h-32 bg-surface-soft rounded-[48px] flex-center text-text-light mx-auto border-2 border-dashed border-border/50">
                        <i class="fas fa-box-open text-4xl"></i>
                    </div>
                    <div class="space-y-4">
                        <h3 class="text-2xl font-black text-secondary italic tracking-tight">Hệ thống chưa ghi nhận dữ liệu</h3>
                        <p class="text-text-muted max-w-sm mx-auto font-medium">Bạn chưa thực hiện bất kỳ chuyến hành trình hương vị nào cùng Coffee House.</p>
                        <div class="pt-4">
                             <a asp-controller="Products" asp-action="Index" class="btn-primary px-10">Bắt đầu ngay</a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="bg-white rounded-[56px] border border-border/50 shadow-2xl overflow-hidden animate-slide-up">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-secondary text-white">
                                    <th class="px-10 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Mã vận đơn</th>
                                    <th class="px-10 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Thời điểm khởi hành</th>
                                    <th class="px-10 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Ngân sách</th>
                                    <th class="px-10 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Trạng thái</th>
                                    <th class="px-10 py-8 text-[10px] font-black uppercase tracking-[0.3em] text-center">Tác vụ</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border/30">
                                @foreach (var (hd, index) in Model.Select((v, i) => (v, i)))
                                {
                                    <tr class="group hover:bg-surface-soft transition-colors duration-500 @(index % 2 != 0 ? "bg-surface-soft/30" : "")">
                                        <td class="px-10 py-8">
                                            <span class="text-sm font-black text-secondary tracking-widest">#@hd.OrderId</span>
                                        </td>
                                        <td class="px-10 py-8">
                                            <p class="text-sm font-bold text-secondary">@hd.OrderDate.ToString("dd/MM/yyyy")</p>
                                            <p class="text-[8px] font-black text-text-light uppercase tracking-widest mt-1">@hd.OrderDate.ToString("HH:mm") Local Time</p>
                                        </td>
                                        <td class="px-10 py-8">
                                            <p class="text-xl font-black text-primary tracking-tighter italic">@hd.TotalAmount.ToString("n0") <span class="text-xs ml-1 not-italic">đ</span></p>
                                            <p class="text-[8px] font-black text-text-light uppercase tracking-widest mt-1">@hd.PaymentMethod</p>
                                        </td>
                                        <td class="px-10 py-8">
                                            @{
                                                var statusColor = hd.Status == "Hoàn tất" ? "bg-status-success text-white" : 
                                                                 hd.Status == "Đã hủy" ? "bg-rose-500 text-white" : "bg-primary text-white";
                                            }
                                            <span class="inline-block px-5 py-2 rounded-full text-[8px] font-black uppercase tracking-widest @statusColor shadow-lg shadow-black/5">
                                                @hd.Status
                                            </span>
                                        </td>
                                        <td class="px-10 py-8 text-center">
                                            <a asp-action="Details" asp-route-id="@hd.OrderId" 
                                               class="inline-flex items-center gap-3 px-6 py-3 bg-secondary text-white rounded-2xl text-[8px] font-black uppercase tracking-widest hover:bg-primary transition-all shadow-lg hover:-translate-y-1">
                                                Log Detail
                                                <i class="fas fa-external-link-alt text-[8px]"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</section>




