<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="description" content="Coffee House - Premium Coffee & Beverages">
    <meta name="keywords" content="coffee, cafe, beverages, hanoi">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | COFFEE HOUSE</title>

    <!-- PWA Meta Tags -->
    <meta name="theme-color" content="#ca1515">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Coffee House">
    <link rel="manifest" href="~/manifest.json">
    <link rel="apple-touch-icon" href="~/images/icon-192.png">

    <!-- Favicon -->
    <link rel="shortcut icon" href="~/favicon.ico" />

    <!-- Custom Icons & Fonts -->
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="~/css/style-font.css" />
    
    <!-- Google Fonts for Vintage Theme -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- Core UI - Tailwind CSS (Unified) -->
    <link rel="stylesheet" href="~/css/tailwind.css" type="text/css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/vintage-home.css" type="text/css" asp-append-version="true">
    
    <!-- Legacy Plugin Support -->
    <link rel="stylesheet" href="~/lib/magnific-popup/dist/magnific-popup.css" type="text/css">
    <link rel="stylesheet" href="~/lib/owl-carousel-2/dist/assets/owl.carousel.min.css" type="text/css">
    <link rel="stylesheet" href="~/lib/owl-carousel-2/dist/assets/owl.theme.default.min.css" type="text/css">
    <link rel="stylesheet" href="~/lib/slick-nav/dist/slicknav.min.css" type="text/css">
</head>
<body class="bg-white text-secondary antialiased">
    <!-- Page Preloader -->
    <partial name="_PreloaderPartial" />

    <!-- Header Section; _HeaderPartial chứa phần header với dropdown -->
    <partial name="_HeaderPartial" />

    <!-- Main Body -->
    @RenderBody()

    <!-- Instagram Section -->
    <partial name="_InstagramPartial" />

    <!-- Footer Section -->
    <partial name="_FooterPartial" />

    <!-- Search Box -->
    <partial name="_SearchBoxPartial" />

    <!-- Back to Top -->
    <partial name="_BackToTopPartial" />

    <!-- JavaScript Libraries (jQuery & Plugin JS) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/magnific-popup/dist/jquery.magnific-popup.min.js"></script>
    <script src="~/lib/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/lib/mixitup/dist/mixitup.min.js"></script>
    <script src="~/lib/jquery.countdown/jquery.countdown.min.js"></script>
    <script src="~/lib/slick-nav/dist/jquery.slicknav.min.js"></script>
    <script src="~/lib/owl-carousel-2/dist/owl.carousel.min.js"></script>
    <script src="~/lib/jquery.nicescroll/dist/jquery.nicescroll.min.js"></script>

    <!-- Bootstrap Bundle (includes Popper.js) từ CDN (Bootstrap 5) -->
    @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYCOmLl/EQN98gtRxVQb0hPEnn0aW9JR1j7/4h"
            crossorigin="anonymous"></script> *@

    <script src="~/lib/fontawesome/js/all.min.js"></script>

    <!-- Template Javascript -->
    <script src="~/js/performance.js" asp-append-version="true"></script>
    <script src="~/js/image-optimizer.js" asp-append-version="true"></script>
    <script src="~/js/accessibility.js" asp-append-version="true"></script>
    <script src="~/js/dark-mode.js" asp-append-version="true"></script>
    <script src="~/js/advanced-interactions.js" asp-append-version="true"></script>
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script src="~/js/ux-enhancements.js" asp-append-version="true"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    <script src="~/js/main-additional.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(registration => {
                        console.log('✅ Service Worker registered:', registration.scope);
                    })
                    .catch(error => {
                        console.log('❌ Service Worker registration failed:', error);
                    });
            });
        }
    </script>

    <!-- (Tuỳ chọn) Khởi tạo thủ công các dropdown nếu cần -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Lấy đối tượng custom-dropdown
            var dropdown = document.getElementById("userDropdown");
            if (dropdown) {
                var toggle = dropdown.querySelector(".dropdown-toggle");
                toggle.addEventListener("click", function(e) {
                    e.preventDefault();
                    // Toggle class active
                    dropdown.classList.toggle("active");
                });
                // Đóng dropdown khi click ra ngoài
                document.addEventListener("click", function(e) {
                    if (!dropdown.contains(e.target)) {
                        dropdown.classList.remove("active");
                    }
                });
            }
        });
    </script>

</body>
</html>
