@model int

<a asp-controller="cart" asp-action="index" title="Giỏ hàng" class="relative group">
    <span class="material-symbols-outlined text-2xl group-hover:text-primary transition-colors">shopping_cart</span>
    @if (Model > 0)
    {
        <span class="absolute -top-1 -right-1 bg-primary text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center font-bold">
            @Model
        </span>
    }
</a>
