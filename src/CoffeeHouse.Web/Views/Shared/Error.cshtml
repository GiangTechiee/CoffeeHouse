@model CoffeeHouse.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "404 Not Found";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- 404 Error Page with Tailwind -->
<section class="min-h-screen flex items-center justify-center bg-gradient-to-br from-surface-dark via-white to-surface-dark py-24 px-6 relative overflow-hidden">
    <!-- Decorative background -->
    <div class="absolute top-0 right-0 p-32 opacity-[0.02] text-[20vw] font-black pointer-events-none select-none italic leading-none">
        404
    </div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-primary/5 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="max-w-2xl mx-auto text-center relative z-10 space-y-12 animate-slide-up">
        <!-- Error Icon -->
        <div class="flex justify-center">
            <div class="w-32 h-32 bg-primary/10 rounded-[48px] flex items-center justify-center border border-primary/20 shadow-2xl shadow-primary/10 animate-pulse">
                <i class="fas fa-satellite-dish text-6xl text-primary"></i>
            </div>
        </div>

        <!-- Error Code -->
        <div class="space-y-4">
            <h1 class="text-8xl font-black text-secondary tracking-tighter italic">
                404
            </h1>
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center justify-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary after:content-[''] after:w-12 after:h-px after:bg-primary">
                Signal Lost
            </span>
        </div>

        <!-- Error Message -->
        <div class="space-y-6">
            <h3 class="text-3xl font-black text-secondary tracking-tight">
                Không tìm thấy trang yêu cầu
            </h3>
            <p class="text-lg text-text-muted max-w-md mx-auto leading-relaxed">
                Trang bạn đang tìm kiếm có thể đã bị xóa, đổi tên hoặc tạm thời không khả dụng.
            </p>
        </div>

        @if (Model.ShowRequestId)
        {
            <div class="bg-surface-soft p-6 rounded-[32px] border border-border/50 inline-block">
                <p class="text-[10px] font-black uppercase tracking-widest text-text-light mb-2">Request ID</p>
                <code class="text-sm font-bold text-secondary">@Model.RequestId</code>
            </div>
        }

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-6 justify-center items-center pt-8">
            <a asp-controller="Home" asp-action="Index" 
               class="btn-primary px-10 py-4 text-[10px] font-black uppercase tracking-widest flex items-center gap-3 shadow-xl shadow-primary/20">
                <i class="fas fa-home"></i>
                Về trang chủ
            </a>
            <button onclick="history.back()" 
                    class="px-10 py-4 text-[10px] font-black uppercase tracking-widest text-secondary hover:text-primary transition-all flex items-center gap-3 border-2 border-secondary/10 hover:border-primary rounded-[24px]">
                <i class="fas fa-arrow-left"></i>
                Quay lại
            </button>
        </div>
    </div>
</section>

