@using Microsoft.AspNetCore.Http
@{
    var tenTaiKhoan = Context.Session.GetString("Username");
    var role = Context.Session.GetString("Role");
}

<header class="sticky top-0 z-50 bg-background-light/90 dark:bg-background-dark/90 backdrop-blur-md border-b border-[#E5E7EB] dark:border-gray-800">
    <div class="max-w-[1440px] mx-auto px-10 h-20 flex items-center justify-between">
        <!-- Logo -->
        <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 group cursor-pointer">
            <div class="text-primary">
                <svg class="w-8 h-8" fill="currentColor" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 4H17.3334V17.3334H30.6666V30.6666H44V44H4V4Z"></path>
                </svg>
            </div>
            <span class="text-xl font-bold tracking-tight uppercase">The Coffee House</span>
        </a>

        <!-- Navigation Links -->
        <nav class="hidden md:flex items-center gap-10">
            <a class="text-sm font-medium hover:text-primary transition-colors @(ViewData["Products"]?.ToString() == "active" ? "text-primary" : "")" asp-controller="Products" asp-action="Index">Cà phê</a>
            <a class="text-sm font-medium hover:text-primary transition-colors" asp-controller="Products" asp-action="Type" asp-route-target="5" asp-route-targetname="Trà">Trà</a>
            <a class="text-sm font-medium hover:text-primary transition-colors @(ViewData["News"]?.ToString() == "active" ? "text-primary" : "")" asp-controller="News" asp-action="Index">Cảm hứng</a>
            <a class="text-sm font-medium hover:text-primary transition-colors @(ViewData["About"]?.ToString() == "active" ? "text-primary" : "")" asp-controller="About" asp-action="Index">Cửa hàng</a>
        </nav>

        <!-- Icons -->
        <div class="flex items-center gap-6">
            <button class="material-symbols-outlined text-2xl hover:text-primary transition-colors search-switch">search</button>
            <div class="relative group">
                @if (string.IsNullOrEmpty(tenTaiKhoan))
                {
                    <a asp-controller="Auth" asp-action="Login" class="material-symbols-outlined text-2xl hover:text-primary transition-colors">person</a>
                }
                else
                {
                    <button class="material-symbols-outlined text-2xl text-primary">person</button>
                    <!-- Simple Dropdown -->
                    <div class="absolute right-0 mt-4 w-64 bg-white dark:bg-background-dark border border-[#E5E7EB] dark:border-gray-800 rounded-xl shadow-2xl py-6 opacity-0 invisible translate-y-4 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-300 z-50 overflow-hidden">
                        <div class="px-8 pb-4 border-b border-gray-100 dark:border-gray-800 mb-4">
                            <p class="text-[10px] uppercase tracking-widest text-warm-gray font-bold">Tài khoản</p>
                            <p class="text-sm font-bold truncate mt-1">@tenTaiKhoan</p>
                        </div>
                        <div class="px-4 space-y-1">
                            <a class="flex items-center gap-4 px-4 py-3 text-sm font-medium hover:bg-beige-soft dark:hover:bg-gray-800 rounded-lg transition-all" asp-controller="Account" asp-action="ThongTin">
                                <span class="material-symbols-outlined text-lg">badge</span> Hồ sơ
                            </a>
                            @if (role == "Admin" || role == "Employee")
                            {
                                <a class="flex items-center gap-4 px-4 py-3 text-sm font-medium text-primary hover:bg-primary/5 rounded-lg transition-all" asp-area="Admin" asp-controller="HomeAdmin" asp-action="Index">
                                    <span class="material-symbols-outlined text-lg">settings</span> Quản trị
                                </a>
                            }
                            <hr class="border-gray-100 dark:border-gray-800 mx-4 my-2" />
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="block">
                                <button type="submit" class="flex w-full items-center gap-4 px-4 py-3 text-sm font-medium text-red-500 hover:bg-red-50 dark:hover:bg-red-900/10 rounded-lg transition-all">
                                    <span class="material-symbols-outlined text-lg">logout</span> Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
            @await Component.InvokeAsync("ShoppingCartSummary")
        </div>
    </div>
</header>
