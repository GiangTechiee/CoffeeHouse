<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Coffee House</title>
    
    <!-- Fonts -->
    <link rel="stylesheet" type="text/css" href="~/css/style-font.css" />
    
    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
</head>
<body class="bg-secondary min-h-screen flex items-center justify-center py-16 px-6 relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute top-0 right-0 p-32 opacity-[0.03] text-[20vw] font-black pointer-events-none select-none italic leading-none text-white">
        ACCESS
    </div>
    <div class="absolute bottom-0 left-0 p-32 opacity-[0.03] text-[20vw] font-black pointer-events-none select-none italic leading-none text-white">
        COFFEE
    </div>
    <div class="absolute -top-40 -left-40 w-[600px] h-[600px] bg-primary/10 rounded-full blur-[150px] pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-[600px] h-[600px] bg-primary/5 rounded-full blur-[150px] pointer-events-none"></div>

    <div class="max-w-xl w-full relative z-10 transition-all duration-700">
        @RenderBody()
    </div>

    <!-- Script references if needed -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/fontawesome/js/all.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>


