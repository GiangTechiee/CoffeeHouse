<section class="mt-20 overflow-hidden border-t border-b" style="border-color: var(--border-color);">
    <div class="container-vintage py-6 text-center">
        <div class="flex items-center justify-center gap-4 mb-4">
            <i class="fab fa-instagram" style="color: var(--brass-gold); font-size: 20px;"></i>
            <span class="label-small" style="font-size: 14px;">@("@")thespacecoffee</span>
        </div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6">
        @for (int i = 1; i <= 6; i++)
        {
            <div class="relative group aspect-square overflow-hidden border-r" style="border-right-color: var(--border-color);">
                <div class="absolute inset-0 bg-cover bg-center sepia-img transition-transform duration-1000 group-hover:scale-110"
                     style="background-image: url('../../img/instagram/insta-@(i).jpg')"></div>
                
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col items-center justify-center text-[#F7F2E8]">
                    <i class="fab fa-instagram text-2xl"></i>
                </div>
            </div>
        }
    </div>
</section>
