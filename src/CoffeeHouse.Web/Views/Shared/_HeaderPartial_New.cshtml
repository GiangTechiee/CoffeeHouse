@{
    // Láº¥y thÃ´ng tin Ä‘Äƒng nháº­p tá»« session
    var tenTaiKhoan = Context.Session.GetString("Username");
    var role = Context.Session.GetString("Role");
}

<!-- Header with Tailwind + UX Improvements -->
<header class="header fixed top-0 left-0 right-0 bg-white shadow-sm transition-all duration-300 z-50" id="header-navbar">
    <div class="container mx-auto px-4">
        <div class="flex items-center justify-between py-4">
            
            <!-- Logo -->
            <div class="flex-shrink-0">
                <a asp-controller="home" asp-action="index" 
                   class="flex items-center gap-2 text-2xl font-bold text-primary hover:text-primary-dark transition-colors duration-300">
                    <i class="fas fa-coffee"></i>
                    <span>Coffee House</span>
                </a>
            </div>

            <!-- Desktop Menu -->
            <nav class="hidden lg:flex items-center gap-8">
                <a asp-controller="home" asp-action="index" 
                   class="text-sm font-semibold uppercase text-secondary hover:text-primary transition-colors duration-300 relative group @((string)ViewData["Home"])">
                    Trang chá»§
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary transition-all duration-300 group-hover:w-full"></span>
                </a>
                <a asp-controller="products" asp-action="index" 
                   class="text-sm font-semibold uppercase text-secondary hover:text-primary transition-colors duration-300 relative group @((string)ViewData["Products"])">
                    Sáº£n pháº©m
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary transition-all duration-300 group-hover:w-full"></span>
                </a>
                <a asp-controller="news" asp-action="index" 
                   class="text-sm font-semibold uppercase text-secondary hover:text-primary transition-colors duration-300 relative group @((string)ViewData["News"])">
                    Tin tá»©c
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary transition-all duration-300 group-hover:w-full"></span>
                </a>
                <a asp-controller="about" asp-action="index" 
                   class="text-sm font-semibold uppercase text-secondary hover:text-primary transition-colors duration-300 relative group @((string)ViewData["About"])">
                    Giá»›i thiá»‡u
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary transition-all duration-300 group-hover:w-full"></span>
                </a>
            </nav>

            <!-- Right Side Actions -->
            <div class="flex items-center gap-6">
                
                <!-- Search Button -->
                <button class="search-switch text-secondary hover:text-primary transition-all duration-300 hover:scale-110" 
                        title="TÃ¬m kiáº¿m" aria-label="TÃ¬m kiáº¿m">
                    <i class="fas fa-search text-lg"></i>
                </button>

                @if (string.IsNullOrEmpty(tenTaiKhoan))
                {
                    <!-- Login Button -->
                    <a asp-controller="Auth" asp-action="Login" 
                       class="hidden sm:flex items-center gap-2 text-sm font-semibold text-secondary hover:text-primary transition-colors duration-300">
                        <i class="fas fa-sign-in-alt"></i>
                        <span>ÄÄƒng nháº­p</span>
                    </a>
                }
                else
                {
                    <!-- User Dropdown -->
                    <div class="relative" id="userDropdown">
                        <button class="flex items-center gap-2 px-4 py-2 text-sm font-semibold text-secondary hover:bg-surface-dark hover:text-primary rounded-full transition-all duration-300">
                            <i class="fas fa-user-circle text-lg"></i>
                            <span class="hidden sm:inline">@tenTaiKhoan</span>
                            <i class="fas fa-chevron-down text-xs"></i>
                        </button>
                        
                        <!-- Dropdown Menu -->
                        <div class="absolute right-0 mt-2 w-56 bg-white rounded-lg shadow-xl opacity-0 invisible transform -translate-y-2 transition-all duration-300 dropdown-menu">
                            <div class="py-2">
                                <a asp-controller="Account" asp-action="ThongTin" 
                                   class="block px-6 py-3 text-sm text-secondary hover:bg-surface-dark hover:text-primary hover:pl-8 transition-all duration-200">
                                    <i class="fas fa-user w-5"></i> ThÃ´ng tin Ä‘Äƒng nháº­p
                                </a>
                                
                                @if (role == "Admin" || role == "Employee")
                                {
                                    <a asp-area="Admin" asp-controller="HomeAdmin" asp-action="Index" 
                                       class="block px-6 py-3 text-sm text-secondary hover:bg-surface-dark hover:text-primary hover:pl-8 transition-all duration-200">
                                        <i class="fas fa-cog w-5"></i> Quáº£n lÃ½
                                    </a>
                                }
                                
                                @if (role == "User")
                                {
                                    <a asp-controller="HoaDon" asp-action="Index" 
                                       class="block px-6 py-3 text-sm text-secondary hover:bg-surface-dark hover:text-primary hover:pl-8 transition-all duration-200">
                                        <i class="fas fa-receipt w-5"></i> HÃ³a Ä‘Æ¡n Ä‘Æ¡n hÃ ng
                                    </a>
                                }
                                
                                <div class="border-t border-surface-darker my-2"></div>
                                
                                <a asp-controller="Auth" asp-action="Logout" 
                                   class="block px-6 py-3 text-sm text-primary hover:bg-surface-dark hover:pl-8 transition-all duration-200">
                                    <i class="fas fa-sign-out-alt w-5"></i> ÄÄƒng xuáº¥t
                                </a>
                            </div>
                        </div>
                    </div>
                }

                <!-- Shopping Cart -->
                <div class="relative">
                    @await Component.InvokeAsync("ShoppingCartSummary")
                </div>

                <!-- Mobile Menu Toggle -->
                <button class="lg:hidden text-secondary hover:text-primary transition-colors duration-300 canvas__open" 
                        aria-label="Menu">
                    <i class="fas fa-bars text-xl"></i>
                </button>
            </div>
        </div>
    </div>
</header>

<!-- Header Spacer -->
<div class="h-20"></div>

<style>
    /* Active menu item */
    .header nav a.active::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: var(--color-primary);
    }
    
    /* Dropdown show/hide */
    #userDropdown:hover .dropdown-menu,
    #userDropdown.active .dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
</style>

<script>
    // Enhanced dropdown with click toggle
    document.addEventListener('DOMContentLoaded', function() {
        const dropdown = document.getElementById('userDropdown');
        if (dropdown) {
            const toggle = dropdown.querySelector('button');
            
            toggle.addEventListener('click', function(e) {
                e.stopPropagation();
                dropdown.classList.toggle('active');
            });
            
            // Close on outside click
            document.addEventListener('click', function(e) {
                if (!dropdown.contains(e.target)) {
                    dropdown.classList.remove('active');
                }
            });
        }
    });
</script>

