@model CoffeeHouse.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký thành viên";
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
}

<div class="bg-white/95 backdrop-blur-2xl p-10 sm:p-14 rounded-[64px] shadow-2xl border border-white/20 animate-scale-in relative overflow-hidden group max-w-2xl mx-auto">
    <!-- Decorative inner elements -->
    <div class="absolute top-0 left-0 p-12 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary">
        ENROLL
    </div>

    <div class="relative z-10">
        <div class="text-center mb-12 space-y-4">
            <a asp-controller="home" asp-action="index" class="inline-flex items-center gap-4 group/logo mb-4">
                <div class="w-14 h-14 bg-primary rounded-2xl flex items-center justify-center transform transition-all duration-500 group-hover/logo:rotate-[15deg] group-hover/logo:scale-110 shadow-lg shadow-primary/20">
                    <i class="fas fa-coffee text-white text-2xl"></i>
                </div>
                <div class="flex flex-col text-left">
                    <span class="text-2xl font-black tracking-tighter text-secondary leading-none italic group-hover/logo:text-primary transition-colors">
                        COFFEE <span class="text-primary not-italic">HOUSE</span>
                    </span>
                    <span class="text-[8px] font-black uppercase tracking-[0.4em] text-text-light mt-1">Enrollment Protocol</span>
                </div>
            </a>
            <h1 class="text-3xl font-black text-secondary tracking-tighter italic">Gia nhập phi hành đoàn</h1>
            <p class="text-text-muted text-xs font-medium tracking-wide">Bắt đầu hành trình khám phá hương vị không giới hạn</p>
        </div>

        <form asp-action="Register" method="post" class="space-y-10">
            <!-- Section 1: Identity Profile -->
            <div class="space-y-6">
                <div class="flex items-center gap-4">
                    <span class="w-8 h-8 rounded-xl bg-secondary text-white flex-center text-[10px] font-black">01</span>
                    <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-primary">Identity Profile</h3>
                    <div class="h-px bg-border/50 flex-1"></div>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-3 md:col-span-2">
                        <label asp-for="Email" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-6">Email (Tài khoản)</label>
                        <div class="relative group/input">
                            <input asp-for="Email" class="input-modern bg-surface-soft !rounded-[24px] pl-14 h-16 text-base font-bold transition-all shadow-inner" placeholder="example@email.com" required />
                            <i class="fas fa-envelope absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                        </div>
                        <span asp-validation-for="Email" class="text-rose-500 text-[10px] mt-1 ml-6 block font-black uppercase tracking-widest"></span>
                    </div>

                    <div class="space-y-3">
                        <label asp-for="Password" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-6">Mật mã bảo mật</label>
                        <div class="relative group/input">
                            <input asp-for="Password" type="password" class="input-modern bg-surface-soft !rounded-[24px] pl-14 h-16 text-base font-bold transition-all shadow-inner" placeholder="••••••••" required />
                            <i class="fas fa-shield-alt absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                        </div>
                        <span asp-validation-for="Password" class="text-rose-500 text-[10px] mt-1 ml-6 block font-black uppercase tracking-widest"></span>
                    </div>

                    <div class="space-y-3">
                        <label asp-for="ConfirmPassword" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-6">Xác thực mật mã</label>
                        <div class="relative group/input">
                            <input asp-for="ConfirmPassword" type="password" class="input-modern bg-surface-soft !rounded-[24px] pl-14 h-16 text-base font-bold transition-all shadow-inner" placeholder="••••••••" required />
                            <i class="fas fa-lock absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-rose-500 text-[10px] mt-1 ml-6 block font-black uppercase tracking-widest"></span>
                    </div>
                </div>
            </div>

            <!-- Section 2: Personal Dossier -->
            <div class="space-y-6">
                <div class="flex items-center gap-4">
                    <span class="w-8 h-8 rounded-xl bg-secondary text-white flex-center text-[10px] font-black">02</span>
                    <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-primary">Personal Dossier</h3>
                    <div class="h-px bg-border/50 flex-1"></div>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-3">
                        <label asp-for="CustomerName" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-6">Danh tính thực (Họ tên)</label>
                        <div class="relative group/input">
                            <input asp-for="CustomerName" class="input-modern bg-surface-soft !rounded-[24px] pl-14 h-16 text-base font-bold transition-all shadow-inner" placeholder="Nguyễn Văn A" required />
                            <i class="fas fa-user-circle absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                        </div>
                        <span asp-validation-for="CustomerName" class="text-rose-500 text-[10px] mt-1 ml-6 block font-black uppercase tracking-widest"></span>
                    </div>

                    <div class="space-y-3">
                        <label asp-for="PhoneNumber" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-6">Tần số kết nối (SĐT)</label>
                        <div class="relative group/input">
                            <input asp-for="PhoneNumber" class="input-modern bg-surface-soft !rounded-[24px] pl-14 h-16 text-base font-bold transition-all shadow-inner" placeholder="0901234567" required />
                            <i class="fas fa-phone-alt absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-rose-500 text-[10px] mt-1 ml-6 block font-black uppercase tracking-widest"></span>
                    </div>

                    <div class="space-y-3 md:col-span-2">
                        <label asp-for="Address" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-6">Tọa độ cung ứng (Địa chỉ)</label>
                        <div class="relative group/input">
                            <input asp-for="Address" class="input-modern bg-surface-soft !rounded-[24px] pl-14 h-16 text-base font-bold transition-all shadow-inner" placeholder="Số nhà, Tên đường, Quận/Huyện..." required />
                            <i class="fas fa-map-marker-alt absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                        </div>
                        <span asp-validation-for="Address" class="text-rose-500 text-[10px] mt-1 ml-6 block font-black uppercase tracking-widest"></span>
                    </div>
                </div>
            </div>

            <div class="pt-6">
                <button type="submit" class="w-full btn-primary h-20 !rounded-[32px] text-[10px] font-black uppercase tracking-[0.3em] shadow-xl shadow-primary/20 hover:shadow-2xl hover:shadow-primary/30 transition-all flex items-center justify-center gap-4 group/btn">
                    Hoàn tất thủ tục đăng ký
                    <i class="fas fa-rocket group-hover/btn:translate-x-2 group-hover/btn:-translate-y-2 transition-transform"></i>
                </button>
            </div>
        </form>

        <div class="mt-16 pt-10 border-t border-border/50 text-center">
            <p class="text-[10px] font-black uppercase tracking-widest text-text-muted">
                Đã là thành viên phi hành đoàn?
            </p>
            <a asp-action="Login" asp-controller="Auth" class="inline-block mt-4 px-10 py-4 bg-secondary text-white rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] hover:bg-primary transition-all shadow-lg hover:-translate-y-1">
                Quay lại Đăng nhập
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}




