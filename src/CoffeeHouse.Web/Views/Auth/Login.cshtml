@model CoffeeHouse.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
}

<div class="bg-white/95 backdrop-blur-2xl p-12 sm:p-16 rounded-[64px] shadow-2xl border border-white/20 animate-scale-in relative overflow-hidden group">
    <!-- Decorative inner elements -->
    <div class="absolute top-0 right-0 p-12 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary">
        USER
    </div>

    <div class="relative z-10">
        <div class="text-center mb-16 space-y-4">
            <a asp-controller="home" asp-action="index" class="inline-flex items-center gap-4 group/logo mb-4">
                <div class="w-16 h-16 bg-primary rounded-2xl flex items-center justify-center transform transition-all duration-500 group-hover/logo:rotate-[15deg] group-hover/logo:scale-110 shadow-lg shadow-primary/20">
                    <i class="fas fa-coffee text-white text-3xl"></i>
                </div>
                <div class="flex flex-col text-left">
                    <span class="text-3xl font-black tracking-tighter text-secondary leading-none italic group-hover/logo:text-primary transition-colors">
                        COFFEE <span class="text-primary not-italic">HOUSE</span>
                    </span>
                    <span class="text-[8px] font-black uppercase tracking-[0.4em] text-text-light mt-1">Identity Terminal</span>
                </div>
            </a>
            <h1 class="text-4xl font-black text-secondary tracking-tighter italic">Chào mừng trở lại!</h1>
            <p class="text-text-muted text-sm font-medium tracking-wide">Vui lòng cung cấp danh tính phi hành đoàn để tiếp tục</p>
        </div>

        <form asp-action="Login" method="post" class="space-y-8">
            <div asp-validation-summary="ModelOnly" class="bg-rose-50 text-rose-600 p-6 rounded-[32px] text-xs font-bold border border-rose-100 flex items-center gap-4 animate-slide-up">
                <div class="w-10 h-10 bg-rose-500 text-white rounded-xl flex-center flex-shrink-0 shadow-lg shadow-rose-200">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div>Thông tin xác thực không chính xác. <br/><span class="opacity-70">Vui lòng kiểm tra lại tài khoản hoặc mật khẩu.</span></div>
            </div>

            <div class="space-y-6">
                <!-- Username -->
                <div class="space-y-3">
                    <label asp-for="Username" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-6">Mã nhân dạng / Tài khoản</label>
                    <div class="relative group/input">
                        <input asp-for="Username" class="input-modern bg-surface-soft !rounded-[32px] pl-16 h-20 text-lg font-bold border-transparent focus:bg-white transition-all shadow-inner" placeholder="C-HOUSE-USER" required />
                        <div class="absolute left-6 top-1/2 -translate-y-1/2 w-8 h-8 rounded-xl flex-center text-text-light group-focus-within/input:bg-primary group-focus-within/input:text-white transition-all">
                            <i class="fas fa-user-astronaut text-sm"></i>
                        </div>
                    </div>
                    <span asp-validation-for="Username" class="text-rose-500 text-[10px] mt-1 ml-6 block font-black uppercase tracking-widest"></span>
                </div>

                <!-- Password -->
                <div class="space-y-3">
                    <label asp-for="Password" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-6">Mã khóa bảo mật</label>
                    <div class="relative group/input">
                        <input asp-for="Password" type="password" class="input-modern bg-surface-soft !rounded-[32px] pl-16 h-20 text-lg font-bold border-transparent focus:bg-white transition-all shadow-inner" placeholder="••••••••" required />
                        <div class="absolute left-6 top-1/2 -translate-y-1/2 w-8 h-8 rounded-xl flex-center text-text-light group-focus-within/input:bg-primary group-focus-within/input:text-white transition-all">
                            <i class="fas fa-fingerprint text-sm"></i>
                        </div>
                    </div>
                    <span asp-validation-for="Password" class="text-rose-500 text-[10px] mt-1 ml-6 block font-black uppercase tracking-widest"></span>
                </div>
            </div>

            <div class="flex items-center justify-between px-4">
                <label class="flex items-center gap-3 cursor-pointer group">
                    <div class="relative flex items-center">
                        <input type="checkbox" class="peer h-5 w-5 cursor-pointer appearance-none rounded-lg border border-border/50 bg-surface-soft checked:bg-primary checked:border-primary transition-all">
                        <i class="fas fa-check absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-[10px] text-white opacity-0 peer-checked:opacity-100 transition-opacity"></i>
                    </div>
                    <span class="text-[10px] font-black uppercase tracking-widest text-text-muted group-hover:text-secondary transition-colors">Ghi nhớ phiên đăng nhập</span>
                </label>
                <a href="#" class="text-[10px] font-black uppercase tracking-widest text-primary hover:text-primary-dark transition-all border-b-2 border-primary/20 hover:border-primary">Quên mật mã?</a>
            </div>

            <div class="pt-4">
                <button type="submit" class="w-full btn-primary h-20 !rounded-[32px] text-xs font-black uppercase tracking-[0.3em] shadow-xl shadow-primary/20 hover:shadow-2xl hover:shadow-primary/30 transition-all flex items-center justify-center gap-4 group/btn">
                    Khởi động quy trình
                    <i class="fas fa-arrow-right group-hover/btn:translate-x-2 transition-transform"></i>
                </button>
            </div>
        </form>

        <div class="mt-20 pt-10 border-t border-border/50 text-center">
            <p class="text-[10px] font-black uppercase tracking-widest text-text-muted">
                Dành cho phi hành đoàn mới
            </p>
            <a asp-action="Register" asp-controller="Auth" class="inline-block mt-4 px-10 py-4 bg-secondary text-white rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] hover:bg-primary transition-all shadow-lg hover:-translate-y-1">
                Đăng ký thành viên
            </a>
        </div>
    </div>
</div>






