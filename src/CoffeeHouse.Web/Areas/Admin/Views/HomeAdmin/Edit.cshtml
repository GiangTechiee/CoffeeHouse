@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model CoffeeHouse.ViewModels.SanPhamViewModel

@{
    ViewData["Title"] = "Calibrate Unit Parameters";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var currentImageUrl = ViewBag.CurrentImageUrl as string;
}

<div class="max-w-5xl mx-auto space-y-12 animate-fade-in">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.3em] text-text-light">
        <a asp-action="Index" class="hover:text-primary transition-colors">Inventory logs</a>
        <i class="fas fa-chevron-right text-[8px]"></i>
        <span class="text-secondary italic">Parameter Calibration</span>
    </nav>

    <!-- Header -->
    <div class="pb-10 border-b-2 border-secondary/10 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-12 opacity-[0.02] text-7xl font-black pointer-events-none select-none italic text-secondary">
            EDIT MODE
        </div>
        <div class="relative z-10 space-y-4">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">System Override: ACTIVE</span>
            <h1 class="text-5xl lg:text-7xl font-black text-secondary tracking-tighter italic leading-none">Hiệu chỉnh <span class="text-primary not-italic">Sản phẩm</span></h1>
            <div class="flex items-center gap-4">
                <span class="text-[10px] font-black text-text-muted font-mono bg-surface-soft px-4 py-1 rounded-lg border border-border/50 shadow-inner">ENTRY_ID: #@Model.ProductId</span>
                <p class="text-[10px] font-black uppercase tracking-widest text-text-light italic">Modify technical parameters for current inventory unit.</p>
            </div>
        </div>
    </div>

    <!-- Form Container -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 lg:p-16 rounded-[64px] border border-border/50 shadow-2xl relative">
        <form asp-action="Edit" enctype="multipart/form-data" class="space-y-12">
            <div asp-validation-summary="ModelOnly" class="rounded-3xl bg-rose-50 border border-rose-100 p-6 text-rose-500 text-[10px] font-black uppercase tracking-widest italic shadow-inner"></div>
            <input type="hidden" asp-for="ProductId" />

            <!-- Section 1: Identity Parameters -->
            <div class="space-y-8">
                <div class="flex items-center gap-6">
                    <span class="w-10 h-10 rounded-2xl bg-secondary text-white flex-center text-[10px] font-black italic shadow-lg shadow-secondary/20">A1</span>
                    <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary">Identity Override</h3>
                    <div class="h-px bg-border/50 flex-1"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                    <div class="space-y-4">
                        <label asp-for="ProductName" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Định danh sản phẩm</label>
                        <div class="relative group/input">
                            <input asp-for="ProductName" class="input-modern h-20 !rounded-[28px] pl-8 text-base font-bold shadow-inner" placeholder="E.g. Galaxy Cold Brew..." required />
                            <i class="fas fa-terminal absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                        </div>
                        <span asp-validation-for="ProductName" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <div class="space-y-4">
                        <label asp-for="CategoryId" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Sector Assignment</label>
                        <div class="relative group/select">
                            <select asp-for="CategoryId" class="input-modern h-20 !rounded-[28px] pl-8 pr-12 text-base font-bold appearance-none shadow-inner" asp-items="ViewBag.CategoryId"></select>
                            <i class="fas fa-layer-group absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/select:text-primary pointer-events-none transition-all"></i>
                        </div>
                        <span asp-validation-for="CategoryId" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>
                </div>
            </div>

            <!-- Section 2: Technical Data -->
            <div class="space-y-8">
                <div class="flex items-center gap-6">
                    <span class="w-10 h-10 rounded-2xl bg-secondary text-white flex-center text-[10px] font-black italic shadow-lg shadow-secondary/20">B2</span>
                    <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary">Technical Calibration</h3>
                    <div class="h-px bg-border/50 flex-1"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                    <div class="space-y-4">
                        <label asp-for="Price" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Market Budget Index (VNĐ)</label>
                        <div class="relative group/input">
                            <input asp-for="Price" class="input-modern h-20 !rounded-[28px] pl-8 text-base font-bold shadow-inner" required />
                            <i class="fas fa-microchip absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                        </div>
                        <span asp-validation-for="Price" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <div class="space-y-4">
                        <label asp-for="Notes" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Mission Logs (Ghi chú)</label>
                        <div class="relative group/input">
                            <input asp-for="Notes" class="input-modern h-20 !rounded-[28px] pl-8 text-base font-bold shadow-inner" />
                            <i class="fas fa-clipboard-list absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                        </div>
                    </div>

                    <div class="md:col-span-2 space-y-4">
                        <label asp-for="Description" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Technical Description Payload</label>
                        <div class="relative group/input">
                            <textarea asp-for="Description" rows="4" class="input-modern !py-6 !rounded-[32px] pl-8 text-base font-bold shadow-inner" placeholder="Analyze and describe unit characteristics..."></textarea>
                        </div>
                        <span asp-validation-for="Description" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <!-- System Assets -->
                    <div class="md:col-span-2 space-y-6">
                        <label class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Visual Component Relinking</label>
                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
                            <div class="lg:col-span-8">
                                <label for="imageUpload" class="relative group/file cursor-pointer block">
                                    <div class="h-64 rounded-[40px] border-4 border-dashed border-border/50 bg-surface-soft hover:bg-white hover:border-primary/30 transition-all duration-500 flex flex-col items-center justify-center gap-6 p-10 overflow-hidden shadow-inner">
                                        <div class="w-16 h-16 bg-white rounded-2xl flex-center shadow-lg group-hover/file:scale-110 transition-transform duration-500">
                                            <i class="fas fa-sync text-2xl text-text-light group-hover/file:text-primary group-hover/file:rotate-180 transition-all duration-700"></i>
                                        </div>
                                        <div class="text-center">
                                            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-secondary">Relink Visual Asset</p>
                                            <p class="text-[8px] font-bold text-text-light uppercase tracking-widest mt-2">Replace current .JPG / .PNG signature</p>
                                        </div>
                                        <input type="file" asp-for="ImageFile" id="imageUpload" class="hidden" onchange="previewUpdate(event)" />
                                    </div>
                                </label>
                            </div>
                            <div class="lg:col-span-4">
                                <div class="space-y-4">
                                    <p class="text-[8px] font-black text-center text-text-light uppercase tracking-widest">Current Signature</p>
                                    <div id="assetPreview" class="h-48 rounded-[40px] border border-border/50 bg-white p-3 shadow-2xl relative overflow-hidden group/preview">
                                        <div class="w-full h-full rounded-[30px] overflow-hidden bg-surface-soft border border-border/30">
                                            <img id="imgCurrent" src="@(currentImageUrl?.StartsWith("http") == true ? currentImageUrl : Url.Content("~/img/products/" + currentImageUrl))" class="w-full h-full object-cover grayscale group-hover/preview:grayscale-0 transition-all duration-1000 scale-110 group-hover/preview:scale-100" />
                                        </div>
                                        <div class="absolute inset-0 bg-secondary/80 backdrop-blur-sm opacity-0 group-hover/preview:opacity-100 transition-all duration-500 flex-center">
                                            <p class="text-[8px] font-black text-white uppercase tracking-[0.5em] italic">Active Asset</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Execution Strategy -->
            <div class="pt-10 flex flex-col sm:flex-row items-center justify-between border-t border-border/50 gap-8">
                <a asp-action="Index" class="flex items-center gap-4 text-[10px] font-black uppercase tracking-widest text-text-muted hover:text-secondary transition-all group">
                    <i class="fas fa-chevron-left transition-transform group-hover:-translate-x-2"></i>
                    Abort Calibration
                </a>
                
                <button type="submit" class="w-full sm:w-auto btn-primary h-20 !px-16 !rounded-[32px] flex items-center justify-center gap-6 group shadow-2xl shadow-primary/30">
                    <span class="text-[10px] font-black uppercase tracking-[0.3em]">Commit Entry Changes</span>
                    <i class="fas fa-check-circle transition-transform group-hover:scale-125"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<script type="text/javascript">
    function previewUpdate(event) {
        const fileInput = event.target;
        const imgCurrent = document.getElementById("imgCurrent");

        if (fileInput.files && fileInput.files[0]) {
            const reader = new FileReader();

            reader.onload = function (e) {
                imgCurrent.src = e.target.result;
                imgCurrent.classList.remove("grayscale");
            };

            reader.readAsDataURL(fileInput.files[0]);
        }
    }
</script>



