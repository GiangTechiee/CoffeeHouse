@using CoffeeHouse.ViewModels
@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<ProductViewModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Cargo Inventory";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-10 animate-fade-in">
    <!-- Page Header: Mission Control Briefing -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 rounded-[48px] border border-border/50 shadow-2xl flex flex-col xl:flex-row xl:items-center justify-between gap-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-16 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary">
            CARGO
        </div>
        
        <div class="relative z-10 space-y-2">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Operational Log</span>
            <h1 class="text-5xl font-black text-secondary tracking-tighter italic">Bản kê <span class="text-primary not-italic">Sản phẩm</span></h1>
            <p class="text-[10px] font-black uppercase tracking-widest text-text-light">Current inventory status across all galactic sectors.</p>
        </div>

        <div class="relative z-10 flex flex-col md:flex-row items-center gap-6">
            <div class="relative group/search w-full md:w-[400px]">
                @using (Html.BeginForm("Search", "HomeAdmin", FormMethod.Get, new { @class = "flex-1" }))
                {
                    <input type="text" name="search" placeholder="Quét mã định danh hoặc tên sản phẩm..." 
                           class="w-full pl-14 pr-6 py-5 bg-surface-soft border border-border/50 rounded-3xl text-[10px] font-black uppercase tracking-widest outline-none focus:ring-4 focus:ring-primary/10 focus:border-primary focus:bg-white transition-all shadow-inner">
                    <i class="fa fa-search absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/search:text-primary transition-colors text-xs"></i>
                }
            </div>
            
            <a asp-action="Create" class="w-full md:w-auto btn-primary h-[60px] !rounded-3xl px-8 flex items-center justify-center gap-4 group/btn shadow-xl shadow-primary/20">
                <span class="text-[10px] font-black uppercase tracking-widest">Khai báo sản phẩm mới</span>
                <i class="fas fa-plus-circle group-hover:rotate-90 transition-transform"></i>
            </a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="bg-emerald-50 text-emerald-700 px-8 py-5 rounded-3xl border border-emerald-100 flex items-center gap-4 animate-scale-in">
            <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex-center shadow-lg shadow-emerald-500/20">
                <i class="fas fa-check"></i>
            </div>
            <span class="text-[10px] font-black uppercase tracking-[0.2em]">@TempData["Message"]</span>
        </div>
    }

    <!-- Inventory Table: Status Terminal -->
    <div class="bg-white/70 backdrop-blur-2xl rounded-[56px] border border-border/50 shadow-2xl overflow-hidden group">
        <div class="overflow-x-auto overflow-y-hidden custom-scrollbar">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-secondary text-white">
                        <th class="px-10 py-8 text-[10px] font-black uppercase tracking-[0.3em]">ID</th>
                        <th class="px-10 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Cargo Information</th>
                        <th class="px-10 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Sector</th>
                        <th class="px-10 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Budget</th>
                        <th class="px-10 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Intel</th>
                        <th class="px-10 py-8 text-[10px] font-black uppercase tracking-[0.3em] text-center">Operations</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border/30">
                    @foreach (var (item, index) in Model.Select((v, i) => (v, i)))
                    {
                        <tr class="group/row hover:bg-surface-soft/50 transition-colors duration-500 @(index % 2 != 0 ? "bg-surface-soft/20" : "")">
                            <td class="px-10 py-8">
                                <span class="text-[10px] font-black text-text-light font-mono bg-surface-soft px-3 py-1 rounded-lg border border-border/50">#@item.ProductId</span>
                            </td>
                            <td class="px-10 py-8">
                                <div class="flex items-center gap-6">
                                    <div class="relative w-20 h-20 rounded-2xl overflow-hidden bg-surface-soft border border-border/50 shadow-inner group-hover/row:scale-110 transition-transform duration-700">
                                        <img src="@Url.Content("~/img/products/" + item.ImageUrl)" class="w-full h-full object-cover grayscale group-hover/row:grayscale-0 transition-all duration-700">
                                    </div>
                                    <div>
                                        <p class="text-base font-black text-secondary tracking-tight italic group-hover/row:text-primary transition-colors">@item.ProductName</p>
                                        <p class="text-[8px] font-black uppercase tracking-[0.3em] text-text-light mt-1">Verified Payload</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-10 py-8">
                                <span class="px-4 py-1.5 rounded-lg bg-secondary text-white text-[8px] font-black uppercase tracking-widest shadow-lg shadow-black/10">Sector: @item.CategoryName</span>
                            </td>
                            <td class="px-10 py-8">
                                <p class="text-xl font-black text-primary tracking-tighter italic">@(item.Price?.ToString("n0") ?? "0") <span class="text-[10px] not-italic ml-1">đ</span></p>
                            </td>
                            <td class="px-10 py-8">
                                <p class="text-[10px] font-black text-text-muted leading-relaxed line-clamp-1 max-w-[200px]">@item.Description</p>
                            </td>
                            <td class="px-10 py-8">
                                <div class="flex items-center justify-center gap-3">
                                    <a asp-action="Details" asp-route-id="@item.ProductId" asp-route-name="@item.ProductName" 
                                       class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-secondary hover:text-white transition-all shadow-sm hover:shadow-lg hover:-translate-y-1">
                                        <i class="fas fa-eye text-xs"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.ProductId" asp-route-name="@item.ProductName" 
                                       class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-emerald-500 hover:text-white transition-all shadow-sm hover:shadow-lg hover:-translate-y-1">
                                        <i class="fas fa-edit text-xs"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ProductId" 
                                       class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-rose-500 hover:text-white transition-all shadow-sm hover:shadow-lg hover:-translate-y-1">
                                        <i class="fas fa-trash-alt text-xs"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Terminal -->
        <div class="px-10 py-10 bg-surface-soft/50 border-t border-border/30 flex justify-center">
            @Html.PagedListPager(Model, page => Url.Action("index", new { page = page }), new PagedListRenderOptions()
            {
                MaximumPageNumbersToDisplay = 5,
                LiElementClasses = new List<String> { "" },
                PageClasses = new List<String> { "w-14 h-14 flex items-center justify-center rounded-2xl border border-border/50 text-[10px] font-black uppercase tracking-widest transition-all hover:bg-primary hover:text-white hover:border-primary bg-white mx-1.5 shadow-sm hover:shadow-xl hover:-translate-y-1" },
                UlElementClasses = new List<String> { "flex items-center" },
                ActiveLiElementClass = "[&_a]:bg-primary [&_a]:text-white [&_a]:border-primary [&_a]:shadow-xl [&_a]:shadow-primary/20",
            })
        </div>
    </div>
</div>




