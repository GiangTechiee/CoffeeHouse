@model CoffeeHouse.Domain.Entities.Supplier
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Merchant Dossier";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-5xl mx-auto space-y-12 animate-fade-in">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.3em] text-text-light">
        <a asp-action="Index" class="hover:text-primary transition-colors">Merchant Registry</a>
        <i class="fas fa-chevron-right text-[8px]"></i>
        <span class="text-secondary italic">Partner Dossier</span>
    </nav>

    <!-- Header: Diplomatic Profile -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 rounded-[48px] border border-border/50 shadow-2xl relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-16 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary transition-opacity group-hover:opacity-[0.05]">
            DOSSIER
        </div>
        <div class="relative z-10 flex flex-col md:flex-row md:items-center gap-10">
            <div class="w-32 h-32 rounded-[40px] bg-secondary text-white flex-center text-4xl shadow-2xl shadow-secondary/30 relative">
                <i class="fas fa-building"></i>
                <div class="absolute -bottom-2 -right-2 w-10 h-10 rounded-2xl bg-emerald-500 border-4 border-white flex-center text-white text-[10px]">
                    <i class="fas fa-check"></i>
                </div>
            </div>
            <div class="space-y-4">
                <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Alliance Intelligence</span>
                <h1 class="text-5xl font-black text-secondary tracking-tighter italic leading-tight">@Model.SupplierName</h1>
                <div class="flex flex-wrap items-center gap-6">
                    <span class="px-4 py-1.5 rounded-lg bg-surface-soft text-[9px] font-black uppercase tracking-widest border border-border/50 shadow-inner">SUP_ID: #SUP-@Model.SupplierId.ToString("D3")</span>
                    <span class="text-[10px] font-black text-text-light uppercase italic">Verified Trade Partner</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Matrix -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <!-- Logistics Info -->
        <div class="bg-white/70 backdrop-blur-2xl p-10 rounded-[56px] border border-border/50 shadow-2xl space-y-10 relative overflow-hidden">
             <div class="flex items-center gap-6">
                <span class="w-10 h-10 rounded-2xl bg-secondary text-white flex-center text-[10px] font-black italic shadow-lg shadow-secondary/20">LOGI</span>
                <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary">Logistics Parameters</h3>
                <div class="h-px bg-border/50 flex-1"></div>
            </div>

            <div class="space-y-8">
                <div class="space-y-2">
                    <span class="text-[9px] font-black uppercase tracking-[0.2em] text-text-muted">Sector Coordinates</span>
                    <p class="text-xl font-black text-secondary tracking-tight">@Model.Address</p>
                </div>
                <div class="space-y-2">
                    <span class="text-[9px] font-black uppercase tracking-[0.2em] text-text-muted">Comm Link Frequency</span>
                    <p class="text-2xl font-black text-emerald-600 font-mono tracking-tighter">@Model.PhoneNumber</p>
                </div>
            </div>
        </div>

        <!-- Financial Info -->
        <div class="bg-white/70 backdrop-blur-2xl p-10 rounded-[56px] border border-border/50 shadow-2xl space-y-10 relative overflow-hidden">
             <div class="flex items-center gap-6">
                <span class="w-10 h-10 rounded-2xl bg-secondary text-white flex-center text-[10px] font-black italic shadow-lg shadow-secondary/20">CRED</span>
                <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary">Economic Interface</h3>
                <div class="h-px bg-border/50 flex-1"></div>
            </div>

            <div class="space-y-8">
                <div class="space-y-2">
                    <span class="text-[9px] font-black uppercase tracking-[0.2em] text-text-muted">Guild Credit Vault</span>
                    <div class="flex items-center gap-4 p-6 bg-surface-soft rounded-[32px] border border-border/50 shadow-inner">
                        <i class="fas fa-credit-card text-2xl text-secondary/30"></i>
                        <p class="text-2xl font-black text-secondary font-mono tracking-tight">@Model.Stk</p>
                    </div>
                </div>
                <div class="space-y-2">
                    <span class="text-[9px] font-black uppercase tracking-[0.2em] text-text-muted">Interface Compliance</span>
                    <div class="flex items-center gap-3">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <p class="text-[10px] font-black text-emerald-600 uppercase tracking-widest">Financial Gateway Active</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Execution Strategy -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between border-t border-border/50 gap-8">
        <p class="text-[8px] font-black uppercase tracking-[0.3em] text-text-light italic max-w-sm">Merchant intelligence archived in Diplomatic Sector 9. Unauthorized data scraping is prohibited.</p>
        <div class="flex items-center gap-4 w-full sm:w-auto">
            <a asp-action="Edit" asp-route-id="@Model.SupplierId" class="flex-1 sm:flex-none h-16 px-10 bg-surface-soft text-text-muted rounded-[24px] text-[10px] font-black uppercase tracking-widest hover:bg-secondary hover:text-white transition-all flex items-center justify-center gap-4 border border-border/50 shadow-sm transition-all hover:shadow-xl group">
                <i class="fas fa-sliders-h transition-transform group-hover:rotate-90"></i> 
                Modify Alliance
            </a>
            <a asp-action="Index" class="flex-1 sm:flex-none h-16 px-10 bg-secondary text-white rounded-[24px] text-[10px] font-black uppercase tracking-widest hover:bg-primary transition-all flex items-center justify-center gap-4 shadow-xl shadow-secondary/20 hover:shadow-primary/30 group">
                <i class="fas fa-chevron-left transition-transform group-hover:-translate-x-2"></i> 
                Return to Registry
            </a>
        </div>
    </div>
</div>



