@model CoffeeHouse.ViewModels.ThuChiDetailViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Fiscal Breakdown";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-12 animate-fade-in">
    <!-- Page Header: Intelligence Report -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 rounded-[48px] border border-border/50 shadow-2xl flex flex-col xl:flex-row xl:items-center justify-between gap-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-16 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary">
            INTEL
        </div>
        
        <div class="relative z-10 space-y-2">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Operational Analysis</span>
            <h1 class="text-5xl font-black text-secondary tracking-tighter italic">Chi tiết <span class="text-primary not-italic">Thu – Chi</span></h1>
            <p class="text-[10px] font-black uppercase tracking-widest text-text-light">Granular fiscal telemetry for Hub #@Model.CafeId | @Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")</p>
        </div>

        <div class="relative z-10">
            <a asp-action="All" class="btn-primary h-14 !rounded-2xl px-10 flex items-center justify-center gap-4 group/btn shadow-xl shadow-primary/20">
                <i class="fas fa-chevron-left text-[10px] group-hover/btn:-translate-x-1 transition-transform"></i>
                <span class="text-[10px] font-black uppercase tracking-widest">Return to Command</span>
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-1 gap-12">
        <!-- Personnel Budget: Employee Payroll -->
        <div class="bg-white/70 backdrop-blur-2xl rounded-[56px] border border-border/50 shadow-2xl overflow-hidden group">
            <div class="px-10 py-8 border-b border-border/30 flex items-center justify-between">
                <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-secondary flex items-center gap-4">
                    <i class="fas fa-users-cog text-primary"></i> Personnel Payroll Matrix
                </h3>
            </div>
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-soft text-secondary">
                            <th class="px-10 py-6 text-[9px] font-black uppercase tracking-widest">Personnel ID</th>
                            <th class="px-10 py-6 text-[9px] font-black uppercase tracking-widest">FullName</th>
                            <th class="px-10 py-6 text-[9px] font-black uppercase tracking-widest text-right">Base Allocation</th>
                            <th class="px-10 py-6 text-[9px] font-black uppercase tracking-widest text-right">Perf Coeff</th>
                            <th class="px-10 py-6 text-[9px] font-black uppercase tracking-widest text-right">Net Compensation</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border/30">
                        @foreach (var nv in Model.Employees)
                        {
                            var luongThucNhan = nv.BaseSalary * nv.SalaryCoefficient;
                            <tr class="hover:bg-surface-soft/30 transition-colors">
                                <td class="px-10 py-6 text-[9px] font-mono font-black text-text-light">#ST-@nv.EmployeeId.ToString("D3")</td>
                                <td class="px-10 py-6 text-sm font-black text-secondary italic">@nv.FullName</td>
                                <td class="px-10 py-6 text-right font-black text-secondary tracking-tighter">@nv.BaseSalary.ToString("n0") đ</td>
                                <td class="px-10 py-6 text-right">
                                    <span class="px-3 py-1 rounded-lg bg-primary/10 text-primary text-[10px] font-black">x @nv.SalaryCoefficient.ToString("N2")</span>
                                </td>
                                <td class="px-10 py-6 text-right">
                                    <p class="text-base font-black text-secondary italic tracking-tighter">@luongThucNhan.ToString("n0") <span class="text-[8px] not-italic ml-0.5">đ</span></p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Revenue Streams: Commerce Manifests -->
        <div class="bg-white/70 backdrop-blur-2xl rounded-[56px] border border-border/50 shadow-2xl overflow-hidden group">
            <div class="px-10 py-8 border-b border-border/30 flex items-center justify-between">
                <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-secondary flex items-center gap-4">
                    <i class="fas fa-file-invoice-dollar text-primary"></i> Commerce Manifest Logs
                </h3>
            </div>
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-soft text-secondary">
                            <th class="px-10 py-6 text-[9px] font-black uppercase tracking-widest">Manifest_UID</th>
                            <th class="px-10 py-6 text-[9px] font-black uppercase tracking-widest">Arrival Date</th>
                            <th class="px-10 py-6 text-[9px] font-black uppercase tracking-widest">Protocol Status</th>
                            <th class="px-10 py-6 text-[9px] font-black uppercase tracking-widest text-right">Credit Value</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border/30">
                        @foreach (var hd in Model.Invoices)
                        {
                            <tr class="hover:bg-surface-soft/30 transition-colors">
                                <td class="px-10 py-6 text-[9px] font-mono font-black text-text-light">#HD-@hd.OrderId.ToString("D4")</td>
                                <td class="px-10 py-6 text-sm font-black text-secondary italic">@hd.OrderDate.ToString("dd/MM/yyyy")</td>
                                <td class="px-10 py-6">
                                    <span class="px-3 py-1 rounded-lg bg-emerald-50 text-emerald-600 border border-emerald-100 text-[8px] font-black uppercase tracking-widest">@hd.Status</span>
                                </td>
                                <td class="px-10 py-6 text-right">
                                    <p class="text-base font-black text-emerald-500 italic tracking-tighter">+@hd.TotalAmount.ToString("n0") <span class="text-[8px] not-italic ml-0.5">đ</span></p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Procurement Costs: Supply Chain Expenditures -->
        <div class="bg-white/70 backdrop-blur-2xl rounded-[56px] border border-border/50 shadow-2xl overflow-hidden group">
            <div class="px-10 py-8 border-b border-border/30 flex items-center justify-between">
                <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-secondary flex items-center gap-4">
                    <i class="fas fa-shuttle-van text-primary"></i> Supply Procurement Logs
                </h3>
            </div>
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-soft text-secondary">
                            <th class="px-10 py-6 text-[9px] font-black uppercase tracking-widest">Asset_ID</th>
                            <th class="px-10 py-6 text-[9px] font-black uppercase tracking-widest">Loading Date</th>
                            <th class="px-10 py-6 text-[9px] font-black uppercase tracking-widest">Merchant Guild</th>
                            <th class="px-10 py-6 text-[9px] font-black uppercase tracking-widest text-right">Expenditure</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border/30">
                        @foreach (var pn in Model.PhieuNhapHangs)
                        {
                            var totalPhieuNhap = pn.PurchaseOrderItems != null
                            ? pn.PurchaseOrderItems.Sum(ct => ct.Quantity * ct.UnitPrice)
                            : 0;
                            <tr class="hover:bg-surface-soft/30 transition-colors">
                                <td class="px-10 py-6 text-[9px] font-mono font-black text-text-light">#PN-@pn.PurchaseOrderId.ToString("D3")</td>
                                <td class="px-10 py-6 text-sm font-black text-secondary italic">@pn.OrderDate.ToString("dd/MM/yyyy")</td>
                                <td class="px-10 py-6 text-[10px] font-bold text-text-muted italic">@(pn.Supplier?.SupplierName ?? "Unknown Dealer")</td>
                                <td class="px-10 py-6 text-right">
                                    <p class="text-base font-black text-rose-500 italic tracking-tighter">-@totalPhieuNhap.ToString("n0") <span class="text-[8px] not-italic ml-0.5">đ</span></p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>



