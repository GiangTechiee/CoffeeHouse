@model CoffeeHouse.ViewModels.AllThuChiViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Fiscal Matrix Central";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-10 animate-fade-in">
    <!-- Page Header: Strategic Fiscal Monitoring -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 rounded-[48px] border border-border/50 shadow-2xl flex flex-col xl:flex-row xl:items-center justify-between gap-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-16 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary">
            FISCAL
        </div>
        
        <div class="relative z-10 space-y-2">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Financial Command</span>
            <h1 class="text-5xl font-black text-secondary tracking-tighter italic">Quản lý <span class="text-primary not-italic">Thu – Chi</span></h1>
            <p class="text-[10px] font-black uppercase tracking-widest text-text-light">Aggregated economic logs for all operational hubs.</p>
        </div>

        <div class="relative z-10 flex flex-col md:flex-row items-center gap-6">
            <form asp-area="Admin" asp-controller="ThuChi" asp-action="All" method="post" class="flex flex-col md:flex-row items-center gap-4">
                <div class="flex items-center gap-3">
                    <div class="relative group/input">
                        <label class="absolute -top-6 left-4 text-[8px] font-black uppercase tracking-widest text-text-light group-focus-within/input:text-primary">Stardate START</label>
                        <input type="date" asp-for="StartDate" class="h-14 pl-6 pr-6 bg-surface-soft border border-border/50 rounded-2xl text-[10px] font-black uppercase tracking-widest outline-none focus:ring-4 focus:ring-primary/10 focus:border-primary focus:bg-white transition-all shadow-inner" required />
                    </div>
                    <div class="w-4 h-px bg-border/50"></div>
                    <div class="relative group/input">
                        <label class="absolute -top-6 left-4 text-[8px] font-black uppercase tracking-widest text-text-light group-focus-within/input:text-primary">Stardate END</label>
                        <input type="date" asp-for="EndDate" class="h-14 pl-6 pr-6 bg-surface-soft border border-border/50 rounded-2xl text-[10px] font-black uppercase tracking-widest outline-none focus:ring-4 focus:ring-primary/10 focus:border-primary focus:bg-white transition-all shadow-inner" required />
                    </div>
                </div>
                <button type="submit" class="btn-primary h-14 !rounded-2xl px-8 flex items-center justify-center gap-3 shadow-xl shadow-primary/20">
                    <span class="text-[10px] font-black uppercase tracking-widest">Execute Scan</span>
                    <i class="fas fa-filter text-[10px]"></i>
                </button>
                <a asp-area="Admin" asp-controller="ThuChi" asp-action="All" class="h-14 !rounded-2xl px-8 flex items-center justify-center bg-surface-soft text-text-muted hover:bg-secondary hover:text-white transition-all text-[10px] font-black uppercase tracking-widest border border-border/50">
                    Reset Sync
                </a>
            </form>
        </div>
    </div>

    <!-- Fiscal Matrix -->
    <div class="bg-white/70 backdrop-blur-2xl rounded-[56px] border border-border/50 shadow-2xl overflow-hidden group">
        @if (Model.Items == null || !Model.Items.Any())
        {
            <div class="p-32 text-center">
                <i class="fas fa-coins text-4xl text-text-light/20 mb-6 block"></i>
                <p class="text-[10px] font-black uppercase tracking-[.4em] text-text-light italic">No financial signatures detected for this timeframe</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-secondary text-white">
                            <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em] w-16 text-center">Hub_ID</th>
                            <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Operational Terminal</th>
                            <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Total Revenue</th>
                            <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Supply Expenditures</th>
                            <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Net Profit Margin</th>
                            <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em] text-center">Intel</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border/30">
                        @foreach (var (item, index) in Model.Items.Select((v, i) => (v, i)))
                        {
                            <tr class="group/row hover:bg-surface-soft/50 transition-colors duration-500 @(index % 2 != 0 ? "bg-surface-soft/20" : "")">
                                <td class="px-8 py-8 text-center">
                                    <span class="text-[10px] font-black text-text-light font-mono bg-surface-soft px-3 py-1 rounded-lg border border-border/50">#Q-@item.StoreId.ToString("D2")</span>
                                </td>
                                <td class="px-8 py-8">
                                    <p class="text-base font-black text-secondary tracking-tight italic group-hover/row:text-primary transition-colors">@item.StoreName</p>
                                </td>
                                <td class="px-8 py-8">
                                    <p class="text-lg font-black text-emerald-500 italic tracking-tighter">+@item.TotalRevenue.ToString("n0") <span class="text-[8px] not-italic ml-1">đ</span></p>
                                </td>
                                <td class="px-8 py-8">
                                    <p class="text-lg font-black text-rose-500 italic tracking-tighter">-@item.TotalImport.ToString("n0") <span class="text-[8px] not-italic ml-1">đ</span></p>
                                </td>
                                <td class="px-8 py-8">
                                    <div class="inline-flex items-center px-4 py-2 rounded-xl @(item.Profit >= 0 ? "bg-emerald-50 text-emerald-600 border border-emerald-100" : "bg-rose-50 text-rose-600 border border-rose-100")">
                                        <p class="text-lg font-black italic tracking-tighter">@item.Profit.ToString("n0") <span class="text-[8px] not-italic ml-1">đ</span></p>
                                    </div>
                                </td>
                                <td class="px-8 py-8">
                                    <div class="flex items-center justify-center">
                                        <a asp-action="AllDetail"
                                           asp-route-maQuan="@item.StoreId"
                                           asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
                                           asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
                                           class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-primary hover:text-white transition-all shadow-sm hover:shadow-lg">
                                            <i class="fas fa-chart-line text-xs"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

