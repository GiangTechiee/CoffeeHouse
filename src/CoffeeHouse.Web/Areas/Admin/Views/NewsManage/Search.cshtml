@using CoffeeHouse.Domain.Entities
@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<NewsArticle>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Signal Search Results";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-10 animate-fade-in">
    <!-- Page Header: Strategic Search -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 rounded-[48px] border border-border/50 shadow-2xl flex flex-col xl:flex-row xl:items-center justify-between gap-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-16 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary">
            SEARCH
        </div>

        <div class="relative z-10 space-y-2">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Deep Signal Scan</span>
            <h1 class="text-5xl font-black text-secondary tracking-tighter italic wrap">Kết quả: <span class="text-primary not-italic capitalize">@ViewBag.search</span></h1>
            <p class="text-[10px] font-black uppercase tracking-widest text-text-light">Filtering the galactic newsstream for specific frequency signatures.</p>
        </div>

        <div class="relative z-10 flex flex-col md:flex-row items-center gap-6">
            <div class="relative group/search w-full md:w-[320px]">
                @using (Html.BeginForm("Search", "NewsManage", FormMethod.Get, new { @class = "flex-1" }))
                {
                    <input type="text" name="search" placeholder="Scanning signals..." value="@ViewBag.search"
                           class="w-full pl-14 pr-14 py-5 bg-surface-soft border border-border/50 rounded-3xl text-[10px] font-black uppercase tracking-widest outline-none focus:ring-4 focus:ring-primary/10 focus:border-primary focus:bg-white transition-all shadow-inner">
                    <i class="fas fa-satellite-dish absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/search:text-primary transition-colors text-xs"></i>
                    <button type="submit" class="absolute right-6 top-1/2 -translate-y-1/2 text-primary hover:scale-110 transition-transform">
                        <i class="fas fa-search"></i>
                    </button>
                }
            </div>
            
            <a asp-action="Index" class="flex items-center gap-4 text-[10px] font-black uppercase tracking-widest text-text-muted hover:text-secondary transition-all group">
                <i class="fas fa-arrow-left transition-transform group-hover:-translate-x-2"></i>
                Reset Feed
            </a>
        </div>
    </div>

    <!-- Results Table: Frequency Matrix -->
    <div class="bg-white/70 backdrop-blur-2xl rounded-[56px] border border-border/50 shadow-2xl overflow-hidden group">
        <div class="overflow-x-auto custom-scrollbar">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-secondary text-white">
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em] w-16 text-center">SIG_ID</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Broadcast Headline</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Relay Timestamp</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em] text-center">Protocol Integrity</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em] text-center">Operations</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border/30">
                    @if (Model.Any())
                    {
                        @foreach (var (item, index) in Model.Select((v, i) => (v, i)))
                        {
                            <tr class="group/row hover:bg-surface-soft/50 transition-colors duration-500 @(index % 2 != 0 ? "bg-surface-soft/20" : "")">
                                <td class="px-8 py-8 text-center">
                                    <span class="text-[9px] font-black text-text-light font-mono bg-surface-soft px-3 py-1 rounded-lg border border-border/50">#NW-@item.ArticleId.ToString("D3")</span>
                                </td>
                                <td class="px-8 py-8">
                                    <div class="flex items-center gap-6">
                                        <div class="w-12 h-12 rounded-2xl bg-surface-soft text-secondary flex-center border border-border/50 group-hover/row:bg-primary group-hover/row:text-white transition-all shadow-sm">
                                            <i class="fas fa-rss text-xs"></i>
                                        </div>
                                        <p class="text-base font-black text-secondary tracking-tight italic group-hover/row:text-primary transition-colors max-w-md truncate">@item.Title</p>
                                    </div>
                                </td>
                                <td class="px-8 py-8">
                                    <div class="flex flex-col gap-1">
                                        <span class="text-[10px] font-black text-secondary tracking-widest uppercase">@item.PublishedAt.ToString("dd/MM/yyyy")</span>
                                        <span class="text-[8px] font-black text-text-light uppercase italic">Live Broadcast</span>
                                    </div>
                                </td>
                                <td class="px-8 py-8">
                                    <div class="flex items-center justify-center gap-3">
                                        <span class="px-4 py-1.5 rounded-lg bg-emerald-500/10 text-emerald-600 text-[8px] font-black uppercase tracking-widest border border-emerald-500/20">Sync Level: High</span>
                                    </div>
                                </td>
                                <td class="px-8 py-8">
                                    <div class="flex items-center justify-center gap-3">
                                        <a asp-action="Details" asp-route-id="@item.ArticleId" asp-route-name="@item.Title" 
                                           class="w-10 h-10 flex-center rounded-xl bg-surface-soft text-text-muted hover:bg-primary hover:text-white transition-all shadow-sm hover:shadow-lg">
                                            <i class="fas fa-play text-[10px]"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.ArticleId" asp-route-name="@item.Title" 
                                           class="w-10 h-10 flex-center rounded-xl bg-surface-soft text-text-muted hover:bg-secondary hover:text-white transition-all shadow-sm hover:shadow-lg">
                                            <i class="fas fa-sliders-h text-[10px]"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ArticleId" 
                                           class="w-10 h-10 flex-center rounded-xl bg-surface-soft text-text-muted hover:bg-rose-500 hover:text-white transition-all shadow-sm hover:shadow-lg">
                                            <i class="fas fa-unlink text-[10px]"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="p-32 text-center space-y-8">
                                <div class="w-32 h-32 rounded-[40px] bg-surface-soft text-text-muted flex-center text-4xl mx-auto shadow-inner border border-border/50 animate-pulse">
                                    <i class="fas fa-satellite-dish"></i>
                                </div>
                                <div class="space-y-2">
                                    <h4 class="text-2xl font-black text-secondary italic tracking-tight">Signal Lost</h4>
                                    <p class="text-[10px] font-black uppercase tracking-widest text-text-light">No broadcasts matching the frequency signature <span class="text-primary">"@ViewBag.search"</span> were found in the archive.</p>
                                </div>
                                <a asp-action="Index" class="inline-flex h-16 items-center gap-4 px-10 bg-secondary text-white rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-primary transition-all shadow-xl shadow-secondary/20 group">
                                    <i class="fas fa-redo transition-transform group-hover:rotate-180"></i>
                                    Refresh Comms Relay
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Matrix Pagination -->
        @if (Model.Any())
        {
            <div class="px-12 py-10 bg-surface-soft/50 border-t border-border/30 flex justify-center">
                @Html.PagedListPager(Model, page => Url.Action("search", new { page = page, search = ViewBag.search }), new PagedListRenderOptions()
                {
                    MaximumPageNumbersToDisplay = 5,
                    LiElementClasses = new List<string> { "" },
                    PageClasses = new List<string> { "w-14 h-14 flex items-center justify-center rounded-2xl border border-border/50 text-[10px] font-black uppercase tracking-widest transition-all hover:bg-primary hover:text-white hover:border-primary bg-white mx-1.5 shadow-sm hover:shadow-xl hover:-translate-y-1" },
                    UlElementClasses = new List<string> { "flex items-center" },
                    ActiveLiElementClass = "[&_a]:bg-primary [&_a]:text-white [&_a]:border-primary [&_a]:shadow-xl [&_a]:shadow-primary/20",
                })
            </div>
        }
    </div>
</div>

