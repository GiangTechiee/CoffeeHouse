@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var role = Context.Session.GetString("Role");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Space Command Hub</title>
    <link rel="shortcut icon" href="~/favicon.ico" />

    <!-- Fonts -->
    <link rel="stylesheet" type="text/css" href="~/css/style-font.css" />

    <!-- Core UI - Tailwind CSS (Unified) -->
    <link rel="stylesheet" href="~/css/tailwind.css" type="text/css" asp-append-version="true">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" type="text/css" />

    <!-- Legacy Plugin Support -->
    <link rel="stylesheet" href="~/lib/magnific-popup/dist/magnific-popup.css" type="text/css" />
</head>
<body class="bg-surface-dark text-secondary antialiased font-sans overflow-x-hidden">
    <!-- Admin Navbar: Glassmorphism Mission Control -->
    <nav class="fixed top-0 left-0 right-0 h-20 bg-white/80 backdrop-blur-2xl border-b border-border/50 z-[100] flex items-center px-8 shadow-xl shadow-black/[0.02]">
        <div class="flex items-center justify-between w-full">
            <div class="flex items-center gap-6">
                <button id="sidebarToggle" class="lg:hidden w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:text-primary hover:bg-white transition-all shadow-sm">
                    <i class="fas fa-bars"></i>
                </button>
                <a asp-controller="homeadmin" asp-action="index" class="flex items-center gap-4 group/logo">
                    <div class="w-10 h-10 bg-secondary rounded-xl flex-center text-white transform transition-all duration-500 group-hover/logo:rotate-[15deg] group-hover/logo:bg-primary shadow-lg shadow-secondary/20">
                        <i class="fas fa-rocket text-sm"></i>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-sm font-black tracking-tighter text-secondary italic leading-none group-hover/logo:text-primary transition-colors">SPACE <span class="text-primary not-italic">COMMAND</span></span>
                        <span class="text-[8px] font-black uppercase tracking-[0.3em] text-text-light mt-1">Management Hub v4.0</span>
                    </div>
                </a>
            </div>
            
            <div class="flex items-center gap-8">
                <!-- System Pulse -->
                <div class="hidden md:flex items-center gap-4 px-6 py-2.5 bg-surface-soft rounded-2xl border border-border/50 shadow-inner group/status">
                    <div class="relative w-2 h-2">
                        <div class="absolute inset-0 rounded-full bg-emerald-500 animate-ping opacity-75"></div>
                        <div class="relative w-2 h-2 rounded-full bg-emerald-500"></div>
                    </div>
                    <span class="text-[9px] font-black text-secondary tracking-widest uppercase">System: Operational</span>
                </div>
                
                <div class="h-10 w-px bg-border/50"></div>
                
                <!-- Profile Summary -->
                <div class="flex items-center gap-4">
                    <div class="text-right hidden sm:block">
                        <p class="text-[10px] font-black text-secondary leading-none">@Context.Session.GetString("Username")</p>
                        <p class="text-[8px] font-black text-primary uppercase tracking-widest mt-1">@role</p>
                    </div>
                    <div class="relative group">
                        <div class="w-12 h-12 rounded-2xl bg-secondary text-white flex-center shadow-lg hover:rotate-6 hover:scale-105 transition-all duration-500">
                            <i class="fas fa-user-shield"></i>
                        </div>
                        
                        <!-- Dropdown (Simple for now, can be expanded) -->
                        <div class="absolute right-0 top-full mt-4 w-56 bg-white rounded-3xl shadow-2xl border border-border/50 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50 overflow-hidden">
                            <div class="p-4 border-b border-border/50 bg-surface-soft/50">
                                <p class="text-[10px] font-black uppercase tracking-widest text-text-light">Access Token Active</p>
                            </div>
                            <div class="p-3">
                                <a asp-controller="auth" asp-action="logout" class="flex items-center gap-4 px-4 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest text-rose-500 hover:bg-rose-50 transition-all">
                                    <i class="fas fa-sign-out-alt"></i>
                                    Terminate Session
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Admin Sidebar: Galactic Navigation -->
    <aside id="adminSidebar" class="fixed top-20 left-0 bottom-0 w-[280px] bg-white border-r border-border/30 z-[90] overflow-y-auto custom-scrollbar transition-transform duration-500 ease-out transform lg:translate-x-0 -translate-x-full">
        <div class="py-10 px-8">
            <div class="mb-10 flex items-center gap-4">
                <div class="w-1.5 h-6 bg-primary rounded-full"></div>
                <span class="text-[10px] font-black text-secondary uppercase tracking-[0.4em] italic">Main Command</span>
            </div>
            
            <nav class="space-y-2">
                <a asp-controller="HomeAdmin" asp-action="Index" class="nav-link-admin group">
                    <div class="w-10 h-10 rounded-xl bg-surface-soft flex-center group-hover:bg-primary group-hover:text-white transition-all shadow-sm">
                        <i class="fas fa-cubes text-xs"></i>
                    </div>
                    <span>Inventory Logs</span>
                </a>
                
                <a asp-controller="GroupsProduct" asp-action="Index" class="nav-link-admin group">
                    <div class="w-10 h-10 rounded-xl bg-surface-soft flex-center group-hover:bg-primary group-hover:text-white transition-all shadow-sm">
                        <i class="fas fa-th-large text-xs"></i>
                    </div>
                    <span>Cargo Sectors</span>
                </a>
                
                <a asp-controller="NguyenLieus" asp-action="Index" class="nav-link-admin group">
                    <div class="w-10 h-10 rounded-xl bg-surface-soft flex-center group-hover:bg-primary group-hover:text-white transition-all shadow-sm">
                        <i class="fas fa-flask text-xs"></i>
                    </div>
                    <span>Raw Elements</span>
                </a>

                @if (role != "Employee")
                {
                    <div class="pt-8 mb-4 flex items-center gap-4">
                        <div class="w-1.5 h-6 bg-secondary rounded-full"></div>
                        <span class="text-[10px] font-black text-secondary uppercase tracking-[0.4em] italic">Finance Control</span>
                    </div>
                    
                    <a asp-controller="ThuChi" asp-action="All" class="nav-link-admin group">
                        <div class="w-10 h-10 rounded-xl bg-surface-soft flex-center group-hover:bg-secondary group-hover:text-white transition-all shadow-sm">
                            <i class="fas fa-chart-pie text-xs"></i>
                        </div>
                        <span>Fiscal Ledger</span>
                    </a>
                }

                <div class="pt-8 mb-4 flex items-center gap-4">
                    <div class="w-1.5 h-6 bg-secondary rounded-full"></div>
                    <span class="text-[10px] font-black text-secondary uppercase tracking-[0.4em] italic">Operations</span>
                </div>

                <a asp-controller="Bill" asp-action="Index" class="nav-link-admin group">
                    <div class="w-10 h-10 rounded-xl bg-surface-soft flex-center group-hover:bg-secondary group-hover:text-white transition-all shadow-sm">
                        <i class="fas fa-file-invoice-dollar text-xs"></i>
                    </div>
                    <span>Manifests</span>
                </a>

                <a asp-controller="PhieuNhapHang" asp-action="Index" class="nav-link-admin group">
                    <div class="w-10 h-10 rounded-xl bg-surface-soft flex-center group-hover:bg-secondary group-hover:text-white transition-all shadow-sm">
                        <i class="fas fa-dolly-flatbed text-xs"></i>
                    </div>
                    <span>Supply Drops</span>
                </a>

                @if (role != "Employee")
                {
                    <a asp-controller="NhaCungCap" asp-action="Index" class="nav-link-admin group">
                        <div class="w-10 h-10 rounded-xl bg-surface-soft flex-center group-hover:bg-secondary group-hover:text-white transition-all shadow-sm">
                            <i class="fas fa-broadcast-tower text-xs"></i>
                        </div>
                        <span>Vendors</span>
                    </a>
                    
                    <a asp-controller="Clients" asp-action="Index" class="nav-link-admin group">
                        <div class="w-10 h-10 rounded-xl bg-surface-soft flex-center group-hover:bg-secondary group-hover:text-white transition-all shadow-sm">
                            <i class="fas fa-user-astronaut text-xs"></i>
                        </div>
                        <span>Pilots (Clients)</span>
                    </a>
                    
                    <a asp-controller="NhanViens" asp-action="Index" class="nav-link-admin group">
                        <div class="w-10 h-10 rounded-xl bg-surface-soft flex-center group-hover:bg-secondary group-hover:text-white transition-all shadow-sm">
                            <i class="fas fa-id-card-alt text-xs"></i>
                        </div>
                        <span>Crew Members</span>
                    </a>
                }

                <div class="pt-8 mb-4 flex items-center gap-4">
                    <div class="w-1.5 h-6 bg-secondary rounded-full"></div>
                    <span class="text-[10px] font-black text-secondary uppercase tracking-[0.4em] italic">Intel</span>
                </div>

                <a asp-controller="NewsManage" asp-action="Index" class="nav-link-admin group">
                    <div class="w-10 h-10 rounded-xl bg-surface-soft flex-center group-hover:bg-secondary group-hover:text-white transition-all shadow-sm">
                        <i class="fas fa-satellite-dish text-xs"></i>
                    </div>
                    <span>Transmissions</span>
                </a>

                @if (role != "Employee")
                {
                    <a asp-controller="QuanCafe" asp-action="Index" class="nav-link-admin group">
                        <div class="w-10 h-10 rounded-xl bg-surface-soft flex-center group-hover:bg-secondary group-hover:text-white transition-all shadow-sm">
                            <i class="fas fa-building text-xs"></i>
                        </div>
                        <span>HQ Config</span>
                    </a>
                }

                <div class="pt-10 mt-10 border-t border-border/50">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-4 px-6 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest text-primary hover:bg-primary/5 transition-all">
                        <i class="fas fa-external-link-alt"></i>
                        Return to Orbit
                    </a>
                </div>
            </nav>
        </div>
    </aside>

    <!-- Admin Main Content: Command Dashboard -->
    <main id="adminMain" class="pt-32 lg:pl-[312px] pr-8 pb-12 min-h-screen transition-all duration-500">
        <div class="animate-fade-in max-w-[1600px] mx-auto">
            @RenderBody()
        </div>

        <footer class="mt-24 pt-10 border-t border-border/50 flex flex-col lg:flex-row items-center justify-between gap-8 text-[10px] font-black uppercase tracking-widest text-text-light max-w-[1600px] mx-auto">
            <div class="flex items-center gap-3">
                <span class="text-secondary italic">THE SPACE COFFEE</span>
                <span class="text-border">|</span>
                <span>Command Center v4.1 © @DateTime.Now.Year</span>
            </div>
            <div class="flex items-center gap-8">
                <a href="#" class="hover:text-primary transition-colors">Technical Docs</a>
                <a href="#" class="hover:text-primary transition-colors">System Support</a>
                <a href="#" class="hover:text-primary transition-colors">Encryption Policy</a>
            </div>
        </footer>
    </main>

    <!-- Custom CSS for Admin Links -->
    <style>
        .nav-link-admin {
            @@apply flex items-center gap-6 px-6 py-4 rounded-3xl text-[10px] font-black uppercase tracking-widest text-text-muted hover:text-secondary hover:bg-surface-soft transition-all duration-300;
        }
        .nav-link-admin.active-link {
            @@apply bg-surface-soft text-secondary shadow-sm;
        }
        .nav-link-admin.active-link div {
            @@apply bg-primary text-white shadow-lg shadow-primary/20;
        }
        
        #adminSidebar.active {
            @@apply translate-x-0 !important;
        }
        
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            @@apply bg-border rounded-full hover:bg-text-light transition-colors;
        }
    </style>

    <!-- Admin Interaction Script -->
    <script>
        const sidebar = document.getElementById('adminSidebar');
        const toggle = document.getElementById('sidebarToggle');
        
        if (toggle && sidebar) {
            toggle.addEventListener('click', (e) => {
                e.stopPropagation();
                sidebar.classList.toggle('active');
            });
            
            // Close sidebar when clicking outside on mobile
            document.addEventListener('click', (e) => {
                if (window.innerWidth < 1024 && !sidebar.contains(e.target) && !toggle.contains(e.target)) {
                    sidebar.classList.remove('active');
                }
            });
        }

        // Active link highlighting with exact path matching
        const currentPath = window.location.pathname.toLowerCase();
        const navLinks = document.querySelectorAll('.nav-link-admin');
        navLinks.forEach(link => {
            const href = link.getAttribute('href').toLowerCase();
            // Match controller or full path
            if (currentPath === href || (href !== '/' && currentPath.includes(href))) {
                link.classList.add('active-link');
            }
        });
    </script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>


