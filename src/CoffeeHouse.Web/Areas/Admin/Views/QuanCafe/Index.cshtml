@using CoffeeHouse.Domain.Entities
@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<CafeStore>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Sector Hub Directory";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-10 animate-fade-in">
    <!-- Page Header: Strategic Mapping -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 rounded-[48px] border border-border/50 shadow-2xl flex flex-col xl:flex-row xl:items-center justify-between gap-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-16 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary">
            HUBS
        </div>

        <div class="relative z-10 space-y-2">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Operational Deployment</span>
            <h1 class="text-5xl font-black text-secondary tracking-tighter italic">Sector <span class="text-primary not-italic">Hub Directory</span></h1>
            <p class="text-[10px] font-black uppercase tracking-widest text-text-light">Current deployment bases and command posts across all territories.</p>
        </div>

        <div class="relative z-10 flex flex-col md:flex-row items-center gap-6">
            <div class="relative group/search w-full md:w-[320px]">
                @using (Html.BeginForm("Search", "QuanCafe", FormMethod.Get, new { @class = "flex-1" }))
                {
                    <input type="text" name="search" placeholder="Quét tọa độ hub..." 
                           class="w-full pl-14 pr-6 py-5 bg-surface-soft border border-border/50 rounded-3xl text-[10px] font-black uppercase tracking-widest outline-none focus:ring-4 focus:ring-primary/10 focus:border-primary focus:bg-white transition-all shadow-inner">
                    <i class="fas fa-satellite-dish absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/search:text-primary transition-colors text-xs"></i>
                }
            </div>
            
            <a asp-action="Create" class="w-full md:w-auto btn-primary h-[60px] !rounded-3xl px-10 flex items-center justify-center gap-4 group/btn shadow-xl shadow-primary/20">
                <span class="text-[10px] font-black uppercase tracking-widest">Establish New Hub</span>
                <i class="fas fa-plus-circle group-hover:rotate-90 transition-transform"></i>
            </a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="bg-emerald-50 text-emerald-700 px-8 py-5 rounded-3xl border border-emerald-100 flex items-center gap-4 animate-scale-in">
            <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex-center shadow-lg shadow-emerald-500/20">
                <i class="fas fa-check"></i>
            </div>
            <span class="text-[10px] font-black uppercase tracking-[0.2em]">@TempData["Message"]</span>
        </div>
    }

    <!-- Hub Table: Deployment Matrix -->
    <div class="bg-white/70 backdrop-blur-2xl rounded-[56px] border border-border/50 shadow-2xl overflow-hidden group">
        <div class="overflow-x-auto custom-scrollbar">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-secondary text-white">
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em] w-16 text-center">Hub ID</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Base Designation</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Territorial Coordinates</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Communication Signals</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em] text-center">Interstellar Operations</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border/30">
                    @foreach (var (item, index) in Model.Select((v, i) => (v, i)))
                    {
                        <tr class="group/row hover:bg-surface-soft/50 transition-colors duration-500 @(index % 2 != 0 ? "bg-surface-soft/20" : "")">
                            <td class="px-8 py-8 text-center">
                                <span class="text-[9px] font-black text-text-light font-mono bg-surface-soft px-3 py-1 rounded-lg border border-border/50">#HUB-@item.StoreId.ToString("D3")</span>
                            </td>
                            <td class="px-8 py-8">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 rounded-[14px] bg-primary/10 text-primary flex-center shadow-inner group-hover/row:scale-110 transition-transform">
                                        <i class="fas fa-building text-xs"></i>
                                    </div>
                                    <p class="text-base font-black text-secondary tracking-tight italic">@item.StoreName</p>
                                </div>
                            </td>
                            <td class="px-8 py-8">
                                <div class="flex items-center gap-3">
                                    <i class="fas fa-map-marker-alt text-[10px] text-primary"></i>
                                    <p class="text-[11px] font-medium text-text-muted leading-relaxed max-w-[250px]">@item.Address</p>
                                </div>
                            </td>
                            <td class="px-8 py-8">
                                <div class="space-y-2">
                                    <div class="flex items-center gap-3">
                                        <i class="fas fa-phone-alt text-[8px] text-text-light"></i>
                                        <span class="text-[10px] font-black text-secondary tracking-widest italic">@item.PhoneNumber</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <i class="fas fa-envelope text-[8px] text-text-light"></i>
                                        <span class="text-[9px] font-bold text-text-muted hover:text-primary transition-colors cursor-pointer">@item.Email</span>
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-8 text-center">
                                <div class="flex items-center justify-center gap-3">
                                    <a asp-action="Details" asp-route-id="@item.StoreId" 
                                       class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-secondary hover:text-white transition-all shadow-sm hover:shadow-lg hover:-translate-y-1" title="Analyze Hub">
                                        <i class="fas fa-chart-line text-[10px]"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.StoreId" 
                                       class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-emerald-500 hover:text-white transition-all shadow-sm hover:shadow-lg hover:-translate-y-1" title="Re-align Hub">
                                        <i class="fas fa-edit text-[10px]"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.StoreId" 
                                       class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-rose-500 hover:text-white transition-all shadow-sm hover:shadow-lg hover:-translate-y-1" title="Decommission">
                                        <i class="fas fa-power-off text-[10px]"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Matrix Pagination -->
        <div class="px-12 py-10 bg-surface-soft/50 border-t border-border/30 flex justify-center">
            @Html.PagedListPager(Model, page => Url.Action("index", new { page = page }), new PagedListRenderOptions()
            {
                MaximumPageNumbersToDisplay = 5,
                LiElementClasses = new List<String> { "" },
                PageClasses = new List<String> { "w-14 h-14 flex items-center justify-center rounded-2xl border border-border/50 text-[10px] font-black uppercase tracking-widest transition-all hover:bg-primary hover:text-white hover:border-primary bg-white mx-1.5 shadow-sm hover:shadow-xl hover:-translate-y-1" },
                UlElementClasses = new List<String> { "flex items-center" },
                ActiveLiElementClass = "[&_a]:bg-primary [&_a]:text-white [&_a]:border-primary [&_a]:shadow-xl [&_a]:shadow-primary/20",
            })
        </div>
    </div>
    
    <!-- Integrity Verification -->
    <div class="flex items-center justify-between px-8">
        <p class="text-[8px] font-black uppercase tracking-[0.3em] text-text-light italic">Territorial Integrity Verified by Command HQ · 2024</p>
        <div class="flex items-center gap-4">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-[8px] font-mono text-text-light">ALL_HUBS_ONLINE</span>
        </div>
    </div>
</div>


