@model CoffeeHouse.Areas.Admin.ViewModels.EmployeeAccountViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Recalibrate Crew Parameters";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-5xl mx-auto space-y-12 animate-fade-in">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.3em] text-text-light">
        <a asp-action="Index" class="hover:text-primary transition-colors">Crew Roster</a>
        <i class="fas fa-chevron-right text-[8px]"></i>
        <span class="text-secondary italic">Personnel Recalibration</span>
    </nav>

    <!-- Header -->
    <div class="pb-10 border-b-2 border-secondary/10 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-12 opacity-[0.02] text-7xl font-black pointer-events-none select-none italic text-secondary">
            MOD_STAFF
        </div>
        <div class="relative z-10 space-y-4">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Calibration Protocol</span>
            <h1 class="text-5xl lg:text-7xl font-black text-secondary tracking-tighter italic leading-none">Hiệu chỉnh <span class="text-primary not-italic">Nhân sự</span></h1>
            <div class="flex items-center gap-4">
                <span class="text-[10px] font-black text-text-muted font-mono bg-surface-soft px-4 py-1 rounded-lg border border-border/50 shadow-inner">STAFF_ID: #STA-@Model.Employee.EmployeeId.ToString("D3")</span>
                <p class="text-[10px] font-black uppercase tracking-widest text-text-light italic">Overriding crew parameters in the central command database.</p>
            </div>
        </div>
    </div>

    <!-- Form Container: Command Console -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 lg:p-16 rounded-[64px] border border-border/50 shadow-2xl relative">
        <form asp-action="Edit" method="post" class="space-y-16">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Employee.EmployeeId" />

            <div asp-validation-summary="All" class="rounded-3xl bg-rose-50 border border-rose-100 p-6 text-rose-500 text-[10px] font-black uppercase tracking-widest italic shadow-inner"></div>

            <!-- Segment: Biometric Overrides -->
            <div class="space-y-10">
                <div class="flex items-center gap-6">
                    <span class="w-10 h-10 rounded-2xl bg-secondary text-white flex-center text-[10px] font-black italic shadow-lg shadow-secondary/20">BIO</span>
                    <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary">Biometric Detail Overrides</h3>
                    <div class="h-px bg-border/50 flex-1"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="md:col-span-2 space-y-4">
                        <label asp-for="Employee.FullName" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Full Name / Alias</label>
                        <input asp-for="Employee.FullName" class="input-modern h-20 !rounded-[28px] px-8 text-base font-bold shadow-inner" required />
                        <span asp-validation-for="Employee.FullName" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <div class="space-y-4">
                        <label asp-for="Employee.StoreId" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Assigned Node (Branch)</label>
                        <div class="relative group/input">
                            <select asp-for="Employee.StoreId" class="input-modern h-20 !rounded-[28px] pl-8 pr-12 text-base font-bold shadow-inner appearance-none" asp-items="ViewBag.StoreId">
                                <option value="">-- Select Terminal --</option>
                            </select>
                            <i class="fas fa-satellite-dish absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors pointer-events-none"></i>
                        </div>
                        <span asp-validation-for="Employee.StoreId" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <div class="md:col-span-2 space-y-4">
                        <label asp-for="Employee.Address" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Sector Coordinates (Address)</label>
                        <input asp-for="Employee.Address" class="input-modern h-20 !rounded-[28px] px-8 text-base font-bold shadow-inner" />
                        <span asp-validation-for="Employee.Address" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <div class="space-y-4">
                        <label asp-for="Employee.DateOfBirth" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Origin Date (Birthday)</label>
                        <input asp-for="Employee.DateOfBirth" type="date" class="input-modern h-20 !rounded-[28px] px-8 text-base font-bold shadow-inner" />
                        <span asp-validation-for="Employee.DateOfBirth" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <div class="space-y-4">
                        <label asp-for="Employee.Gender" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Gender Marker</label>
                        <div class="relative group/input">
                            <select asp-for="Employee.Gender" class="input-modern h-20 !rounded-[28px] pl-8 pr-12 text-base font-bold shadow-inner appearance-none">
                                <option value="">-- Select --</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                            <i class="fas fa-venus-mars absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors pointer-events-none"></i>
                        </div>
                        <span asp-validation-for="Employee.Gender" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <div class="space-y-4">
                        <label asp-for="Employee.Position" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Operational Rank</label>
                        <div class="relative group/input">
                            <select asp-for="Employee.Position" class="input-modern h-20 !rounded-[28px] pl-8 pr-12 text-base font-bold shadow-inner appearance-none">
                                <option value="">-- Select Rank --</option>
                                <option value="Quản lý">Quản lý</option>
                                <option value="Nhân viên">Nhân viên</option>
                            </select>
                            <i class="fas fa-chevron-down absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors pointer-events-none"></i>
                        </div>
                        <span asp-validation-for="Employee.Position" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <div class="space-y-4">
                        <label asp-for="Employee.PhoneNumber" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Comm Link (Phone)</label>
                        <input asp-for="Employee.PhoneNumber" class="input-modern h-20 !rounded-[28px] px-8 text-base font-bold shadow-inner" />
                        <span asp-validation-for="Employee.PhoneNumber" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <div class="space-y-4">
                        <label asp-for="Employee.IdentityCardNumber" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">ID Hash (CCCD)</label>
                        <input asp-for="Employee.IdentityCardNumber" class="input-modern h-20 !rounded-[28px] px-8 text-base font-bold shadow-inner" />
                        <span asp-validation-for="Employee.IdentityCardNumber" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <div class="md:col-span-2 space-y-4">
                        <label asp-for="Employee.Email" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Data Stream Address</label>
                        <input asp-for="Employee.Email" class="input-modern h-20 !rounded-[28px] px-8 text-base font-bold shadow-inner" />
                        <span asp-validation-for="Employee.Email" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <div class="space-y-4">
                        <label asp-for="Employee.BaseSalary" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Base Salary Allocation</label>
                        <input asp-for="Employee.BaseSalary" class="input-modern h-20 !rounded-[28px] px-8 text-base font-bold shadow-inner" />
                        <span asp-validation-for="Employee.BaseSalary" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <div class="space-y-4">
                        <label asp-for="Employee.SalaryCoefficient" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Merit Multiplier</label>
                        <input asp-for="Employee.SalaryCoefficient" class="input-modern h-20 !rounded-[28px] px-8 text-base font-bold shadow-inner" />
                        <span asp-validation-for="Employee.SalaryCoefficient" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>
                </div>
            </div>

            <!-- Segment: Access Recalibration -->
            <div class="space-y-10">
                <div class="flex items-center gap-6">
                    <span class="w-10 h-10 rounded-2xl bg-primary text-white flex-center text-[10px] font-black italic shadow-lg shadow-primary/20">ACCESS</span>
                    <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-secondary">Network Access Recalibration</h3>
                    <div class="h-px bg-border/50 flex-1"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="space-y-4">
                        <label asp-for="Account.Username" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Access Login ID</label>
                        <input asp-for="Account.Username" class="input-modern h-20 !rounded-[28px] px-8 text-base font-bold shadow-inner" />
                        <span asp-validation-for="Account.Username" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <div class="space-y-4">
                        <label asp-for="Account.Password" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Update Security Phrase</label>
                        <input asp-for="Account.Password" type="password" class="input-modern h-20 !rounded-[28px] px-8 text-base font-bold shadow-inner" placeholder="Leave blank to maintain current..." />
                    </div>

                    <div class="space-y-4">
                        <label asp-for="Account.RoleId" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Access Clearance</label>
                        <div class="relative group/input">
                            <select asp-for="Account.RoleId" class="input-modern h-20 !rounded-[28px] pl-8 pr-12 text-base font-bold shadow-inner appearance-none" asp-items="ViewBag.RoleId">
                                <option value="">-- Select Level --</option>
                            </select>
                            <i class="fas fa-shield-alt absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors pointer-events-none"></i>
                        </div>
                        <span asp-validation-for="Account.RoleId" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>
                </div>
            </div>

            <!-- Execution Strategy -->
            <div class="pt-10 flex flex-col sm:flex-row items-center justify-between border-t border-border/50 gap-8">
                <a asp-action="Index" class="flex items-center gap-4 text-[10px] font-black uppercase tracking-widest text-text-muted hover:text-secondary transition-all group">
                    <i class="fas fa-chevron-left transition-transform group-hover:-translate-x-2"></i>
                    Abort Recalibration
                </a>
                
                <button type="submit" class="w-full sm:w-auto btn-primary h-20 !px-16 !rounded-[32px] flex items-center justify-center gap-6 group shadow-2xl shadow-primary/30">
                    <span class="text-[10px] font-black uppercase tracking-[0.3em]">Commit Calibration Override</span>
                    <i class="fas fa-save transition-transform group-hover:scale-110"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}



