@model CoffeeHouse.Domain.Entities.Employee
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Operative Dossier Analysis";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-6xl mx-auto space-y-12 animate-fade-in">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.3em] text-text-light">
        <a asp-action="Index" class="hover:text-primary transition-colors">Crew Roster</a>
        <i class="fas fa-chevron-right text-[8px]"></i>
        <span class="text-secondary italic">Operative Dossier</span>
    </nav>

    <!-- Header: Dossier Identity -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 lg:p-16 rounded-[64px] border border-border/50 shadow-2xl relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-16 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary group-hover:opacity-[0.05] transition-opacity">
            #STA-@Model.EmployeeId.ToString("D3")
        </div>
        
        <div class="flex flex-col lg:flex-row lg:items-center gap-12 relative z-10">
            <div class="w-32 h-32 lg:w-48 lg:h-48 rounded-[48px] bg-gradient-to-br from-secondary to-primary/80 text-white flex-center shadow-2xl shadow-secondary/30 border-4 border-white/20">
                <i class="fas fa-user-astronaut text-5xl lg:text-7xl"></i>
            </div>
            
            <div class="space-y-6">
                <div class="space-y-2">
                    <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Operational Profile</span>
                    <h1 class="text-5xl lg:text-7xl font-black text-secondary tracking-tighter italic leading-none">@Model.FullName</h1>
                </div>
                
                <div class="flex flex-wrap items-center gap-4">
                    <span class="px-6 py-2 rounded-2xl bg-secondary text-white text-[10px] font-black uppercase tracking-widest italic shadow-lg shadow-secondary/20">@Model.Position</span>
                    <span class="text-[10px] font-black text-text-muted font-mono bg-surface-soft px-4 py-2 rounded-xl border border-border/50 shadow-inner">ID_NODE: @(Model.Store?.StoreName ?? "HQ_CORE")</span>
                    <span class="text-[10px] font-black uppercase tracking-widest text-text-light italic">Clearance: Level 4 · Active Station</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Dossier Content: Intelligence Matrix -->
    <div class="space-y-10">
        <!-- Dashboard Navigation -->
        <div class="bg-white/70 backdrop-blur-xl p-4 rounded-[32px] border border-border/50 shadow-xl flex flex-wrap items-center gap-2 overflow-hidden">
            <button class="flex-1 min-w-[150px] flex items-center justify-center gap-3 px-8 py-5 rounded-[24px] text-[10px] font-black uppercase tracking-widest transition-all tab-btn active" data-tab="info">
                <i class="fas fa-id-card-alt text-base"></i> Service Record
            </button>
            <button class="flex-1 min-w-[150px] flex items-center justify-center gap-3 px-8 py-5 rounded-[24px] text-[10px] font-black uppercase tracking-widest transition-all tab-btn" data-tab="account">
                <i class="fas fa-key text-base"></i> Node Access
            </button>
            <button class="flex-1 min-w-[150px] flex items-center justify-center gap-3 px-8 py-5 rounded-[24px] text-[10px] font-black uppercase tracking-widest transition-all tab-btn" data-tab="import">
                <i class="fas fa-dolly-flatbed text-base"></i> Logistic Slips
            </button>
            <button class="flex-1 min-w-[150px] flex items-center justify-center gap-3 px-8 py-5 rounded-[24px] text-[10px] font-black uppercase tracking-widest transition-all tab-btn" data-tab="orders">
                <i class="fas fa-file-invoice-dollar text-base"></i> Commerce Logs
            </button>
        </div>

        <div class="bg-white/70 backdrop-blur-2xl rounded-[64px] border border-border/50 shadow-2xl overflow-hidden min-h-[600px] relative">
            <!-- Tab Pane: Info -->
            <div class="tab-pane active p-10 lg:p-16 animate-fade-in" id="info">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
                    <div class="space-y-12">
                        <div class="space-y-8">
                            <h4 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary flex items-center gap-4 before:content-[''] before:w-8 before:h-px before:bg-primary">Biological & Geo Data</h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                                <div class="space-y-2">
                                    <span class="text-[9px] font-black uppercase tracking-widest text-text-muted">Origin Date</span>
                                    <p class="text-xl font-black text-secondary italic tracking-tight">@Model.DateOfBirth?.ToString("dd/MM/yyyy")</p>
                                </div>
                                <div class="space-y-2">
                                    <span class="text-[9px] font-black uppercase tracking-widest text-text-muted">Gender Marker</span>
                                    <p class="text-xl font-black text-secondary italic tracking-tight">@Model.Gender</p>
                                </div>
                                <div class="space-y-2 md:col-span-2">
                                    <span class="text-[9px] font-black uppercase tracking-widest text-text-muted">Sector Coordinates</span>
                                    <p class="text-xl font-black text-secondary tracking-tight">@Model.Address</p>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-8">
                            <h4 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary flex items-center gap-4 before:content-[''] before:w-8 before:h-px before:bg-primary">Comm Link & Security</h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                                <div class="space-y-2">
                                    <span class="text-[9px] font-black uppercase tracking-widest text-text-muted">Secure Line</span>
                                    <p class="text-xl font-black text-emerald-600 font-mono italic">@Model.PhoneNumber</p>
                                </div>
                                <div class="space-y-2">
                                    <span class="text-[9px] font-black uppercase tracking-widest text-text-muted">Data Terminal</span>
                                    <p class="text-[11px] font-black text-secondary/70 truncate">@Model.Email</p>
                                </div>
                                <div class="space-y-2 md:col-span-2">
                                    <span class="text-[9px] font-black uppercase tracking-widest text-text-muted">Government ID Hash</span>
                                    <p class="text-xl font-black text-secondary/80 font-mono">@Model.IdentityCardNumber</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="lg:pl-16 lg:border-l border-border/50 flex flex-col justify-center">
                        <div class="bg-surface-soft/50 p-12 rounded-[48px] border border-border/30 shadow-inner relative group/salary">
                            <div class="absolute top-0 right-0 p-8 opacity-[0.03] text-5xl font-black italic text-secondary group-hover/salary:opacity-10 transition-opacity">CREDITS</div>
                            <div class="space-y-10 relative z-10">
                                <span class="text-primary font-black uppercase tracking-[0.3em] text-[10px]">Resource Allocation</span>
                                <div class="space-y-6">
                                    <div class="flex items-center justify-between border-b border-border/50 pb-4">
                                        <span class="text-[10px] font-black uppercase tracking-widest text-text-light">Base Credit</span>
                                        <span class="text-xl font-black text-secondary italic">@Model.BaseSalary.ToString("n0") <span class="text-[8px] not-italic opacity-50 ml-1">Đ</span></span>
                                    </div>
                                    <div class="flex items-center justify-between border-b border-border/50 pb-4">
                                        <span class="text-[10px] font-black uppercase tracking-widest text-text-light">Merit Factor</span>
                                        <span class="text-xl font-black text-secondary italic">x@Model.SalaryCoefficient</span>
                                    </div>
                                    <div class="pt-6">
                                        <span class="text-[10px] font-black uppercase tracking-widest text-primary mb-4 block">Total Operational Budget</span>
                                        <p class="text-5xl lg:text-6xl font-black text-secondary italic tracking-tighter">@((Model.SalaryCoefficient * Model.BaseSalary).ToString("n0")) <span class="text-xs not-italic ml-1 opacity-40 uppercase">VNĐ</span></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab Pane: Account -->
            <div class="tab-pane hidden p-10 lg:p-16 animate-fade-in" id="account">
                <div class="space-y-10">
                    <div class="flex items-center gap-6">
                        <span class="w-12 h-12 rounded-2xl bg-secondary text-white flex-center text-base shadow-lg shadow-secondary/20"><i class="fas fa-network-wired"></i></span>
                        <div class="space-y-1">
                            <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary">Node Protocol Access</h3>
                            <p class="text-[9px] font-black uppercase tracking-widest text-text-light">Active network credentials for this operative.</p>
                        </div>
                        <div class="h-px bg-border/50 flex-1"></div>
                    </div>

                    @if (Model.Accounts != null && Model.Accounts.Any())
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            @foreach (var acc in Model.Accounts)
                            {
                                <div class="bg-white p-8 rounded-[32px] border border-border/50 shadow-xl flex items-center gap-8 group/acc transition-all hover:-translate-y-2">
                                    <div class="w-20 h-20 rounded-[24px] bg-surface-soft flex-center text-2xl text-secondary group-hover/acc:bg-secondary group-hover/acc:text-white transition-all shadow-inner">
                                        <i class="fas fa-user-shield"></i>
                                    </div>
                                    <div class="space-y-2">
                                        <span class="text-[9px] font-black uppercase tracking-widest text-text-muted">Access ID</span>
                                        <p class="text-2xl font-black text-secondary tracking-tight italic group-hover/acc:text-primary transition-colors">@acc.Username</p>
                                        <span class="text-[10px] font-black text-text-light font-mono bg-surface-soft px-3 py-1 rounded-lg border border-border/50">NODE_ID: #ACC-@acc.AccountId.ToString("D3")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="py-20 text-center space-y-6">
                            <div class="w-20 h-20 rounded-full bg-surface-soft flex-center mx-auto opacity-30 text-3xl"><i class="fas fa-lock"></i></div>
                            <p class="text-[10px] font-black uppercase tracking-widest text-text-muted italic">Access credentials not established for this operative.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Tab Pane: Import Slips -->
            <div class="tab-pane hidden p-10 lg:p-16 animate-fade-in" id="import">
                <div class="space-y-10">
                    <div class="flex items-center gap-6">
                        <span class="w-12 h-12 rounded-2xl bg-secondary text-white flex-center text-base shadow-lg shadow-secondary/20"><i class="fas fa-boxes"></i></span>
                        <div class="space-y-1">
                            <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary">Procurement Slips</h3>
                            <p class="text-[9px] font-black uppercase tracking-widest text-text-light">Registry of logistics operations managed by this operative.</p>
                        </div>
                        <div class="h-px bg-border/50 flex-1"></div>
                    </div>

                    @if (Model.PurchaseOrders != null && Model.PurchaseOrders.Any())
                    {
                        <div class="bg-white rounded-[40px] border border-border/50 shadow-xl overflow-hidden">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-surface-soft text-text-light border-b border-border/50">
                                        <th class="px-8 py-6 text-[9px] font-black uppercase tracking-widest">Slip ID</th>
                                        <th class="px-8 py-6 text-[9px] font-black uppercase tracking-widest">Timestamp</th>
                                        <th class="px-8 py-6 text-[9px] font-black uppercase tracking-widest">Guild Partner</th>
                                        <th class="px-8 py-6 text-[9px] font-black uppercase tracking-widest">Fiscal Value</th>
                                        <th class="px-8 py-6 text-[9px] font-black uppercase tracking-widest text-center">Protocol</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-border/20">
                                    @foreach (var phieu in Model.PurchaseOrders)
                                    {
                                        var tongTien2 = phieu.PurchaseOrderItems?.Sum(ct => ct.Quantity * ct.UnitPrice) ?? 0;
                                        <tr class="group/row hover:bg-surface-soft/30 transition-colors">
                                            <td class="px-8 py-6">
                                                <span class="text-[9px] font-black text-text-light font-mono bg-surface-soft px-3 py-1 rounded-lg border border-border/50">#PN-@phieu.PurchaseOrderId.ToString("D3")</span>
                                            </td>
                                            <td class="px-8 py-6">
                                                <p class="text-[10px] font-black text-secondary tracking-widest">@phieu.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                                            </td>
                                            <td class="px-8 py-6">
                                                <p class="text-[10px] font-black text-secondary italic">@(phieu.Supplier?.SupplierName ?? "Independent Guild")</p>
                                            </td>
                                            <td class="px-8 py-6">
                                                <p class="text-[11px] font-black text-primary italic tracking-tighter">@tongTien2.ToString("n0") đ</p>
                                            </td>
                                            <td class="px-8 py-6 text-center">
                                                <button class="w-10 h-10 rounded-xl bg-surface-soft text-text-muted hover:bg-secondary hover:text-white transition-all shadow-sm toggle-details" data-target="import-details-@phieu.PurchaseOrderId">
                                                    <i class="fas fa-chevron-down text-[10px]"></i>
                                                </button>
                                            </td>
                                        </tr>

                                        @if (phieu.PurchaseOrderItems != null && phieu.PurchaseOrderItems.Any())
                                        {
                                            <tr class="hidden-row bg-surface-soft/40 border-l-4 border-secondary" id="import-details-@phieu.PurchaseOrderId" style="display:none;">
                                                <td colspan="5" class="p-8">
                                                    <div class="bg-white rounded-3xl border border-border/50 shadow-inner overflow-hidden">
                                                        <table class="w-full text-left text-[9px]">
                                                            <thead>
                                                                <tr class="bg-secondary text-white">
                                                                    <th class="px-6 py-4 font-black uppercase tracking-widest">Payload ID</th>
                                                                    <th class="px-6 py-4 font-black uppercase tracking-widest">Cargo Specification</th>
                                                                    <th class="px-6 py-4 font-black uppercase tracking-widest text-center">Qty</th>
                                                                    <th class="px-6 py-4 font-black uppercase tracking-widest text-right">Unit Price</th>
                                                                    <th class="px-6 py-4 font-black uppercase tracking-widest text-right">Subtotal</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody class="divide-y divide-border/10">
                                                                @foreach (var detail in phieu.PurchaseOrderItems)
                                                                {
                                                                    <tr>
                                                                        <td class="px-6 py-4 font-mono text-text-light italic">#MAT-@detail.IngredientId.ToString("D3")</td>
                                                                        <td class="px-6 py-4 font-black text-secondary uppercase">@(detail.Ingredient?.IngredientName ?? "Unknown Material")</td>
                                                                        <td class="px-6 py-4 text-center font-black text-secondary">x@detail.Quantity</td>
                                                                        <td class="px-6 py-4 text-right font-black text-text-light">@detail.UnitPrice.ToString("n0") đ</td>
                                                                        <td class="px-6 py-4 text-right font-black text-primary italic">@((detail.Quantity * detail.UnitPrice).ToString("n0")) đ</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="py-20 text-center space-y-6">
                            <div class="w-20 h-20 rounded-full bg-surface-soft flex-center mx-auto opacity-30 text-3xl"><i class="fas fa-radar"></i></div>
                            <p class="text-[10px] font-black uppercase tracking-widest text-text-muted italic">No procurement history recorded for this agent.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Tab Pane: Commerce Logs -->
            <div class="tab-pane hidden p-10 lg:p-16 animate-fade-in" id="orders">
                <div class="space-y-10">
                    <div class="flex items-center gap-6">
                        <span class="w-12 h-12 rounded-2xl bg-secondary text-white flex-center text-base shadow-lg shadow-secondary/20"><i class="fas fa-receipt"></i></span>
                        <div class="space-y-1">
                            <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary">Commerce Invoices</h3>
                            <p class="text-[9px] font-black uppercase tracking-widest text-text-light">Archive of commerce terminal sales authorized by this agent.</p>
                        </div>
                        <div class="h-px bg-border/50 flex-1"></div>
                    </div>

                    @if (Model.SalesOrders != null && Model.SalesOrders.Any())
                    {
                        <div class="bg-white rounded-[40px] border border-border/50 shadow-xl overflow-hidden">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-surface-soft text-text-light border-b border-border/50">
                                        <th class="px-8 py-6 text-[9px] font-black uppercase tracking-widest">Manifest ID</th>
                                        <th class="px-8 py-6 text-[9px] font-black uppercase tracking-widest">Timestamp</th>
                                        <th class="px-8 py-6 text-[9px] font-black uppercase tracking-widest">Net Value</th>
                                        <th class="px-8 py-6 text-[9px] font-black uppercase tracking-widest">Status</th>
                                        <th class="px-8 py-6 text-[9px] font-black uppercase tracking-widest text-center">Protocol</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-border/20">
                                    @foreach (var order in Model.SalesOrders)
                                    {
                                        <tr class="group/row hover:bg-surface-soft/30 transition-colors">
                                            <td class="px-8 py-6">
                                                <span class="text-[9px] font-black text-text-light font-mono bg-surface-soft px-3 py-1 rounded-lg border border-border/50">#HD-@order.OrderId.ToString("D4")</span>
                                            </td>
                                            <td class="px-8 py-6">
                                                <p class="text-[10px] font-black text-secondary tracking-widest">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                                            </td>
                                            <td class="px-8 py-6">
                                                <p class="text-[11px] font-black text-primary italic tracking-tighter">@order.TotalAmount.ToString("n0") đ</p>
                                            </td>
                                            <td class="px-8 py-6">
                                                <div class="flex items-center gap-2">
                                                    <div class="w-1.5 h-1.5 rounded-full @(order.Status == "Hoàn thành" ? "bg-emerald-500 shadow-emerald-500/30" : "bg-amber-500 shadow-amber-500/30") animate-pulse"></div>
                                                    <span class="text-[9px] font-black uppercase tracking-widest text-secondary">@order.Status</span>
                                                </div>
                                            </td>
                                            <td class="px-8 py-6 text-center">
                                                <button class="w-10 h-10 rounded-xl bg-surface-soft text-text-muted hover:bg-secondary hover:text-white transition-all shadow-sm toggle-details" data-target="order-details-@order.OrderId">
                                                    <i class="fas fa-chevron-down text-[10px]"></i>
                                                </button>
                                            </td>
                                        </tr>

                                        @if (order.SalesOrderItems != null && order.SalesOrderItems.Any())
                                        {
                                            <tr class="hidden-row bg-surface-soft/40 border-l-4 border-primary" id="order-details-@order.OrderId" style="display:none;">
                                                <td colspan="5" class="p-8">
                                                    <div class="bg-white rounded-3xl border border-border/50 shadow-inner overflow-hidden">
                                                        <table class="w-full text-left text-[9px]">
                                                            <thead>
                                                                <tr class="bg-primary text-white">
                                                                    <th class="px-6 py-4 font-black uppercase tracking-widest">Product ID</th>
                                                                    <th class="px-6 py-4 font-black uppercase tracking-widest">Item Designation</th>
                                                                    <th class="px-6 py-4 font-black uppercase tracking-widest text-center">Qty</th>
                                                                    <th class="px-6 py-4 font-black uppercase tracking-widest text-right">Unit Price</th>
                                                                    <th class="px-6 py-4 font-black uppercase tracking-widest text-right">Subtotal</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody class="divide-y divide-border/10">
                                                                @foreach (var detail in order.SalesOrderItems)
                                                                {
                                                                    <tr>
                                                                        <td class="px-6 py-4 font-mono text-text-light italic">#PRD-@detail.ProductId.ToString("D3")</td>
                                                                        <td class="px-6 py-4 font-black text-secondary uppercase">@(detail.Product?.ProductName ?? "Generic Product")</td>
                                                                        <td class="px-6 py-4 text-center font-black text-secondary">x@detail.Quantity</td>
                                                                        <td class="px-6 py-4 text-right font-black text-text-light">@detail.UnitPrice.ToString("n0") đ</td>
                                                                        <td class="px-6 py-4 text-right font-black text-primary italic">@(detail.LineTotal.ToString("n0")) đ</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="py-20 text-center space-y-6">
                            <div class="w-20 h-20 rounded-full bg-surface-soft flex-center mx-auto opacity-30 text-3xl"><i class="fas fa-radar"></i></div>
                            <p class="text-[10px] font-black uppercase tracking-widest text-text-muted italic">No terminal sales reported by this operative.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Footer Action -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between border-t border-border/50 gap-8">
        <p class="text-[8px] font-black uppercase tracking-[0.3em] text-text-light italic">Operative Integrity Status: LEVEL_4_ACCESS · System Core 2.0</p>
        <div class="flex items-center gap-6">
            <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="h-16 px-12 bg-secondary text-white rounded-[24px] text-[10px] font-black uppercase tracking-widest hover:shadow-xl hover:shadow-secondary/20 transition-all flex items-center gap-4 group">
                <i class="fas fa-user-edit"></i> Modify Clearance
            </a>
            <a asp-action="Index" class="h-16 px-12 bg-surface-soft text-text-muted rounded-[24px] text-[10px] font-black uppercase tracking-widest hover:bg-border/30 transition-all flex items-center gap-4 group">
                <i class="fas fa-chevron-left transition-transform group-hover:-translate-x-2"></i> Close Dossier
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Tab system
            $('.tab-btn').on('click', function() {
                const target = $(this).data('tab');
                
                // Update buttons
                $('.tab-btn').removeClass('active');
                $(this).addClass('active');
                
                // Update panes
                $('.tab-pane').addClass('hidden').removeClass('active animate-fade-in');
                $('#' + target).removeClass('hidden').addClass('active animate-fade-in');
            });

            // Toggle details functionality
            $('.toggle-details').on('click', function() {
                const targetId = $(this).data('target');
                const row = $('#' + targetId);
                const icon = $(this).find('i');
                
                row.toggle();
                
                if(row.is(':visible')) {
                    icon.removeClass('fa-chevron-down').addClass('fa-chevron-up');
                    $(this).addClass('bg-secondary text-white');
                } else {
                    icon.removeClass('fa-chevron-up').addClass('fa-chevron-down');
                    $(this).removeClass('bg-secondary text-white');
                }
            });
        });
    </script>
    <style>
        .tab-btn.active {
            background: #111;
            color: #fff;
