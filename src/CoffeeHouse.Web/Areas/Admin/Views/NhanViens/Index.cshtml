@using CoffeeHouse.Domain.Entities
@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<Employee>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Crew Personnel Matrix";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-10 animate-fade-in">
    <!-- Page Header: Strategic Command -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 rounded-[48px] border border-border/50 shadow-2xl flex flex-col xl:flex-row xl:items-center justify-between gap-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-16 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary">
            PERSONNEL
        </div>

        <div class="relative z-10 space-y-2">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Crew Operations</span>
            <h1 class="text-5xl font-black text-secondary tracking-tighter italic">Quản lí <span class="text-primary not-italic">Nhân viên</span></h1>
            <p class="text-[10px] font-black uppercase tracking-widest text-text-light">Operational dashboard for managing galactic crew assignments and status.</p>
        </div>

        <div class="relative z-10 flex flex-col md:flex-row items-center gap-6">
            <div class="relative group/search w-full md:w-[320px]">
                @using (Html.BeginForm("Search", "NhanViens", FormMethod.Get, new { @class = "flex-1" }))
                {
                    <input type="text" name="search" placeholder="Search by name or comms..." 
                           class="w-full pl-14 pr-14 py-5 bg-surface-soft border border-border/50 rounded-3xl text-[10px] font-black uppercase tracking-widest outline-none focus:ring-4 focus:ring-primary/10 focus:border-primary focus:bg-white transition-all shadow-inner">
                    <i class="fas fa-search absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/search:text-primary transition-colors text-xs"></i>
                    <button type="submit" class="absolute right-6 top-1/2 -translate-y-1/2 text-primary hover:scale-110 transition-transform">
                        <i class="fas fa-arrow-right"></i>
                    </button>
                }
            </div>

            <a asp-action="Create" class="w-full md:w-auto btn-primary h-[60px] !rounded-3xl px-10 flex items-center justify-center gap-4 group shadow-xl shadow-primary/20">
                <span class="text-[10px] font-black uppercase tracking-widest">Enlist Personnel</span>
                <i class="fas fa-user-plus transition-transform group-hover:scale-110"></i>
            </a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="bg-emerald-500/10 backdrop-blur-xl border border-emerald-500/20 p-6 rounded-3xl flex items-center gap-6 animate-slide-up shadow-xl shadow-emerald-500/5">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500 text-white flex-center shadow-lg shadow-emerald-500/20">
                <i class="fas fa-check-double text-xs"></i>
            </div>
            <p class="text-[10px] font-black uppercase tracking-widest text-emerald-600 italic">@TempData["Message"]</p>
        </div>
    }

    <!-- Crew Roster Matrix -->
    <div class="bg-white/70 backdrop-blur-2xl rounded-[56px] border border-border/50 shadow-2xl overflow-hidden group">
        <div class="overflow-x-auto custom-scrollbar">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-secondary text-white border-b border-white/10">
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em] w-16 text-center">CREW_ID</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Designation</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Deployment Terminal</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Rank / Role</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Comm Link</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Data Access</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em] text-center">Protocol</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border/30">
                    @foreach (var (nv, index) in Model.Select((v, i) => (v, i)))
                    {
                        <tr class="group/row hover:bg-surface-soft/50 transition-colors duration-500 @(index % 2 != 0 ? "bg-surface-soft/20" : "")">
                            <td class="px-8 py-8 text-center">
                                <span class="text-[9px] font-black text-text-light font-mono bg-surface-soft px-3 py-1 rounded-lg border border-border/50">#STA-@nv.EmployeeId.ToString("D3")</span>
                            </td>
                            <td class="px-8 py-8">
                                <div class="flex items-center gap-6">
                                    <div class="w-12 h-12 rounded-2xl bg-surface-soft text-secondary flex-center border border-border/50 group-hover/row:bg-primary group-hover/row:text-white transition-all shadow-sm">
                                        <i class="fas fa-user-astronaut text-xs"></i>
                                    </div>
                                    <p class="text-base font-black text-secondary tracking-tight italic group-hover/row:text-primary transition-colors">@nv.FullName</p>
                                </div>
                            </td>
                            <td class="px-8 py-8">
                                <span class="text-[10px] font-black text-secondary tracking-widest uppercase truncate max-w-[150px]">@(nv.Store?.StoreName ?? "HQ CENTRAL")</span>
                            </td>
                            <td class="px-8 py-8">
                                <span class="px-4 py-1.5 rounded-xl bg-secondary text-white text-[8px] font-black uppercase tracking-[0.2em] italic shadow-lg shadow-secondary/10">@nv.Position</span>
                            </td>
                            <td class="px-8 py-8">
                                <p class="text-[11px] font-black text-emerald-600 font-mono italic">@nv.PhoneNumber</p>
                            </td>
                            <td class="px-8 py-8">
                                <p class="text-[10px] font-black text-secondary/70 truncate max-w-[180px]">@nv.Email</p>
                            </td>
                            <td class="px-8 py-8">
                                <div class="flex items-center justify-center gap-3">
                                    <a asp-action="Details" asp-route-id="@nv.EmployeeId" 
                                       class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-primary hover:text-white transition-all shadow-sm border border-border/50 hover:border-primary">
                                        <i class="fas fa-id-card text-xs"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@nv.EmployeeId" 
                                       class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-secondary hover:text-white transition-all shadow-sm border border-border/50 hover:border-secondary">
                                        <i class="fas fa-user-cog text-xs"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@nv.EmployeeId" 
                                       class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-rose-500 hover:text-white transition-all shadow-sm border border-border/50 hover:border-rose-500">
                                        <i class="fas fa-user-minus text-xs"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Matrix Footer -->
        <div class="px-12 py-10 bg-surface-soft/50 border-t border-border/30 flex justify-center">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }), new PagedListRenderOptions()
            {
                MaximumPageNumbersToDisplay = 5,
                LiElementClasses = new List<string> { "" },
                PageClasses = new List<string> { "w-14 h-14 flex items-center justify-center rounded-2xl border border-border/50 text-[10px] font-black uppercase tracking-widest transition-all hover:bg-primary hover:text-white hover:border-primary bg-white mx-1.5 shadow-sm hover:shadow-xl hover:-translate-y-1" },
                UlElementClasses = new List<string> { "flex items-center" },
                ActiveLiElementClass = "[&_a]:bg-primary [&_a]:text-white [&_a]:border-primary [&_a]:shadow-xl [&_a]:shadow-primary/20",
            })
        </div>
    </div>
</div>



