@using CoffeeHouse.Domain.Entities
@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<Customer>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Entity Directory";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-10 animate-fade-in">
    <!-- Page Header: Strategic Mapping -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 rounded-[48px] border border-border/50 shadow-2xl flex flex-col xl:flex-row xl:items-center justify-between gap-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-16 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary">
            ENTITIES
        </div>

        <div class="relative z-10 space-y-2">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Population Tracking</span>
            <h1 class="text-5xl font-black text-secondary tracking-tighter italic">Quản lý <span class="text-primary not-italic">Khách hàng</span></h1>
            <p class="text-[10px] font-black uppercase tracking-widest text-text-light">Catalogue of identified biological entities within the system radius.</p>
        </div>

        <div class="relative z-10 flex flex-col md:flex-row items-center gap-6">
            <div class="relative group/search w-full md:w-[320px]">
                @using (Html.BeginForm("Search", "Clients", FormMethod.Get, new { @class = "flex-1" }))
                {
                    <input type="text" name="search" placeholder="Quét Entity Name/ID..." 
                           class="w-full pl-14 pr-14 py-5 bg-surface-soft border border-border/50 rounded-3xl text-[10px] font-black uppercase tracking-widest outline-none focus:ring-4 focus:ring-primary/10 focus:border-primary focus:bg-white transition-all shadow-inner">
                    <i class="fa fa-id-badge absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/search:text-primary transition-colors text-xs"></i>
                    <button type="submit" class="absolute right-6 top-1/2 -translate-y-1/2 text-primary hover:scale-110 transition-transform">
                        <i class="fas fa-search"></i>
                    </button>
                }
            </div>
            
            <a asp-action="Create" class="w-full md:w-auto btn-primary h-[60px] !rounded-3xl px-10 flex items-center justify-center gap-4 group/btn shadow-xl shadow-primary/20">
                <span class="text-[10px] font-black uppercase tracking-widest">Đăng ký Entity mới</span>
                <i class="fas fa-user-plus group-hover:rotate-12 transition-transform"></i>
            </a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="bg-secondary text-white px-8 py-5 rounded-3xl border border-white/10 flex items-center gap-4 animate-scale-in shadow-xl shadow-secondary/20">
            <div class="w-10 h-10 rounded-xl bg-white/10 text-white flex-center backdrop-blur-md">
                <i class="fas fa-broadcast-tower"></i>
            </div>
            <span class="text-[10px] font-black uppercase tracking-[0.2em]">@TempData["Message"]</span>
        </div>
    }

    <!-- Entity Table: System Matrix -->
    <div class="bg-white/70 backdrop-blur-2xl rounded-[56px] border border-border/50 shadow-2xl overflow-hidden group">
        <div class="overflow-x-auto custom-scrollbar">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-secondary text-white">
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em] w-16 text-center">UID</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Full Name</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Communication</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Sector Residence</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em] text-center">Operations</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border/30">
                    @foreach (var (item, index) in Model.Select((v, i) => (v, i)))
                    {
                        <tr class="group/row hover:bg-surface-soft/50 transition-colors duration-500 @(index % 2 != 0 ? "bg-surface-soft/20" : "")">
                            <td class="px-8 py-8 text-center">
                                <span class="text-[9px] font-black text-text-light font-mono bg-surface-soft px-3 py-1 rounded-lg border border-border/50">USR-@item.CustomerId.ToString("D4")</span>
                            </td>
                            <td class="px-8 py-8">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 rounded-full bg-secondary/10 flex-center border border-secondary/10 group-hover/row:scale-110 transition-transform">
                                        <i class="fas fa-user text-[10px] text-secondary"></i>
                                    </div>
                                    <p class="text-base font-black text-secondary tracking-tight italic group-hover/row:text-primary transition-colors">@item.CustomerName</p>
                                </div>
                            </td>
                            <td class="px-8 py-8">
                                <div class="flex items-center gap-2 text-[10px] font-black text-text-muted">
                                    <i class="fas fa-phone-alt text-[8px] text-primary"></i>
                                    <span class="tracking-widest">@item.PhoneNumber</span>
                                </div>
                            </td>
                            <td class="px-8 py-8">
                                <p class="text-[10px] font-medium text-text-muted leading-relaxed max-w-[200px] truncate group-hover/row:whitespace-normal transition-all" title="@item.Address">@item.Address</p>
                            </td>
                            <td class="px-8 py-8">
                                <div class="flex items-center justify-center gap-3">
                                    <a asp-action="Details" asp-route-id="@item.CustomerId" 
                                       class="w-10 h-10 flex-center rounded-xl bg-surface-soft text-text-muted hover:bg-emerald-500 hover:text-white transition-all shadow-sm hover:shadow-lg">
                                        <i class="fas fa-eye text-[10px]"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.CustomerId" asp-route-name="@item.CustomerName" 
                                       class="w-10 h-10 flex-center rounded-xl bg-surface-soft text-text-muted hover:bg-secondary hover:text-white transition-all shadow-sm hover:shadow-lg">
                                        <i class="fas fa-user-edit text-[10px]"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.CustomerId" 
                                       class="w-10 h-10 flex-center rounded-xl bg-surface-soft text-text-muted hover:bg-rose-500 hover:text-white transition-all shadow-sm hover:shadow-lg">
                                        <i class="fas fa-user-slash text-[10px]"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Matrix Pagination -->
        <div class="px-12 py-10 bg-surface-soft/50 border-t border-border/30 flex justify-center">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }), new PagedListRenderOptions()
            {
                MaximumPageNumbersToDisplay = 5,
                LiElementClasses = new List<string> { "" },
                PageClasses = new List<string> { "w-14 h-14 flex items-center justify-center rounded-2xl border border-border/50 text-[10px] font-black uppercase tracking-widest transition-all hover:bg-primary hover:text-white hover:border-primary bg-white mx-1.5 shadow-sm hover:shadow-xl hover:-translate-y-1" },
                UlElementClasses = new List<string> { "flex items-center" },
                ActiveLiElementClass = "[&_a]:bg-primary [&_a]:text-white [&_a]:border-primary [&_a]:shadow-xl [&_a]:shadow-primary/20",
            })
        </div>
    </div>
</div>


