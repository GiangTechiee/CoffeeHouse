@model CoffeeHouse.Domain.Entities.Customer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Entity Re-calibration";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-4xl mx-auto space-y-12 animate-fade-in">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.3em] text-text-light">
        <a asp-action="Index" class="hover:text-primary transition-colors">Population tracking</a>
        <i class="fas fa-chevron-right text-[8px]"></i>
        <span class="text-secondary italic">Entity Re-calibration</span>
    </nav>

    <!-- Header -->
    <div class="pb-10 border-b-2 border-secondary/10 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-12 opacity-[0.02] text-7xl font-black pointer-events-none select-none italic text-secondary">
            RE_CAL
        </div>
        <div class="relative z-10 space-y-4">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Calibration Protocol</span>
            <h1 class="text-5xl lg:text-7xl font-black text-secondary tracking-tighter italic leading-none">Hiệu chỉnh <span class="text-primary not-italic">Bio Entity</span></h1>
            <div class="flex items-center gap-4">
                <span class="text-[10px] font-black text-text-muted font-mono bg-surface-soft px-4 py-1 rounded-lg border border-border/50 shadow-inner">USR_ID: #@Model.CustomerId</span>
                <p class="text-[10px] font-black uppercase tracking-widest text-text-light italic">Overriding biological signatures for @Model.CustomerName.</p>
            </div>
        </div>
    </div>

    <!-- Form Container -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 lg:p-16 rounded-[64px] border border-border/50 shadow-2xl relative">
        <form asp-action="Edit" method="post" class="space-y-10">
            <div asp-validation-summary="ModelOnly" class="rounded-3xl bg-rose-50 border border-rose-100 p-6 text-rose-500 text-[10px] font-black uppercase tracking-widest italic shadow-inner"></div>
            <input type="hidden" asp-for="CustomerId" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                <!-- Name Field -->
                <div class="space-y-4">
                    <label asp-for="CustomerName" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Định danh Entity Name</label>
                    <div class="relative group/input">
                        <input asp-for="CustomerName" class="input-modern h-20 !rounded-[28px] pl-8 text-base font-bold shadow-inner" placeholder="E.g. Commander Shepard..." required />
                        <i class="fas fa-user-circle absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                    </div>
                    <span asp-validation-for="CustomerName" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                </div>

                <!-- Phone Field -->
                <div class="space-y-4">
                    <label asp-for="PhoneNumber" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Comm Link (Phone)</label>
                    <div class="relative group/input">
                        <input asp-for="PhoneNumber" class="input-modern h-20 !rounded-[28px] pl-8 text-base font-bold shadow-inner" placeholder="E.g. 090..." required />
                        <i class="fas fa-satellite-dish absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                </div>

                <!-- Address Field -->
                <div class="md:col-span-2 space-y-4">
                    <label asp-for="Address" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Sector Residence (Address)</label>
                    <div class="relative group/input">
                        <input asp-for="Address" class="input-modern h-20 !rounded-[28px] pl-8 text-base font-bold shadow-inner" placeholder="E.g. Citadel, Ward 1..." required />
                        <i class="fas fa-map-marker-alt absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                    </div>
                    <span asp-validation-for="Address" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                </div>
            </div>

            <!-- Execution Strategy -->
            <div class="pt-10 flex flex-col sm:flex-row items-center justify-between border-t border-border/50 gap-8">
                <a asp-action="Index" class="flex items-center gap-4 text-[10px] font-black uppercase tracking-widest text-text-muted hover:text-secondary transition-all group">
                    <i class="fas fa-chevron-left transition-transform group-hover:-translate-x-2"></i>
                    Abort Re-calibration
                </a>
                
                <button type="submit" class="w-full sm:w-auto btn-primary h-20 !px-16 !rounded-[32px] flex items-center justify-center gap-6 group shadow-2xl shadow-primary/30">
                    <span class="text-[10px] font-black uppercase tracking-[0.3em]">Commit Calibration</span>
                    <i class="fas fa-sync-alt transition-transform group-hover:rotate-180"></i>
                </button>
            </div>
        </form>
    </div>
</div>


