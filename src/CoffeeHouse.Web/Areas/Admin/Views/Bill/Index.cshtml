@using CoffeeHouse.Domain.Entities
@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<SalesOrder>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Command Manifests";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-10 animate-fade-in">
    <!-- Page Header: Manifest Control -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 rounded-[48px] border border-border/50 shadow-2xl flex flex-col xl:flex-row xl:items-center justify-between gap-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-16 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary">
            MANIFESTS
        </div>

        <div class="relative z-10 space-y-2">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Fiscal Monitoring</span>
            <h1 class="text-5xl font-black text-secondary tracking-tighter italic">Lưu trữ <span class="text-primary not-italic">Hoá đơn</span></h1>
            <p class="text-[10px] font-black uppercase tracking-widest text-text-light">Comprehensive fiscal logs for galactic commerce activity.</p>
        </div>

        <div class="relative z-10">
            <div class="relative group/search w-full md:w-[320px]">
                @using (Html.BeginForm("Search", "Bill", FormMethod.Get, new { @class = "flex-1" }))
                {
                    <input type="date" name="search" 
                           class="w-full pl-14 pr-6 py-5 bg-surface-soft border border-border/50 rounded-3xl text-[10px] font-black uppercase tracking-widest outline-none focus:ring-4 focus:ring-primary/10 focus:border-primary focus:bg-white transition-all shadow-inner">
                    <i class="fa fa-calendar-alt absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/search:text-primary transition-colors text-xs"></i>
                    <button type="submit" class="absolute right-6 top-1/2 -translate-y-1/2 text-primary hover:scale-110 transition-transform">
                        <i class="fas fa-search"></i>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Manifest Matrix: Live Feed -->
    <div class="bg-white/70 backdrop-blur-2xl rounded-[56px] border border-border/50 shadow-2xl overflow-hidden group">
        <div class="overflow-x-auto custom-scrollbar">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-secondary text-white">
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Manifest ID</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Timestamp</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Entity Details</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Terminal</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Method</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Status</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Budget</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em] text-center">Operations</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border/30">
                    @foreach (var (item, index) in Model.Select((v, i) => (v, i)))
                    {
                        <tr class="group/row hover:bg-surface-soft/50 transition-colors duration-500 @(index % 2 != 0 ? "bg-surface-soft/20" : "")">
                            <td class="px-8 py-8">
                                <span class="text-[10px] font-black text-text-light font-mono bg-surface-soft px-3 py-1 rounded-lg border border-border/50">#@item.OrderId</span>
                            </td>
                            <td class="px-8 py-8">
                                <p class="text-[10px] font-black text-secondary tracking-widest">@item.OrderDate.ToString("dd/MM/yyyy")</p>
                            </td>
                            <td class="px-8 py-8">
                                <div class="space-y-1">
                                    <p class="text-[11px] font-black text-secondary tracking-tight group-hover/row:text-primary transition-colors italic">@(item.Customer?.CustomerName ?? "System Guest")</p>
                                    <p class="text-[8px] font-black uppercase tracking-widest text-text-light flex items-center gap-2">
                                        <i class="fas fa-user-tie text-[6px]"></i> Ops: @(item.Employee?.FullName ?? "Auto-Pilot")
                                    </p>
                                </div>
                            </td>
                            <td class="px-8 py-8">
                                <span class="text-[9px] font-black uppercase text-secondary group-hover/row:text-primary">@(item.Store?.StoreName ?? "HQ Central")</span>
                            </td>
                            <td class="px-8 py-8">
                                <span class="flex items-center gap-2 text-[9px] font-black uppercase tracking-widest text-text-muted">
                                    <i class="fas fa-credit-card text-[10px]"></i> @item.PaymentMethod
                                </span>
                            </td>
                            <td class="px-8 py-8">
                                @{
                                    var statusClass = item.Status == "Hoàn thành" ? "bg-emerald-500 shadow-emerald-500/20" : "bg-amber-500 shadow-amber-500/20";
                                }
                                <div class="flex items-center gap-3">
                                    <div class="w-1.5 h-1.5 rounded-full @statusClass animate-pulse"></div>
                                    <span class="text-[9px] font-black uppercase tracking-[0.2em] text-secondary">@item.Status</span>
                                </div>
                            </td>
                            <td class="px-8 py-8">
                                <p class="text-sm font-black text-primary italic tracking-tighter">@item.TotalAmount.ToString("n0") <span class="text-[8px] not-italic ml-0.5">đ</span></p>
                            </td>
                            <td class="px-8 py-8">
                                <div class="flex items-center justify-center gap-3">
                                    <a asp-action="Details" asp-route-id="@item.OrderId" 
                                       class="w-10 h-10 flex-center rounded-xl bg-surface-soft text-text-muted hover:bg-secondary hover:text-white transition-all shadow-sm hover:shadow-lg">
                                        <i class="fas fa-file-alt text-[10px]"></i>
                                    </a>
                                    @if (item.Status != "Hoàn thành")
                                    {
                                        <a asp-action="Confirm" asp-route-id="@item.OrderId" 
                                           class="h-10 px-4 flex items-center gap-2 rounded-xl bg-emerald-50 text-emerald-600 hover:bg-emerald-500 hover:text-white transition-all shadow-sm hover:shadow-lg text-[8px] font-black uppercase tracking-widest">
                                            <i class="fas fa-check-double text-[8px]"></i>
                                            Confirm
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Matrix Pagination -->
        <div class="px-12 py-10 bg-surface-soft/50 border-t border-border/30 flex justify-center">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page }), new PagedListRenderOptions()
            {
                MaximumPageNumbersToDisplay = 5,
                LiElementClasses = new List<string> { "" },
                PageClasses = new List<string> { "w-14 h-14 flex items-center justify-center rounded-2xl border border-border/50 text-[10px] font-black uppercase tracking-widest transition-all hover:bg-primary hover:text-white hover:border-primary bg-white mx-1.5 shadow-sm hover:shadow-xl hover:-translate-y-1" },
                UlElementClasses = new List<string> { "flex items-center" },
                ActiveLiElementClass = "[&_a]:bg-primary [&_a]:text-white [&_a]:border-primary [&_a]:shadow-xl [&_a]:shadow-primary/20",
            })
        </div>
    </div>
</div>



