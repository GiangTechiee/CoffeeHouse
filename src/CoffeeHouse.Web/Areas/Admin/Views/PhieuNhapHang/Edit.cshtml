@model CoffeeHouse.Domain.Entities.PurchaseOrder
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Manifest Recalibration";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-5xl mx-auto space-y-12 animate-fade-in">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.3em] text-text-light">
        <a asp-action="Index" class="hover:text-primary transition-colors">Supply Chain Matrix</a>
        <i class="fas fa-chevron-right text-[8px]"></i>
        <span class="text-secondary italic">Manifest Recalibration</span>
    </nav>

    <!-- Header -->
    <div class="pb-10 border-b-2 border-secondary/10 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-12 opacity-[0.02] text-7xl font-black pointer-events-none select-none italic text-secondary">
            EDIT_CONS
        </div>
        <div class="relative z-10 space-y-4">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Logistics Override Protocol</span>
            <h1 class="text-5xl lg:text-7xl font-black text-secondary tracking-tighter italic leading-none">Recalibrate <span class="text-primary not-italic">Manifest</span></h1>
            <div class="flex items-center gap-4">
                <span class="text-[10px] font-black text-text-muted font-mono bg-surface-soft px-4 py-1 rounded-lg border border-border/50 shadow-inner">MANIFEST_ID: #PN-@Model.PurchaseOrderId.ToString("D3")</span>
                <p class="text-[10px] font-black uppercase tracking-widest text-text-light italic">Overriding arrival parameters and resource intake signatures.</p>
            </div>
        </div>
    </div>

    <!-- Form Container: Command Console -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 lg:p-16 rounded-[64px] border border-border/50 shadow-2xl relative">
        <form asp-action="Edit" method="post" class="space-y-16">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PurchaseOrderId" />

            <div asp-validation-summary="ModelOnly" class="rounded-3xl bg-rose-50 border border-rose-100 p-6 text-rose-500 text-[10px] font-black uppercase tracking-widest italic shadow-inner"></div>

            <!-- Segment: Logistics Anchors -->
            <div class="space-y-10">
                <div class="flex items-center gap-6">
                    <span class="w-10 h-10 rounded-2xl bg-secondary text-white flex-center text-[10px] font-black italic shadow-lg shadow-secondary/20">LOG</span>
                    <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary">Logistical Anchor Overrides</h3>
                    <div class="h-px bg-border/50 flex-1"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Hub -->
                    <div class="space-y-4">
                        <label asp-for="StoreId" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Destination Hub</label>
                        <div class="relative group/select">
                            <select asp-for="StoreId" class="input-modern h-20 !rounded-[28px] pl-8 pr-12 text-base font-bold appearance-none shadow-inner" asp-items="ViewBag.StoreId"></select>
                            <i class="fas fa-shuttle-van absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/select:text-primary pointer-events-none transition-all"></i>
                        </div>
                        <span asp-validation-for="StoreId" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <!-- Operative -->
                    <div class="space-y-4">
                        <label asp-for="EmployeeId" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Receiving Operative</label>
                        <div class="relative group/select">
                            <select asp-for="EmployeeId" class="input-modern h-20 !rounded-[28px] pl-8 pr-12 text-base font-bold appearance-none shadow-inner" asp-items="ViewBag.EmployeeId"></select>
                            <i class="fas fa-user-astronaut absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/select:text-primary pointer-events-none transition-all"></i>
                        </div>
                        <span asp-validation-for="EmployeeId" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <!-- Supplier -->
                    <div class="space-y-4">
                        <label asp-for="SupplierId" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Merchant Guild</label>
                        <div class="relative group/select">
                            <select asp-for="SupplierId" class="input-modern h-20 !rounded-[28px] pl-8 pr-12 text-base font-bold appearance-none shadow-inner" asp-items="ViewBag.SupplierId"></select>
                            <i class="fas fa-handshake absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/select:text-primary pointer-events-none transition-all"></i>
                        </div>
                        <span asp-validation-for="SupplierId" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>
                </div>
            </div>

            <!-- Segment: Chronology & Intel -->
            <div class="space-y-10">
                <div class="flex items-center gap-6">
                    <span class="w-10 h-10 rounded-2xl bg-secondary text-white flex-center text-[10px] font-black italic shadow-lg shadow-secondary/20">SEC</span>
                    <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary">Temporal & Intel Calibration</h3>
                    <div class="h-px bg-border/50 flex-1"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- Date -->
                    <div class="space-y-4">
                        <label asp-for="OrderDate" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Arrival Timestamp</label>
                        <div class="relative group/input">
                            <input asp-for="OrderDate" class="input-modern h-20 !rounded-[28px] pl-8 text-base font-bold shadow-inner" type="datetime-local" />
                            <i class="fas fa-calendar-alt absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                        </div>
                        <span asp-validation-for="OrderDate" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>

                    <!-- Ghi chu -->
                    <div class="space-y-4">
                        <label asp-for="Description" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Manifest Mission Logs</label>
                        <div class="relative group/input">
                            <input asp-for="Description" class="input-modern h-20 !rounded-[28px] pl-8 text-base font-bold shadow-inner" placeholder="E.g. Cargo integrity verified..." />
                            <i class="fas fa-clipboard-list absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                        </div>
                        <span asp-validation-for="Description" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                    </div>
                </div>
            </div>

            <!-- Execution Strategy -->
            <div class="pt-10 flex flex-col sm:flex-row items-center justify-between border-t border-border/50 gap-8">
                <a asp-action="Index" class="flex items-center gap-4 text-[10px] font-black uppercase tracking-widest text-text-muted hover:text-secondary transition-all group">
                    <i class="fas fa-chevron-left transition-transform group-hover:-translate-x-2"></i>
                    Abort Recalibration
                </a>
                
                <button type="submit" class="w-full sm:w-auto btn-primary h-20 !px-16 !rounded-[32px] flex items-center justify-center gap-6 group shadow-2xl shadow-primary/30">
                    <span class="text-[10px] font-black uppercase tracking-[0.3em]">Commit Parameters</span>
                    <i class="fas fa-save transition-transform group-hover:scale-110"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}



