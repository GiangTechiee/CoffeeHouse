@using CoffeeHouse.Domain.Entities
@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<ProductCategory>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Cargo Sectors";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-10 animate-fade-in">
    <!-- Page Header: Strategic Mapping -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 rounded-[48px] border border-border/50 shadow-2xl flex flex-col xl:flex-row xl:items-center justify-between gap-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-16 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary">
            SECTORS
        </div>

        <div class="relative z-10 space-y-2">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Logistical Mapping</span>
            <h1 class="text-5xl font-black text-secondary tracking-tighter italic">Quản lý <span class="text-primary not-italic">Nhóm sản phẩm</span></h1>
            <p class="text-[10px] font-black uppercase tracking-widest text-text-light">Categorizing inventory into functional cargo sectors.</p>
        </div>

        <div class="relative z-10 flex flex-col md:flex-row items-center gap-6">
            <div class="relative group/search w-full md:w-[320px]">
                @using (Html.BeginForm("Search", "GroupsProduct", FormMethod.Get, new { @class = "flex-1" }))
                {
                    <input type="text" name="search" placeholder="Quét sector ID..." 
                           class="w-full pl-14 pr-6 py-5 bg-surface-soft border border-border/50 rounded-3xl text-[10px] font-black uppercase tracking-widest outline-none focus:ring-4 focus:ring-primary/10 focus:border-primary focus:bg-white transition-all shadow-inner">
                    <i class="fa fa-search absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/search:text-primary transition-colors text-xs"></i>
                }
            </div>
            
            <a asp-action="Create" class="w-full md:w-auto btn-primary h-[60px] !rounded-3xl px-10 flex items-center justify-center gap-4 group/btn shadow-xl shadow-primary/20">
                <span class="text-[10px] font-black uppercase tracking-widest">Khai thác sector mới</span>
                <i class="fas fa-plus-circle group-hover:rotate-90 transition-transform"></i>
            </a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="bg-secondary text-white px-8 py-5 rounded-3xl border border-white/10 flex items-center gap-4 animate-scale-in shadow-xl shadow-secondary/20">
            <div class="w-10 h-10 rounded-xl bg-white/10 text-white flex-center backdrop-blur-md">
                <i class="fas fa-satellite"></i>
            </div>
            <span class="text-[10px] font-black uppercase tracking-[0.2em]">@TempData["Message"]</span>
        </div>
    }

    <!-- Sectors Table: System Matrix -->
    <div class="bg-white/70 backdrop-blur-2xl rounded-[56px] border border-border/50 shadow-2xl overflow-hidden group">
        <div class="overflow-x-auto overflow-y-hidden custom-scrollbar">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-secondary text-white">
                        <th class="px-12 py-8 text-[10px] font-black uppercase tracking-[0.3em] w-1/4">Sector ID</th>
                        <th class="px-12 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Classification Name</th>
                        <th class="px-12 py-8 text-[10px] font-black uppercase tracking-[0.3em] text-center">Protocol Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border/30">
                    @foreach (var (item, index) in Model.Select((v, i) => (v, i)))
                    {
                        <tr class="group/row hover:bg-surface-soft/50 transition-colors duration-500 @(index % 2 != 0 ? "bg-surface-soft/20" : "")">
                            <td class="px-12 py-8">
                                <span class="text-[10px] font-black text-text-light font-mono bg-surface-soft px-4 py-1.5 rounded-xl border border-border/50 shadow-inner group-hover/row:bg-white group-hover/row:border-primary/30 transition-all">
                                    ID_SEC_@Math.Abs(item.CategoryId).ToString("D3")
                                </span>
                            </td>
                            <td class="px-12 py-8">
                                <div class="flex items-center gap-6">
                                    <div class="w-2 h-2 rounded-full bg-primary animate-pulse"></div>
                                    <p class="text-lg font-black text-secondary tracking-tight italic group-hover/row:text-primary transition-colors">@item.CategoryName</p>
                                </div>
                            </td>
                            <td class="px-12 py-8">
                                <div class="flex items-center justify-center gap-4">
                                    <a asp-action="Edit" asp-route-id="@item.CategoryId" asp-route-name="@item.CategoryName" 
                                       class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-emerald-500 hover:text-white transition-all shadow-sm hover:shadow-lg hover:-translate-y-1">
                                        <i class="fas fa-edit text-xs"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.CategoryId" 
                                       class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-rose-500 hover:text-white transition-all shadow-sm hover:shadow-lg hover:-translate-y-1">
                                        <i class="fas fa-trash-alt text-xs"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Matrix Pagination -->
        <div class="px-12 py-10 bg-surface-soft/50 border-t border-border/30 flex justify-center">
            @Html.PagedListPager(Model, page => Url.Action("index", new { page = page }), new PagedListRenderOptions()
            {
                MaximumPageNumbersToDisplay = 5,
                LiElementClasses = new List<String> { "" },
                PageClasses = new List<String> { "w-14 h-14 flex items-center justify-center rounded-2xl border border-border/50 text-[10px] font-black uppercase tracking-widest transition-all hover:bg-primary hover:text-white hover:border-primary bg-white mx-1.5 shadow-sm hover:shadow-xl hover:-translate-y-1" },
                UlElementClasses = new List<String> { "flex items-center" },
                ActiveLiElementClass = "[&_a]:bg-primary [&_a]:text-white [&_a]:border-primary [&_a]:shadow-xl [&_a]:shadow-primary/20",
            })
        </div>
    </div>
</div>



