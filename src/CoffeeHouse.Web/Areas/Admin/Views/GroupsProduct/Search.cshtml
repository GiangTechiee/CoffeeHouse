@using CoffeeHouse.Domain.Entities
@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<ProductCategory>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Sector Search Analysis";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-12 animate-fade-in">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.3em] text-text-light">
        <a asp-action="Index" class="hover:text-primary transition-colors">Logistical Mapping</a>
        <i class="fas fa-chevron-right text-[8px]"></i>
        <span class="text-secondary italic">Sector Scan Results</span>
    </nav>

    <!-- Page Header: Scan Results -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 rounded-[48px] border border-border/50 shadow-2xl flex flex-col xl:flex-row xl:items-center justify-between gap-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-16 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary group-hover:opacity-[0.05] transition-opacity">
            RESULTS
        </div>

        <div class="relative z-10 space-y-4">
            <div class="flex items-center gap-4">
                <span class="w-10 h-px bg-primary"></span>
                <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px]">Frequency Scan Complete</span>
            </div>
            <h1 class="text-5xl font-black text-secondary tracking-tighter italic">Scan Results: <span class="text-primary not-italic">"@ViewBag.search"</span></h1>
            <p class="text-[10px] font-black uppercase tracking-widest text-text-light italic">Identified logistical categories matching the specified search parameters.</p>
        </div>

        <div class="relative z-10 flex flex-col md:flex-row items-center gap-6">
            <div class="relative group/search w-full md:w-[320px]">
                @using (Html.BeginForm("Search", "GroupsProduct", FormMethod.Get, new { @class = "flex-1" }))
                {
                    <input type="text" name="search" placeholder="Rescan Sector..." value="@ViewBag.search"
                           class="w-full pl-14 pr-14 py-5 bg-surface-soft border border-border/50 rounded-3xl text-[10px] font-black uppercase tracking-widest outline-none focus:ring-4 focus:ring-primary/10 focus:border-primary focus:bg-white transition-all shadow-inner">
                    <i class="fa fa-radar absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/search:text-primary transition-colors text-xs"></i>
                    <button type="submit" class="absolute right-6 top-1/2 -translate-y-1/2 text-primary hover:scale-110 transition-transform">
                        <i class="fas fa-search"></i>
                    </button>
                }
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Sector Matrix: Identified Categories -->
        <div class="bg-white/70 backdrop-blur-2xl rounded-[56px] border border-border/50 shadow-2xl overflow-hidden group">
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-secondary text-white">
                            <th class="px-12 py-8 text-[10px] font-black uppercase tracking-[0.3em] w-1/4">Sector ID</th>
                            <th class="px-12 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Classification Name</th>
                            <th class="px-12 py-8 text-[10px] font-black uppercase tracking-[0.3em] text-center">Operations</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border/30">
                        @foreach (var (item, index) in Model.Select((v, i) => (v, i)))
                        {
                            <tr class="group/row hover:bg-surface-soft/50 transition-colors duration-500 @(index % 2 != 0 ? "bg-surface-soft/20" : "")">
                                <td class="px-12 py-8">
                                    <span class="text-[10px] font-black text-text-light font-mono bg-surface-soft px-4 py-1.5 rounded-xl border border-border/50 shadow-inner group-hover/row:bg-white group-hover/row:border-primary/30 transition-all">
                                        ID_SEC_@Math.Abs(item.CategoryId).ToString("D3")
                                    </span>
                                </td>
                                <td class="px-12 py-8">
                                    <div class="flex items-center gap-6">
                                        <div class="w-2 h-2 rounded-full bg-primary animate-pulse"></div>
                                        <p class="text-lg font-black text-secondary tracking-tight italic group-hover/row:text-primary transition-colors">@item.CategoryName</p>
                                    </div>
                                </td>
                                <td class="px-12 py-8">
                                    <div class="flex items-center justify-center gap-4">
                                        <a asp-action="Edit" asp-route-id="@item.CategoryId" asp-route-name="@item.CategoryName" 
                                           class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-secondary hover:text-white transition-all shadow-sm hover:shadow-lg ">
                                            <i class="fas fa-edit text-xs"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.CategoryId" 
                                           class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-rose-500 hover:text-white transition-all shadow-sm hover:shadow-lg">
                                            <i class="fas fa-trash-alt text-xs"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Matrix Pagination -->
            <div class="px-12 py-10 bg-surface-soft/50 border-t border-border/30 flex justify-center">
                @Html.PagedListPager(Model, page => Url.Action("Search", new { page = page, search = ViewBag.search }), new PagedListRenderOptions()
                {
                    MaximumPageNumbersToDisplay = 5,
                    LiElementClasses = new List<string> { "" },
                    PageClasses = new List<string> { "w-14 h-14 flex items-center justify-center rounded-2xl border border-border/50 text-[10px] font-black uppercase tracking-widest transition-all hover:bg-primary hover:text-white hover:border-primary bg-white mx-1.5 shadow-sm hover:shadow-xl hover:-translate-y-1" },
                    UlElementClasses = new List<string> { "flex items-center" },
                    ActiveLiElementClass = "[&_a]:bg-primary [&_a]:text-white [&_a]:border-primary [&_a]:shadow-xl [&_a]:shadow-primary/20",
                })
            </div>
        </div>
    }
    else
    {
        <!-- Empty Results -->
        <div class="bg-white/70 backdrop-blur-2xl p-24 rounded-[64px] border border-border/50 shadow-2xl text-center space-y-8 animate-fade-in">
            <div class="w-32 h-32 rounded-full bg-surface-soft mx-auto flex-center text-5xl text-text-muted opacity-20 relative">
                <i class="fas fa-layer-group"></i>
                <div class="absolute inset-0 border-4 border-dashed border-text-muted rounded-full animate-[spin_10s_linear_infinite]"></div>
            </div>
            <div class="space-y-4">
                <p class="text-[10px] font-black uppercase tracking-[0.4em] text-primary">No Sectors Identified</p>
                <h3 class="text-4xl font-black text-secondary italic tracking-tighter">Null Classification</h3>
                <p class="text-[10px] font-black uppercase tracking-widest text-text-light max-w-sm mx-auto leading-relaxed italic">No logistical categories were found matching the provided frequency scan. Recalibration of search radius recommended.</p>
            </div>
            <a asp-action="Index" class="inline-flex items-center gap-4 text-[10px] font-black uppercase tracking-widest text-primary hover:text-secondary transition-all">
                <i class="fas fa-chevron-left text-[8px]"></i>
                Return to Directory
            </a>
        </div>
    }
</div>



