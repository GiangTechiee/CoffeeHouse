@using CoffeeHouse.Domain.Entities
@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<Ingredient>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Cargo Inventory";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-10 animate-fade-in">
    <!-- Page Header: Strategic Supply Depot -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 rounded-[48px] border border-border/50 shadow-2xl flex flex-col xl:flex-row xl:items-center justify-between gap-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-16 opacity-[0.02] text-8xl font-black pointer-events-none select-none italic text-secondary">
            CARGO
        </div>

        <div class="relative z-10 space-y-2">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Logistics Management</span>
            <h1 class="text-5xl font-black text-secondary tracking-tighter italic">Lưu trữ <span class="text-primary not-italic">Nguyên liệu</span></h1>
            <p class="text-[10px] font-black uppercase tracking-widest text-text-light">Operational cargo and station sustenance inventory logs.</p>
        </div>

        <div class="relative z-10 flex flex-col md:flex-row items-center gap-6">
            <div class="relative group/search w-full md:w-[320px]">
                @using (Html.BeginForm("Search", "NguyenLieus", FormMethod.Get, new { @class = "flex-1" }))
                {
                    <input type="text" name="search" placeholder="Scanning assets..." 
                           class="w-full pl-14 pr-14 py-5 bg-surface-soft border border-border/50 rounded-3xl text-[10px] font-black uppercase tracking-widest outline-none focus:ring-4 focus:ring-primary/10 focus:border-primary focus:bg-white transition-all shadow-inner">
                    <i class="fas fa-boxes absolute left-6 top-1/2 -translate-y-1/2 text-text-light group-focus-within/search:text-primary transition-colors text-xs"></i>
                    <button type="submit" class="absolute right-6 top-1/2 -translate-y-1/2 text-primary hover:scale-110 transition-transform">
                        <i class="fas fa-search"></i>
                    </button>
                }
            </div>
            
            <a asp-action="Create" class="w-full md:w-auto btn-primary h-[60px] !rounded-3xl px-10 flex items-center justify-center gap-4 group shadow-xl shadow-primary/20">
                <span class="text-[10px] font-black uppercase tracking-widest">Register Asset</span>
                <i class="fas fa-plus-circle transition-transform group-hover:rotate-90"></i>
            </a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="bg-emerald-500 text-white px-8 py-5 rounded-3xl border border-white/10 flex items-center gap-4 animate-scale-in shadow-xl shadow-emerald-500/20">
            <i class="fas fa-check-circle"></i>
            <span class="text-[10px] font-black uppercase tracking-[0.2em]">@TempData["Message"]</span>
        </div>
    }

    <!-- Inventory Matrix -->
    <div class="bg-white/70 backdrop-blur-2xl rounded-[56px] border border-border/50 shadow-2xl overflow-hidden group">
        <div class="overflow-x-auto custom-scrollbar">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-secondary text-white border-b border-white/10">
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em] w-16 text-center">UID</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Asset Designation</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Current Load</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Unit</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Expiration</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Economic Value</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em]">Min Floor</th>
                        <th class="px-8 py-8 text-[10px] font-black uppercase tracking-[0.3em] text-center">Operations</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border/30">
                    @foreach (var (nl, index) in Model.Select((v, i) => (v, i)))
                    {
                        <tr class="group/row hover:bg-surface-soft/50 transition-colors duration-500 @(index % 2 != 0 ? "bg-surface-soft/20" : "")">
                            <td class="px-8 py-8 text-center text-[9px] font-black text-text-light font-mono">#NL-@nl.IngredientId.ToString("D3")</td>
                            <td class="px-8 py-8">
                                <p class="text-base font-black text-secondary tracking-tight italic group-hover/row:text-primary transition-colors">@nl.IngredientName</p>
                            </td>
                            <td class="px-8 py-8">
                                <div class="flex items-center gap-4">
                                    <span class="text-lg font-black italic @(nl.Quantity <= nl.MinimumQuantity ? "text-rose-500" : "text-secondary")">@nl.Quantity</span>
                                    @if(nl.Quantity <= nl.MinimumQuantity) {
                                        <i class="fas fa-exclamation-triangle text-rose-500 text-[10px] animate-pulse"></i>
                                    }
                                </div>
                            </td>
                            <td class="px-8 py-8 text-[10px] font-black uppercase tracking-widest text-text-muted">@nl.Unit</td>
                            <td class="px-8 py-8">
                                <span class="text-[10px] font-black text-secondary">@(nl.ExpirationDate.HasValue ? nl.ExpirationDate.Value.ToString("dd/MM/yyyy") : "N/A")</span>
                            </td>
                            <td class="px-8 py-8">
                                <p class="text-[11px] font-black text-primary italic tracking-tighter">@nl.UnitPrice.ToString("n0") đ</p>
                            </td>
                            <td class="px-8 py-8 text-[10px] font-black text-text-muted font-mono">@nl.MinimumQuantity.ToString("n0")</td>
                            <td class="px-8 py-8">
                                <div class="flex items-center justify-center gap-3">
                                    <button class="add-to-cart h-12 px-6 rounded-2xl bg-primary text-white text-[10px] font-black uppercase tracking-widest hover:bg-secondary transition-all shadow-lg shadow-primary/20 flex items-center gap-2 group/btn"
                                            data-id="@nl.IngredientId"
                                            data-ten="@nl.IngredientName"
                                            data-dongia="@nl.UnitPrice">
                                        <i class="fas fa-truck-loading"></i>
                                        <span>Restock</span>
                                    </button>
                                    <a class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-secondary hover:text-white transition-all shadow-sm border border-border/50 hover:border-secondary" 
                                       asp-action="Edit" asp-route-id="@nl.IngredientId">
                                        <i class="fas fa-sliders-h text-xs"></i>
                                    </a>
                                    <a class="w-12 h-12 flex-center rounded-2xl bg-surface-soft text-text-muted hover:bg-rose-500 hover:text-white transition-all shadow-sm border border-border/50 hover:border-rose-500" 
                                       asp-action="Delete" asp-route-id="@nl.IngredientId">
                                        <i class="fas fa-trash-alt text-xs"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Matrix Pagination -->
        <div class="px-12 py-10 bg-surface-soft/50 border-t border-border/30 flex justify-center">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }), new PagedListRenderOptions()
            {
                MaximumPageNumbersToDisplay = 5,
                LiElementClasses = new List<string> { "" },
                PageClasses = new List<string> { "w-14 h-14 flex items-center justify-center rounded-2xl border border-border/50 text-[10px] font-black uppercase tracking-widest transition-all hover:bg-primary hover:text-white hover:border-primary bg-white mx-1.5 shadow-sm hover:shadow-xl hover:-translate-y-1" },
                UlElementClasses = new List<string> { "flex items-center" },
                ActiveLiElementClass = "[&_a]:bg-primary [&_a]:text-white [&_a]:border-primary [&_a]:shadow-xl [&_a]:shadow-primary/20",
            })
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var cartNhap = JSON.parse(localStorage.getItem("cartNhap")) || [];

        $(".add-to-cart").on("click", function () {
            var id = $(this).data("id");
            var ten = $(this).data("ten");
            var donGia = parseFloat($(this).data("dongia"));

            var existingItem = cartNhap.find(item => item.IngredientId === id);
            if (existingItem) {
                existingItem.QuantityNhap = parseFloat(existingItem.QuantityNhap) + 1;
                showNotification("Restock incremented for " + ten);
            } else {
                cartNhap.push({
                    IngredientId: id,
                    IngredientName: ten,
                    QuantityNhap: 1,
                    UnitPriceNhap: donGia
                });
                showNotification(ten + " staged for restock.");
            }
            localStorage.setItem("cartNhap", JSON.stringify(cartNhap));
        });

        function showNotification(msg) {
            // Optional: Implement a custom modern toast/notification system
            alert(msg);
        }
    </script>
}


