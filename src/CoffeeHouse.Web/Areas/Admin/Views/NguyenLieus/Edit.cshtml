@model CoffeeHouse.Domain.Entities.Ingredient
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Recalibrate Cargo Asset";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-4xl mx-auto space-y-12 animate-fade-in">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.3em] text-text-light">
        <a asp-action="Index" class="hover:text-primary transition-colors">Cargo Inventory</a>
        <i class="fas fa-chevron-right text-[8px]"></i>
        <span class="text-secondary italic">Asset Recalibration</span>
    </nav>

    <!-- Header -->
    <div class="pb-10 border-b-2 border-secondary/10 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-12 opacity-[0.02] text-7xl font-black pointer-events-none select-none italic text-secondary">
            MOD_ASSET
        </div>
        <div class="relative z-10 space-y-4">
            <span class="text-primary font-black uppercase tracking-[0.4em] text-[10px] flex items-center gap-4 before:content-[''] before:w-12 before:h-px before:bg-primary">Calibration Protocol</span>
            <h1 class="text-5xl lg:text-7xl font-black text-secondary tracking-tighter italic leading-none">Hiệu chỉnh <span class="text-primary not-italic">Nguyên liệu</span></h1>
            <div class="flex items-center gap-4">
                <span class="text-[10px] font-black text-text-muted font-mono bg-surface-soft px-4 py-1 rounded-lg border border-border/50 shadow-inner">NL_ID: #NL-@Model.IngredientId.ToString("D3")</span>
                <p class="text-[10px] font-black uppercase tracking-widest text-text-light italic">Overriding resource parameters in the galactic supply database.</p>
            </div>
        </div>
    </div>

    <!-- Form Container: Command Console -->
    <div class="bg-white/70 backdrop-blur-2xl p-10 lg:p-16 rounded-[64px] border border-border/50 shadow-2xl relative">
        <form asp-action="Edit" method="post" class="space-y-10">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="rounded-3xl bg-rose-50 border border-rose-100 p-6 text-rose-500 text-[10px] font-black uppercase tracking-widest italic shadow-inner"></div>
            <input type="hidden" asp-for="IngredientId" />

            <div class="space-y-12">
                <!-- Segment: Identification -->
                <div class="space-y-8">
                    <div class="flex items-center gap-6">
                        <span class="w-10 h-10 rounded-2xl bg-secondary text-white flex-center text-[10px] font-black italic shadow-lg shadow-secondary/20">MOD</span>
                        <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary">Override Identification</h3>
                        <div class="h-px bg-border/50 flex-1"></div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="md:col-span-2 space-y-4">
                            <label asp-for="IngredientName" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Resource Designation</label>
                            <div class="relative group/input">
                                <input asp-for="IngredientName" class="input-modern h-20 !rounded-[28px] pl-8 text-base font-bold shadow-inner" placeholder="E.g. Roasted Lunar Beans..." required />
                                <i class="fas fa-edit absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                            </div>
                            <span asp-validation-for="IngredientName" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                        </div>

                        <div class="space-y-4">
                            <label asp-for="Unit" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Measurement Unit</label>
                            <div class="relative group/input">
                                <input asp-for="Unit" class="input-modern h-20 !rounded-[28px] pl-8 text-base font-bold shadow-inner" placeholder="E.g. KG, Liter, Bag..." required />
                                <i class="fas fa-ruler-combined absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                            </div>
                            <span asp-validation-for="Unit" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                        </div>

                        <div class="space-y-4">
                            <label asp-for="ExpirationDate" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Expiration Threshold</label>
                            <div class="relative group/input">
                                <input asp-for="ExpirationDate" type="date" class="input-modern h-20 !rounded-[28px] pl-8 text-base font-bold shadow-inner" />
                                <i class="fas fa-calendar-alt absolute right-8 top-1/2 -translate-y-1/2 text-text-light group-focus-within/input:text-primary transition-colors"></i>
                            </div>
                            <span asp-validation-for="ExpirationDate" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                        </div>
                    </div>
                </div>

                <!-- Segment: Quantities & Value -->
                <div class="space-y-8">
                    <div class="flex items-center gap-6">
                        <span class="w-10 h-10 rounded-2xl bg-secondary text-white flex-center text-[10px] font-black italic shadow-lg shadow-secondary/20">LOGI</span>
                        <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary">Logistical Parameters</h3>
                        <div class="h-px bg-border/50 flex-1"></div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <div class="space-y-4">
                            <label asp-for="Quantity" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Current Load</label>
                            <input asp-for="Quantity" class="input-modern h-20 !rounded-[28px] px-8 text-base font-bold shadow-inner" />
                            <span asp-validation-for="Quantity" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                        </div>

                        <div class="space-y-4">
                            <label asp-for="MinimumQuantity" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Safety Floor</label>
                            <input asp-for="MinimumQuantity" class="input-modern h-20 !rounded-[28px] px-8 text-base font-bold shadow-inner" />
                            <span asp-validation-for="MinimumQuantity" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                        </div>

                        <div class="space-y-4">
                            <label asp-for="UnitPrice" class="text-[10px] font-black uppercase tracking-[0.2em] text-text-light ml-4">Unit Valuation</label>
                            <input asp-for="UnitPrice" class="input-modern h-20 !rounded-[28px] px-8 text-base font-bold shadow-inner" />
                            <span asp-validation-for="UnitPrice" class="text-rose-500 text-[8px] font-black uppercase tracking-widest ml-4"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Execution Strategy -->
            <div class="pt-10 flex flex-col sm:flex-row items-center justify-between border-t border-border/50 gap-8">
                <a asp-action="Index" class="flex items-center gap-4 text-[10px] font-black uppercase tracking-widest text-text-muted hover:text-secondary transition-all group">
                    <i class="fas fa-chevron-left transition-transform group-hover:-translate-x-2"></i>
                    Abort Recalibration
                </a>
                
                <button type="submit" class="w-full sm:w-auto btn-primary h-20 !px-16 !rounded-[32px] flex items-center justify-center gap-6 group shadow-2xl shadow-primary/30">
                    <span class="text-[10px] font-black uppercase tracking-[0.3em]">Commit Asset Override</span>
                    <i class="fas fa-save transition-transform group-hover:scale-110"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


