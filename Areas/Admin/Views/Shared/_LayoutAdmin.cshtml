@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var role = Context.Session.GetString("Role");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] | Trang quản trị THE SPACE COFFEE</title>
    <link rel="shortcut icon" href="~/favicon.ico" />

    <!-- Font -->
    <link rel="stylesheet" type="text/css" href="~/css/style-font.css" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" type="text/css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" type="text/css" />

    <!-- Các thư viện CSS khác -->
    <link rel="stylesheet" href="~/lib/jquery-ui/jquery-ui.min.css" type="text/css" />
    <link rel="stylesheet" href="~/lib/magnific-popup/dist/magnific-popup.css" type="text/css" />
    <link rel="stylesheet" href="~/lib/owl-carousel-2/dist/assets/owl.carousel.min.css" type="text/css" />
    <link rel="stylesheet" href="~/lib/owl-carousel-2/dist/assets/owl.theme.default.min.css" type="text/css" />
    <link rel="stylesheet" href="~/lib/slick-nav/dist/slicknav.min.css" type="text/css" />

    <!-- CSS tùy chỉnh Admin -->
    <link rel="stylesheet" href="~/css/style-admin.css" type="text/css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style-admin-additional.css" type="text/css" asp-append-version="true" />

    <!-- Inline CSS for sidebar hover effect -->
    <style>
        /* Sidebar styling */
        .sidebar .nav .nav-item .nav-link {
            display: flex;
            align-items: center;
            padding: 10px 15px;
            color: #333 !important; /* Default text color with higher specificity */
            transition: all 0.3s ease; /* Smooth transition for hover effects */
        }

        .sidebar .nav .nav-item .nav-linktynavelements.
        .nav-item .nav-link i {
            margin-right: 10px;
            color: #555 !important; /* Default icon color */
            transition: color 0.3s ease;
        }

        .sidebar .nav .nav-item .nav-link .menu-title {
            font-size: 14px;
            color: #333 !important; /* Default menu title color */
            transition: color 0.3s ease;
        }

        /* Hover effect for nav-link */
        .sidebar .nav .nav-item .nav-link:hover {
            background-color: #f0f0f0 !important; /* Light gray background on hover */
            color: #007bff !important; /* Primary blue text color on hover */
        }

            /* Hover effect for icon and menu title */
            .sidebar .nav .nav-item .nav-link:hover i,
            .sidebar .nav .nav-item .nav-link:hover .menu-title {
                color: #007bff !important; /* Primary blue for icon and text on hover */
            }

        /* Active state styling */
        .sidebar .nav .nav-item .nav-link.active {
            background-color: #e6f0ff !important; /* Slightly different background for active item */
            color: #0056b3 !important; /* Darker blue for active item */
        }

            .sidebar .nav .nav-item .nav-link.active i,
            .sidebar .nav .nav-item .nav-link.active .menu-title {
                color: #0056b3 !important; /* Darker blue for active icon and text */
            }

            /* Ensure hover takes precedence over active */
            .sidebar .nav .nav-item .nav-link.active:hover {
                background-color: #f0f0f0 !important;
                color: #007bff !important;
            }

                .sidebar .nav .nav-item .nav-link.active:hover i,
                .sidebar .nav .nav-item .nav-link.active:hover .menu-title {
                    color: #007bff !important;
                }
    </style>
</head>
<body>
    <div class="container-scroller">
        <!-- Navbar -->
        <nav class="navbar default-layout-navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
            <div class="navbar-brand-wrapper d-flex align-items-center justify-content-center">
                <a asp-controller="homeadmin" asp-action="index" class="admin__logo">
                    <i class="fas fa-coffee"></i> | Admin
                </a>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-stretch">
                <ul class="navbar-nav navbar-nav-right">
                    <li class="nav-item nav-item-logout">
                        <a asp-controller="auth" asp-action="logout" class="nav-link">
                            <i class="fas fa-sign-out-alt"></i>
                            <span class="menu-title" style="padding-left:10px;">Đăng xuất</span>
                        </a>
                    </li>
                </ul>
                <!-- Nút toggle sidebar ở mobile -->
                <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" onclick="openNavbar()">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </nav>

        <!-- Wrapper cho nội dung -->
        <div class="container-fluid page-body-wrapper">
            <!-- Sidebar -->
            <nav class="sidebar sidebar-offcanvas" id="sidebar">
                <ul class="nav nav-bar-fixed">
                    <li class="nav-item">
                        <a asp-controller="HomeAdmin" asp-action="Index" class="nav-link">
                            <i class="fas fa-box-open"></i> <!-- Icon mới: Sản phẩm -->
                            <span class="menu-title">Sản phẩm</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="GroupsProduct" asp-action="Index" class="nav-link">
                            <i class="fas fa-layer-group"></i> <!-- Icon mới: Nhóm sản phẩm -->
                            <span class="menu-title">Nhóm sản phẩm</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="NguyenLieus" asp-action="Index" class="nav-link">
                            <i class="fas fa-seedling"></i> <!-- Icon mới: Nguyên liệu -->
                            <span class="menu-title">Nguyên liệu</span>
                        </a>
                    </li>
                    @if (role != "Employee")
                    {
                        <li class="nav-item">
                            <a asp-controller="ThuChi" asp-action="All" class="nav-link">
                                <i class="fas fa-chart-line"></i> <!-- Icon mới: Thu chi -->
                                <span class="menu-title">Thu chi</span>
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a asp-controller="Bill" asp-action="Index" class="nav-link">
                            <i class="fas fa-receipt"></i> <!-- Icon mới: Hóa đơn -->
                            <span class="menu-title">Hoá đơn</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="PhieuNhapHang" asp-action="Index" class="nav-link">
                            <i class="fas fa-truck-loading"></i> <!-- Icon mới: Phiếu nhập -->
                            <span class="menu-title">Phiếu nhập</span>
                        </a>
                    </li>
                    @if (role != "Employee")
                    {
                        <li class="nav-item">
                            <a asp-controller="NhaCungCap" asp-action="Index" class="nav-link">
                                <i class="fas fa-warehouse"></i> <!-- Icon mới: Nhà cung cấp -->
                                <span class="menu-title">Nhà cung cấp</span>
                            </a>
                        </li>
                    }
                    @if (role != "Employee")
                    {
                        <li class="nav-item">
                            <a asp-controller="Clients" asp-action="Index" class="nav-link">
                                <i class="fas fa-users"></i> <!-- Icon mới: Khách hàng -->
                                <span class="menu-title">Khách hàng</span>
                            </a>
                        </li>
                    }
                    @if (role != "Employee")
                    {
                        <li class="nav-item">
                            <a asp-controller="NhanViens" asp-action="Index" class="nav-link">
                                <i class="fas fa-user-tie"></i> <!-- Icon mới: Nhân viên -->
                                <span class="menu-title">Nhân viên</span>
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a asp-controller="NewsManage" asp-action="Index" class="nav-link">
                            <i class="fas fa-newspaper"></i> <!-- Icon mới: Tin tức -->
                            <span class="menu-title">Bài viết</span>
                        </a>
                    </li>
                    @if (role != "Employee")
                    {
                        <li class="nav-item">
                            <a asp-controller="QuanCafe" asp-action="Index" class="nav-link">
                                <i class="fas fa-store"></i> <!-- Icon mới: Thông tin cửa hàng -->
                                <span class="menu-title">Thông tin cửa hàng</span>
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index" class="nav-link">
                            <i class="fas fa-sign-out-alt"></i> <!-- Icon đăng xuất giữ nguyên -->
                            <span class="menu-title">Về trang chủ</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Main panel -->
            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
                <footer class="footer">
                    <div class="container-fluid">
                        <div class="row">
                            <span class="copyright_text">
                                Bản quyền © <script>document.write(new Date().getFullYear());</script>.
                                <a asp-controller="home" asp-action="index">COFFEE HOUSE</a>
                            </span>
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <!-- JS Libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/lib/fontawesome/js/all.min.js"></script>

    <!-- Các file JS tùy chỉnh -->
    <script src="~/js/off-canvas.js"></script>
    <script src="~/js/hoverable-collapse.js"></script>
    <script src="~/js/misc.js"></script>
    <script src="~/js/main-admin.js" asp-append-version="true"></script>
    <script src="~/js/main-admin-additional.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>